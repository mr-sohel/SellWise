@model IEnumerable<SellWise.Web.ViewModels.Alert.AlertViewModel>
@{
    ViewData["Title"] = "Inventory Alerts";
    bool showUnreadOnly = (bool)(ViewData["ShowUnreadOnly"] ?? false);
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Inventory Alerts</h2>
        <p class="text-muted mb-0">Smart recommendations based on predicted demand and sales velocity.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="ScanInventory" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary d-flex align-items-center gap-2">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
                Scan Inventory
            </button>
        </form>
        <form asp-action="MarkAllRead" method="post" class="d-inline">
            <button type="submit" class="btn btn-dark d-flex align-items-center gap-2" style="background-color: #18181b; border: none;">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Mark All Read
            </button>
        </form>
    </div>
</div>

<div class="mb-4">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="showUnreadOnly" @(showUnreadOnly ? "checked" : "") onchange="filterUnread(this);">
        <label class="form-check-label text-bold" for="showUnreadOnly" style="cursor:pointer;">
            Show unread only
        </label>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-column gap-3">
    @foreach (var alert in Model)
    {
        <div class="card p-4 border-1 @(alert.IsRead ? "opacity-75" : "")" style="border-left: 4px solid #f59e0b !important;">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start mb-2 gap-2">
                <div class="d-flex align-items-center gap-2">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <strong class="text-dark">@alert.Type</strong>
                    <span class="text-muted">•</span>
                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@alert.ProductId" class="fw-bold text-decoration-none" style="color: #2563eb;">
                        @alert.ProductName
                    </a>
                </div>
                <small class="text-muted">@alert.CreatedAt.ToLocalTime().ToString("g")</small>
            </div>
            
            <p class="text-muted mb-3" style="font-size: 0.95rem;">
                @alert.Message
            </p>
            
            <div class="d-flex gap-3">
                <form asp-action="Dismiss" asp-route-id="@alert.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link p-0 text-decoration-none text-uppercase fw-bold text-muted" style="font-size: 0.75rem;">
                        Dismiss
                    </button>
                </form>
                <a asp-controller="Product" asp-action="Edit" asp-route-id="@alert.ProductId" class="text-decoration-none text-uppercase fw-bold" style="color: #2563eb; font-size: 0.75rem;">
                    Restock Now
                </a>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="card p-5 text-center text-muted">
            No active inventory alerts! All items are well stocked.
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterUnread(checkbox) {
            window.location.href = '?showUnreadOnly=' + checkbox.checked;
        }
    </script>
}
