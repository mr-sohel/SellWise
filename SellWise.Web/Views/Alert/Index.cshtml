@model IEnumerable<SellWise.Web.ViewModels.Alert.AlertViewModel>
@{
    ViewData["Title"] = "Inventory Alerts";
    bool showUnreadOnly = (bool)(ViewData["ShowUnreadOnly"] ?? false);
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <h2 class="fw-bold text-dark mb-0">Inventory Alerts</h2>
    <div class="d-flex gap-2">
        <form asp-action="ScanInventory" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary d-flex align-items-center gap-2">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
                Scan Inventory
            </button>
        </form>
        <form asp-action="MarkAllRead" method="post" class="d-inline">
            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Mark All Read
            </button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-1 shadow-sm p-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="showUnreadOnly" @(showUnreadOnly ? "checked" : "") onchange="filterUnread(this);">
            <label class="form-check-label fw-semibold" for="showUnreadOnly" style="cursor:pointer; font-size: 0.875rem;">Unread only</label>
        </div>
        <div class="ms-auto text-muted" style="font-size: 0.8rem;">
            @Model.Count() alert@(Model.Count() != 1 ? "s" : "")
        </div>
    </div>
</div>

<div class="d-flex flex-column gap-2">
    @foreach (var alert in Model)
    {
        var isUnread = !alert.IsRead;
        <div class="card border-1 shadow-sm @(isUnread ? "" : "opacity-60")">
            <div class="card-body p-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="alert-type-icon flex-shrink-0">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <div class="flex-grow-1 min-width-0">
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <span class="alert-type-badge">@alert.Type</span>
                            @if (isUnread)
                            {
                                <span class="alert-unread-dot"></span>
                            }
                            <small class="text-muted ms-auto">@alert.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</small>
                        </div>
                        <p class="text-muted mb-2" style="font-size: 0.82rem; line-height: 1.5;">@alert.Message</p>
                        <div class="d-flex gap-2">
                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@alert.ProductId" class="btn btn-sm btn-outline-primary">
                                Restock
                            </a>
                            <form asp-action="Dismiss" asp-route-id="@alert.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Dismiss</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="card border-1 shadow-sm p-5 text-center">
            <div class="text-muted mb-2">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-2" style="color: var(--text-muted);"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <p class="fw-bold text-dark mb-1">All clear</p>
            <p class="text-muted mb-0" style="font-size: 0.85rem;">No active inventory alerts. All items are well stocked.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterUnread(checkbox) {
            window.location.href = '?showUnreadOnly=' + checkbox.checked;
        }
    </script>
}
