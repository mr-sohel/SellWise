@model SellWise.Web.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Top Header section matching 02_dashboard.png -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Overview</h2>
        <p class="text-muted small mb-0 d-flex align-items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Store performance for the last 30D
        </p>
    </div>
    <div class="btn-group-timeframe">
        <a href="?range=7d" class="btn-timeframe @(Context.Request.Query["range"] == "7d" ? "active" : "")" style="text-decoration: none;">7D</a>
        <a href="?range=30d" class="btn-timeframe @(Context.Request.Query["range"] == "30d" || string.IsNullOrEmpty(Context.Request.Query["range"]) ? "active" : "")" style="text-decoration: none;">30D</a>
        <a href="?range=90d" class="btn-timeframe @(Context.Request.Query["range"] == "90d" ? "active" : "")" style="text-decoration: none;">90D</a>
        <a href="?range=1y" class="btn-timeframe @(Context.Request.Query["range"] == "1y" ? "active" : "")" style="text-decoration: none;">1Y</a>
    </div>
</div>

<!-- KPI Cards & Main Revenue Trend Row -->
<div class="row g-4 mb-4">
    <!-- Left column: 2x2 Grid of KPIs -->
    <div class="col-12 col-xl-5">
        <div class="row g-3 h-100">
            <!-- Total Revenue Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Total Revenue</span>
                            <span class="kpi-badge badge-success">↗ @Model.RevenueGrowth%</span>
                        </div>
                        <div class="kpi-value text-truncate">৳@Model.TotalRevenue.ToString("N0")</div>
                    </div>
                    <div class="text-muted small mt-2">Store performance this month</div>
                </div>
            </div>
            
            <!-- Total Orders Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Total Orders</span>
                            <div class="kpi-icon" style="background-color: #ecfdf5; color: #10b981;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">@Model.TotalOrders.ToString("N0")</div>
                    </div>
                    <div class="text-muted small mt-2">Completed in the last 30 days</div>
                </div>
            </div>

            <!-- Avg Order Value Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Avg Order Value</span>
                            <div class="kpi-icon" style="background-color: #f5f3ff; color: #8b5cf6;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">৳@Model.AvgOrderValue.ToString("N0")</div>
                    </div>
                    <div class="text-muted small mt-2">Across all completed orders</div>
                </div>
            </div>

            <!-- Health Score Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Health Score</span>
                            <div class="kpi-icon" style="background-color: #f0f9ff; color: #0ea5e9;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">@Model.HealthScore<span class="fs-6 text-muted">/100</span></div>
                    </div>
                    <div class="text-muted small mt-2">Based on store activity</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right column: Main Revenue Trend Card -->
    <div class="col-12 col-xl-7">
        <div class="card shadow-sm border-1 h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0 text-dark">Revenue Trend</h5>
                <span class="text-muted small">৳ in millions</span>
            </div>
            <div style="height: 240px; position: relative;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Demand Forecast & Category Sales Row -->
<div class="row g-4 mb-4">
    <!-- Demand Forecast Product List -->
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm border-1 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">Demand Forecast</h5>
                    <p class="text-muted small mb-0">Predicted demand for top selling products</p>
                </div>
                <div class="btn-group-timeframe">
                    <a href="?range=7d" class="btn-timeframe @(Context.Request.Query["range"] == "7d" ? "active" : "")" style="text-decoration: none;">7D</a>
                    <a href="?range=15d" class="btn-timeframe @(Context.Request.Query["range"] == "15d" ? "active" : "")" style="text-decoration: none;">15D</a>
                    <a href="?range=30d" class="btn-timeframe @(Context.Request.Query["range"] == "30d" || string.IsNullOrEmpty(Context.Request.Query["range"]) ? "active" : "")" style="text-decoration: none;">30D</a>
                </div>
            </div>
            
            <div class="forecast-grid mt-3">
                @for (int i = 0; i < Model.ProductForecasts.Count; i++)
                {
                    var f = Model.ProductForecasts[i];
                    var sparkColor = (i % 3) switch {
                        0 => "#2563eb",
                        1 => "#8b5cf6",
                        _ => "#0ea5e9"
                    };

                    <div class="forecast-item-card">
                        <div class="forecast-badge-number">@(i + 1)</div>
                        <div class="fw-bold text-dark text-truncate mb-1" style="font-size: 0.85rem;" title="@f.ProductName">
                            @f.ProductName
                        </div>
                        <div class="text-muted mb-2" style="font-size: 0.75rem;">@f.Category</div>
                        
                        <!-- Sparkline SVG -->
                        <div class="forecast-sparkline">
                            <svg viewBox="0 0 100 30" class="w-100 h-100" preserveAspectRatio="none">
                                @{
                                    var points = "";
                                    for(int k=0; k<f.SparklineData.Count; k++) {
                                        var x = (k * 11).ToString(System.Globalization.CultureInfo.InvariantCulture);
                                        // Normalize height within 30px container
                                        var y = (30 - (f.SparklineData[k] * 0.8)).ToString(System.Globalization.CultureInfo.InvariantCulture);
                                        points += (k == 0 ? "M" : "L") + $" {x} {y} ";
                                    }
                                }
                                <path d="@points" fill="none" stroke="@sparkColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top" style="font-size: 0.75rem;">
                            <div>
                                <span class="fw-bold text-dark">@f.PredictedUnits.ToString("N0")</span>
                                <span class="text-muted d-block" style="font-size: 0.65rem;">units / 30d</span>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold text-dark">@f.Stock</span>
                                <span class="text-muted d-block" style="font-size: 0.65rem;">in stock</span>
                            </div>
                        </div>
                        <div class="text-muted mt-1" style="font-size: 0.65rem;">
                            ~@f.DailyAverage units/day
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sales By Category Doughnut -->
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-1 p-4 h-100">
            <h5 class="fw-bold mb-3 text-dark">Sales by Category</h5>
            
            <div class="position-relative d-flex justify-content-center align-items-center" style="height: 180px;">
                <canvas id="categoryChart" style="max-height: 160px; max-width: 160px;"></canvas>
                <div class="position-absolute text-center" style="pointer-events: none; z-index: 10;">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 0.6rem; letter-spacing: 0.5px;">Total</small>
                    <div class="fw-bold text-dark" style="font-size: 1rem;">৳@Model.TotalRevenue.ToString("N0")</div>
                </div>
            </div>

            <div class="row g-2 mt-3" style="font-size: 0.8rem;">
                @for (int i = 0; i < Model.CategorySales.Count; i++)
                {
                    var cat = Model.CategorySales[i];
                    var catColor = (i % 4) switch {
                        0 => "#2563eb",
                        1 => "#8b5cf6",
                        2 => "#0ea5e9",
                        _ => "#ec4899"
                    };
                    <div class="col-6 d-flex align-items-center gap-2">
                        <span class="rounded-circle" style="width: 8px; height: 8px; background-color: @catColor; display: inline-block;"></span>
                        <div class="text-truncate">
                            <span class="fw-bold text-dark d-block text-truncate" style="font-size: 0.75rem;">@cat.Category</span>
                            <span class="text-muted" style="font-size: 0.7rem;">@cat.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Performers Lists section (Top Performers & Needs Attention) -->
<div class="row g-4">
    <!-- Top Performers List -->
    <div class="col-12 col-md-6">
        <div class="card p-4 border-1 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
                <h5 class="fw-bold mb-0 text-dark">Top Performers</h5>
                <span class="badge" style="background-color: #fff7ed; color: #ea580c; font-size: 0.65rem;">HIGH MOMENTUM</span>
            </div>
            <p class="text-muted small mb-3">Highest revenue generating items</p>
            
            <div class="performers-list">
                @foreach (var item in Model.TopPerformers)
                {
                    <div class="performers-item">
                        <div class="d-flex align-items-center">
                            <span class="performers-num top-rank">#@item.Rank</span>
                            <span class="fw-bold text-dark" style="font-size: 0.85rem;">@item.ProductName</span>
                        </div>
                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">৳@item.Revenue.ToString("N0")</span>
                    </div>
                }
                @if (!Model.TopPerformers.Any())
                {
                    <div class="text-center text-muted small py-4">No data available</div>
                }
            </div>
        </div>
    </div>

    <!-- Needs Attention List -->
    <div class="col-12 col-md-6">
        <div class="card p-4 border-1 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
                <h5 class="fw-bold mb-0 text-dark">Needs Attention</h5>
                <span class="badge" style="background-color: #fef2f2; color: #ef4444; font-size: 0.65rem;">AT RISK</span>
            </div>
            <p class="text-muted small mb-3">Lowest inventory items needing restock</p>
            
            <div class="performers-list">
                @foreach (var item in Model.NeedsAttention)
                {
                    // Calculate filled percentage for stock indicator bar
                    var pct = (double)item.Stock / Math.Max(1, item.Threshold) * 100;
                    var barColor = pct < 50 ? "#ef4444" : "#f97316";

                    <div class="performers-item">
                        <div class="d-flex align-items-center" style="width: 70%;">
                            <span class="performers-num normal-rank">@item.Rank</span>
                            <div class="text-truncate" style="width: 100%;">
                                <span class="fw-bold text-dark d-block text-truncate" style="font-size: 0.85rem;">@item.ProductName</span>
                                <div class="performers-bar" style="max-width: 120px;">
                                    <div class="performers-bar-fill" style="width: @Math.Min(100, pct).ToString(System.Globalization.CultureInfo.InvariantCulture)%; background-color: @barColor;"></div>
                                </div>
                            </div>
                        </div>
                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">@item.Stock left</span>
                    </div>
                }
                @if (!Model.NeedsAttention.Any())
                {
                    <div class="text-center text-muted small py-4">No data available</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";

    // Revenue Trend Chart (Line Chart)
    const revLabels = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Date)));
    const revData = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Revenue)));

    if (document.getElementById('revenueChart')) {
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: revLabels,
                datasets: [{
                    label: 'Revenue (৳)',
                    data: revData,
                    borderColor: '#0f172a',
                    backgroundColor: 'rgba(15, 23, 42, 0.03)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#0f172a',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 1.5,
                    pointRadius: 3,
                    pointHoverRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        padding: 10,
                        titleFont: { size: 12, weight: 'bold' },
                        bodyFont: { size: 12 }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            color: '#64748b',
                            font: { size: 10 },
                            callback: function(value) {
                                if (value >= 1000000) return '৳' + (value / 1000000).toFixed(0) + 'M';
                                return '৳' + value.toLocaleString();
                            }
                        }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b', font: { size: 10 } }
                    }
                }
            }
        });
    }

    // Sales by Category Chart (Doughnut Chart)
    const catLabels = @Html.Raw(Json.Serialize(Model.CategorySales.Select(c => c.Category)));
    const catPercentages = @Html.Raw(Json.Serialize(Model.CategorySales.Select(c => c.Percentage)));

    if (document.getElementById('categoryChart')) {
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catPercentages,
                    backgroundColor: ['#2563eb', '#8b5cf6', '#0ea5e9', '#ec4899', '#f59e0b'],
                    borderWidth: 3,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '80%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) { return ' ' + context.label + ': ' + context.parsed + '%'; }
                        }
                    }
                }
            }
        });
    }
</script>
}
