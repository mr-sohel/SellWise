@model SellWise.Web.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Top Header section matching 02_dashboard.png -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Overview</h2>
        <p class="text-muted small mb-0 d-flex align-items-center gap-1">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Store performance for the last 30D
        </p>
    </div>
    <div class="btn-group-timeframe">
        <a href="?range=7d" class="btn-timeframe @(Context.Request.Query["range"] == "7d" ? "active" : "")">7D</a>
        <a href="?range=30d" class="btn-timeframe @(Context.Request.Query["range"] == "30d" || string.IsNullOrEmpty(Context.Request.Query["range"]) ? "active" : "")">30D</a>
        <a href="?range=90d" class="btn-timeframe @(Context.Request.Query["range"] == "90d" ? "active" : "")">90D</a>
        <a href="?range=1y" class="btn-timeframe @(Context.Request.Query["range"] == "1y" ? "active" : "")">1Y</a>
    </div>
</div>

<!-- KPI Cards & Main Revenue Trend Row -->
<div class="row g-4 mb-4">
    <!-- Left column: 2x2 Grid of KPIs -->
    <div class="col-12 col-xl-5">
        <div class="row g-3 h-100">
            <!-- Total Revenue Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Total Revenue</span>
                            <span class="kpi-badge @(Model.RevenueGrowth >= 0 ? "badge-success" : "badge-danger")">@(Model.RevenueGrowth >= 0 ? "↗" : "↘") @Math.Abs(Model.RevenueGrowth)%</span>
                        </div>
                        <div class="kpi-value text-truncate">৳@Model.TotalRevenue.ToString("N0")</div>
                    </div>
                    <div class="text-muted small mt-2">Store performance this month</div>
                </div>
            </div>
            
            <!-- Total Orders Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Total Orders</span>
                            <div class="kpi-icon bg-brand-soft text-brand">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">@Model.TotalOrders.ToString("N0")</div>
                    </div>
                    <div class="text-muted small mt-2">Completed in the last 30 days</div>
                </div>
            </div>

            <!-- Avg Order Value Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Avg Order Value</span>
                            <div class="kpi-icon bg-purple-soft text-purple">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">৳@Model.AvgOrderValue.ToString("N0")</div>
                    </div>
                    <div class="text-muted small mt-2">Across all completed orders</div>
                </div>
            </div>

            <!-- Health Score Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Health Score</span>
                            <div class="kpi-icon bg-sky-soft text-sky">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">@Model.HealthScore<span class="fs-6 text-muted">/100</span></div>
                    </div>
                    <div class="text-muted small mt-2">Based on store activity</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right column: Main Revenue Trend Card -->
    <div class="col-12 col-xl-7">
        <div class="card shadow-sm border-1 h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">Revenue Trend</h5>
                <span class="text-muted small">৳ in millions</span>
            </div>
            <div style="height: 240px; position: relative;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Demand Forecast & Category Sales Row -->
<div class="row g-4 mb-4">
    <!-- Demand Forecast Product List -->
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm border-1 p-4 h-100">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 gap-3">
                <div>
                    <h5 class="fw-bold mb-0">Demand Forecast</h5>
                    <p class="text-muted small mb-0">Predicted demand for top selling products</p>
                </div>
                <div class="btn-group-timeframe">
                    <a href="?range=7d" class="btn-timeframe @(Context.Request.Query["range"] == "7d" ? "active" : "")">7D</a>
                    <a href="?range=15d" class="btn-timeframe @(Context.Request.Query["range"] == "15d" ? "active" : "")">15D</a>
                    <a href="?range=30d" class="btn-timeframe @(Context.Request.Query["range"] == "30d" || string.IsNullOrEmpty(Context.Request.Query["range"]) ? "active" : "")">30D</a>
                </div>
            </div>
            
            <div class="forecast-grid mt-3">
                @for (int i = 0; i < Model.ProductForecasts.Count; i++)
                {
                    var f = Model.ProductForecasts[i];
                    var sparkColor = (i % 3) switch {
                        0 => "#4338ca",
                        1 => "#8b5cf6",
                        _ => "#0ea5e9"
                    };

                    <div class="forecast-item-card">
                        <div class="forecast-badge-number">@(i + 1)</div>
                        <span class="ai-badge">AI Forecast</span>
                        <div class="product-name text-truncate mb-1" title="@f.ProductName">
                            @f.ProductName
                        </div>
                        <div class="product-category mb-2">@f.Category</div>
                        
                        <!-- Sparkline SVG -->
                        @{
                            var sparkMin = f.SparklineData.Any() ? f.SparklineData.Min() : 0.0;
                            var sparkMax = f.SparklineData.Any() ? f.SparklineData.Max() : 1.0;
                        }
                        <div class="forecast-sparkline" data-values="@string.Join(",", f.SparklineData)" data-color="@sparkColor" data-min="@sparkMin" data-max="@sparkMax">
                            <svg aria-hidden="true" viewBox="0 0 100 30" class="w-100 h-100">
                                <defs>
                                    <linearGradient id="sparkFill@(i)" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="@sparkColor" stop-opacity="0.2"/>
                                        <stop offset="100%" stop-color="@sparkColor" stop-opacity="0.0"/>
                                    </linearGradient>
                                </defs>
                                @{
                                    var sPadX = 2.0;
                                    var sPadY = 2.0;
                                    var sW = 100.0 - 2 * sPadX;
                                    var sH = 30.0 - 2 * sPadY;
                                    var sRange = sparkMax - sparkMin;
                                    if (sRange < 1e-9) sRange = 1.0;

                                    var pts = new List<(double x, double y)>();
                                    for(int k=0; k<f.SparklineData.Count; k++) {
                                        var px = sPadX + (f.SparklineData.Count > 1 ? k * sW / (f.SparklineData.Count - 1) : sW / 2);
                                        var normalized = (f.SparklineData[k] - sparkMin) / sRange;
                                        var py = sPadY + sH * (1.0 - normalized);
                                        pts.Add((px, py));
                                    }

                                    string smoothPath = "";
                                    string fillPath = "";
                                    if (pts.Count > 1) {
                                        smoothPath = "M " + pts[0].x.ToString("F2") + " " + pts[0].y.ToString("F2");
                                        for (int s = 0; s < pts.Count - 1; s++) {
                                            var p0 = pts[Math.Max(0, s - 1)];
                                            var p1 = pts[s];
                                            var p2 = pts[s + 1];
                                            var p3 = pts[Math.Min(pts.Count - 1, s + 2)];

                                            var cp1x = p1.x + (p2.x - p0.x) / 6.0;
                                            var cp1y = p1.y + (p2.y - p0.y) / 6.0;
                                            var cp2x = p2.x - (p3.x - p1.x) / 6.0;
                                            var cp2y = p2.y - (p3.y - p1.y) / 6.0;

                                            smoothPath += $" C {cp1x.ToString("F2")} {cp1y.ToString("F2")}, {cp2x.ToString("F2")} {cp2y.ToString("F2")}, {p2.x.ToString("F2")} {p2.y.ToString("F2")}";
                                        }

                                        var lastX = pts[pts.Count - 1].x.ToString("F2");
                                        var firstX = pts[0].x.ToString("F2");
                                        fillPath = smoothPath + $" L {lastX} 30 L {firstX} 30 Z";
                                    }
                                }
                                <path d="@fillPath" fill="url(#sparkFill@(i))" />
                                <path d="@smoothPath" fill="none" stroke="@sparkColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle class="spark-dot" cx="0" cy="0" r="2.5" fill="@sparkColor" stroke="#fff" stroke-width="1.5" opacity="0"/>
                            </svg>
                            <div class="spark-hover-tooltip"></div>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top" style="font-size: 0.75rem;">
                            <div>
                                <span class="stat-value">@f.PredictedUnits.ToString("N0")</span>
                                <span class="stat-label">units / 30d</span>
                            </div>
                            <div class="text-end">
                                <span class="stat-value">@f.Stock</span>
                                <span class="stat-label">in stock</span>
                            </div>
                        </div>
                        <div class="text-muted mt-1" style="font-size: 0.65rem;">
                            ~@f.DailyAverage units/day
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sales By Category Doughnut -->
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-1 p-4 h-100">
            <h5 class="fw-bold mb-3">Sales by Category</h5>
            
            <div class="doughnut-wrapper">
                <canvas id="categoryChart" class="doughnut-canvas"></canvas>
                <div class="doughnut-center">
                    <small class="doughnut-center-label">Total</small>
                    <div class="fw-bold">৳@Model.TotalRevenue.ToString("N0")</div>
                </div>
            </div>

            <div class="row g-2 mt-3" style="font-size: 0.8rem;">
                @for (int i = 0; i < Model.CategorySales.Count; i++)
                {
                    var cat = Model.CategorySales[i];
                    var catColor = (i % 4) switch {
                        0 => "#4338ca",
                        1 => "#8b5cf6",
                        2 => "#0ea5e9",
                        _ => "#f97316"
                    };
                    <div class="col-6 d-flex align-items-center gap-2">
                        <span class="rounded-circle" style="width: 8px; height: 8px; background-color: @catColor; display: inline-block;"></span>
                        <div class="text-truncate">
                            <span class="fw-bold text-dark d-block text-truncate" style="font-size: 0.75rem;">@cat.Category</span>
                            <span class="text-muted" style="font-size: 0.7rem;">@cat.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Performers Lists section (Top Performers & Needs Attention) -->
<div class="row g-4">
    <!-- Top Performers List -->
    <div class="col-12 col-md-6">
        <div class="card p-4 border-1 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
                <h5 class="fw-bold mb-0">Top Performers</h5>
                <span class="badge badge-momentum">HIGH MOMENTUM</span>
            </div>
            <p class="text-muted small mb-3">Highest revenue generating items</p>
            
            <div class="performers-list">
                @foreach (var item in Model.TopPerformers)
                {
                    <div class="performers-item">
                        <div class="d-flex align-items-center">
                            <span class="performers-num top-rank">#@item.Rank</span>
                            <span class="fw-bold text-dark" style="font-size: 0.85rem;">@item.ProductName</span>
                        </div>
                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">৳@item.Revenue.ToString("N0")</span>
                    </div>
                }
                @if (!Model.TopPerformers.Any())
                {
                    <div class="text-center text-muted small py-4">No data available</div>
                }
            </div>
        </div>
    </div>

    <!-- Needs Attention List -->
    <div class="col-12 col-md-6">
        <div class="card p-4 border-1 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
                <h5 class="fw-bold mb-0">Needs Attention</h5>
                <span class="badge badge-atrisk">AT RISK</span>
            </div>
            <p class="text-muted small mb-3">Lowest inventory items needing restock</p>
            
            <div class="performers-list">
                @foreach (var item in Model.NeedsAttention)
                {
                    // Calculate filled percentage for stock indicator bar
                    var pct = (double)item.Stock / Math.Max(1, item.Threshold) * 100;
                    var barColor = pct < 50 ? "#ef4444" : "#f97316";

                    <div class="performers-item">
                        <div class="d-flex align-items-center" style="width: 70%;">
                            <span class="performers-num normal-rank">@item.Rank</span>
                            <div class="text-truncate" style="width: 100%;">
                                <span class="fw-bold text-dark d-block text-truncate" style="font-size: 0.85rem;">@item.ProductName</span>
                                <div class="performers-bar" style="max-width: 120px;">
                                    <div class="performers-bar-fill" style="width: @Math.Min(100, pct).ToString(System.Globalization.CultureInfo.InvariantCulture)%; background-color: @barColor;"></div>
                                </div>
                            </div>
                        </div>
                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">@item.Stock left</span>
                    </div>
                }
                @if (!Model.NeedsAttention.Any())
                {
                    <div class="text-center text-muted small py-4">No data available</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";

    // Revenue Trend Chart (Line Chart)
    const revLabels = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Date)));
    const revData = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Revenue)));

    if (document.getElementById('revenueChart')) {
        var revCtx = document.getElementById('revenueChart').getContext('2d');
        var revGradient = revCtx.createLinearGradient(0, 0, 0, 240);
        revGradient.addColorStop(0, 'rgba(67, 56, 202, 0.12)');
        revGradient.addColorStop(1, 'rgba(67, 56, 202, 0.0)');

        new Chart(revCtx, {
            type: 'line',
            data: {
                labels: revLabels,
                datasets: [{
                    label: 'Revenue (৳)',
                    data: revData,
                    borderColor: '#4338ca',
                    backgroundColor: revGradient,
                    borderWidth: 2,
                    tension: 0.35,
                    fill: true,
                    pointRadius: 0,
                    pointHoverRadius: 5,
                    pointBackgroundColor: '#4338ca',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointHoverBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 1200,
                    easing: 'easeOutQuart'
                },
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1c1917',
                        titleColor: '#a8a29e',
                        bodyColor: '#ffffff',
                        padding: { top: 8, bottom: 8, left: 12, right: 12 },
                        cornerRadius: 6,
                        caretPadding: 8,
                        displayColors: false,
                        titleFont: { size: 11, weight: '500' },
                        bodyFont: { size: 13, weight: '700' },
                        callbacks: {
                            title: function(items) {
                                return items[0].label;
                            },
                            label: function(context) {
                                var val = context.parsed.y;
                                if (val >= 1000000) return '৳' + (val / 1000000).toFixed(2) + 'M';
                                return '৳' + val.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        border: { display: false },
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            color: '#64748b',
                            font: { size: 10 },
                            callback: function(value) {
                                if (value >= 1000000) return '৳' + (value / 1000000).toFixed(0) + 'M';
                                return '৳' + value.toLocaleString();
                            }
                        }
                    },
                    x: {
                        border: { display: false },
                        grid: { display: false },
                        ticks: {
                            color: '#64748b',
                            font: { size: 10 },
                            maxRotation: -30,
                            autoSkip: true,
                            maxTicksLimit: 15
                        }
                    }
                }
            }
        });
    }

    // Sales by Category Chart (Doughnut Chart)
    const catLabels = @Html.Raw(Json.Serialize(Model.CategorySales.Select(c => c.Category)));
    const catPercentages = @Html.Raw(Json.Serialize(Model.CategorySales.Select(c => c.Percentage)));

    if (document.getElementById('categoryChart')) {
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catPercentages,
                    backgroundColor: ['#4338ca', '#8b5cf6', '#0ea5e9', '#f97316', '#10b981'],
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 8,
                    hoverBorderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '75%',
                animation: {
                    animateRotate: true,
                    animateScale: true,
                    duration: 1000,
                    easing: 'easeOutQuart'
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1c1917',
                        titleColor: '#a8a29e',
                        bodyColor: '#ffffff',
                        padding: { top: 8, bottom: 8, left: 12, right: 12 },
                        cornerRadius: 6,
                        caretPadding: 8,
                        displayColors: true,
                        boxPadding: 4,
                        titleFont: { size: 11, weight: '500' },
                        bodyFont: { size: 13, weight: '700' },
                        callbacks: {
                            label: function(context) {
                                return ' ' + context.label + ': ' + context.parsed + '%';
                            }
                        }
                    }
                }
            }
        });
    }

    // Sparkline hover interaction
    document.querySelectorAll('.forecast-sparkline').forEach(function(el) {
        var svg = el.querySelector('svg');
        var dot = el.querySelector('.spark-dot');
        var tooltip = el.querySelector('.spark-hover-tooltip');
        var values = (el.getAttribute('data-values') || '').split(',').map(Number);
        var sMin = parseFloat(el.getAttribute('data-min')) || 0;
        var sMax = parseFloat(el.getAttribute('data-max')) || 1;
        if (!values.length || !svg || !dot) return;

        var sPadX = 2, sPadY = 2, sW = 96, sH = 26;
        var sRange = sMax - sMin;
        if (sRange < 1e-9) sRange = 1;

        el.addEventListener('mousemove', function(e) {
            var rect = svg.getBoundingClientRect();
            var mouseX = e.clientX - rect.left;
            var ratio = mouseX / rect.width;
            var idx = Math.round(ratio * (values.length - 1));
            idx = Math.max(0, Math.min(values.length - 1, idx));

            var ptX = sPadX + (values.length > 1 ? idx * sW / (values.length - 1) : sW / 2);
            var normalized = (values[idx] - sMin) / sRange;
            var ptY = sPadY + sH * (1.0 - normalized);

            dot.setAttribute('cx', ptX);
            dot.setAttribute('cy', ptY);
            dot.setAttribute('opacity', '1');

            var ctm = svg.getScreenCTM();
            if (!ctm) return;
            var screenX = ptX * ctm.a + ctm.e;
            var screenY = ptY * ctm.d + ctm.f;

            tooltip.textContent = Math.round(values[idx]) + ' units';
            tooltip.style.left = (screenX - rect.left) + 'px';
            tooltip.style.top = (screenY - rect.top) + 'px';
            tooltip.style.opacity = '1';
        });

        el.addEventListener('mouseleave', function() {
            dot.setAttribute('opacity', '0');
            tooltip.style.opacity = '0';
        });
    });
</script>
}
