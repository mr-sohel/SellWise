@model SellWise.Web.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var currentRangeTop = (string)ViewData["Range"]!;
    var isStaff = (ViewData["CurrentStoreRole"] as string) != SellWise.Web.Authorization.StoreRoles.Owner;
    int topPerformersPageSize = 5;
    int topPerformersTotalPages = (int)Math.Ceiling(Model.TopPerformers.Count / (double)topPerformersPageSize);
    if (topPerformersTotalPages < 1) topPerformersTotalPages = 1;

    int needsAttentionPageSize = 5;
    int needsAttentionTotalPages = (int)Math.Ceiling(Model.NeedsAttention.Count / (double)needsAttentionPageSize);
    if (needsAttentionTotalPages < 1) needsAttentionTotalPages = 1;
}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-heading">Dashboard</h1>
        <p class="page-sub">How the store is doing over the selected period.</p>
    </div>
    <div class="btn-group-timeframe" role="group" aria-label="Date range">
        <a href="?range=7d" class="btn-timeframe @(currentRangeTop == "7d" ? "active" : "")" aria-current="@(currentRangeTop == "7d" ? "true" : null)">7 days</a>
        <a href="?range=30d" class="btn-timeframe @(currentRangeTop == "30d" ? "active" : "")" aria-current="@(currentRangeTop == "30d" ? "true" : null)">30 days</a>
        <a href="?range=90d" class="btn-timeframe @(currentRangeTop == "90d" ? "active" : "")" aria-current="@(currentRangeTop == "90d" ? "true" : null)">90 days</a>
        <a href="?range=1y" class="btn-timeframe @(currentRangeTop == "1y" ? "active" : "")" aria-current="@(currentRangeTop == "1y" ? "true" : null)">1 year</a>
    </div>
</div>

<!-- Key figures -->
<div class="stat-strip mb-4">
    <div class="stat">
        <span class="stat-label">Revenue</span>
        <div class="stat-value text-truncate">৳@Model.TotalRevenue.ToString("N0")</div>
        <span class="stat-delta @(Model.RevenueGrowth >= 0 ? "up" : "down")">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">@if (Model.RevenueGrowth >= 0) {<polyline points="18 15 12 9 6 15"/>} else {<polyline points="6 9 12 15 18 9"/>}</svg>
            @Math.Abs(Model.RevenueGrowth)% <span class="fw-normal text-muted">vs previous period</span>
        </span>
    </div>
    <div class="stat">
        <span class="stat-label">Orders</span>
        <div class="stat-value">@Model.TotalOrders.ToString("N0")</div>
        <span class="stat-note">Cancelled and returned excluded</span>
    </div>
    <div class="stat">
        <span class="stat-label">Average order</span>
        <div class="stat-value text-truncate">৳@Model.AvgOrderValue.ToString("N0")</div>
        <span class="stat-note">Revenue per order</span>
    </div>
    <div class="stat @(Model.LowStockCount > 0 ? "is-warning" : "")">
        <a asp-controller="Alert" asp-action="Index" class="stat-link">
            <span class="stat-label">Low on stock</span>
            <div class="stat-value">@Model.LowStockCount</div>
            <span class="stat-note">@(Model.LowStockCount > 0 ? "Review alerts" : "Everything is stocked")</span>
        </a>
    </div>
</div>

<!-- Revenue trend & category split -->
<div class="row g-4 mb-4">
<div class="col-12 col-xl-8">
<div class="card p-4 h-100 d-flex flex-column">
    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="h5 mb-0">Revenue trend</h2>
        <span class="text-muted small">Daily revenue in ৳</span>
    </div>
    <div class="flex-grow-1" style="min-height: 260px; position: relative;">
        <canvas id="revenueChart" role="img" aria-label="Line chart of daily revenue for the selected period"></canvas>
    </div>
</div>
</div>
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-1 p-4 h-100">
            <h2 class="h5 mb-3">Sales by category</h2>
            
            <div class="doughnut-wrapper">
                <canvas id="categoryChart" class="doughnut-canvas" role="img" aria-label="Doughnut chart of sales share by category"></canvas>
                <div class="doughnut-center">
                    <small class="doughnut-center-label">Total</small>
                    <div class="doughnut-center-value">৳@Model.TotalRevenue.ToString("N0")</div>
                </div>
            </div>

            <div class="row g-2 mt-3">
                @for (int i = 0; i < Model.CategorySales.Count; i++)
                {
                    var cat = Model.CategorySales[i];
                    var catColor = (i % 5) switch {
                        0 => "#0f6b5c",
                        1 => "#c9962e",
                        2 => "#3e6fa3",
                        3 => "#d2674a",
                        _ => "#7a8f87"
                    };
                    <div class="col-6 d-flex align-items-center gap-2">
                        <span class="legend-dot" style="background-color: @catColor;"></span>
                        <div class="text-truncate">
                            <span class="fw-semibold text-dark d-block text-truncate small">@cat.Category</span>
                            <span class="text-muted small">@cat.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Performers Lists section (Top Performers & Needs Attention) -->
<div class="row g-4">
    <!-- Top Performers List -->
    <div class="col-12 col-md-6">
        <div class="card p-4 border-1 shadow-sm h-100 d-flex flex-column">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="h5 mb-0">Top performers</h2>
                </div>
            </div>
            <p class="text-muted small mb-3">Products that earned the most in this period</p>
            
            <div class="performers-list flex-grow-1" id="topPerformersContainer">
                @for (int p = 0; p < topPerformersTotalPages; p++)
                {
                    var pageItems = Model.TopPerformers.Skip(p * topPerformersPageSize).Take(topPerformersPageSize).ToList();
                    <div class="top-performers-page @(p > 0 ? "d-none" : "")" data-page="@(p + 1)">
                        @foreach (var item in pageItems)
                        {
                            <div class="performers-item">
                                <span class="performers-num top-rank">@item.Rank</span>
                                <span class="fw-semibold text-dark flex-grow-1 text-truncate" title="@item.ProductName">@item.ProductName</span>
                                <span class="fw-semibold text-dark">৳@item.Revenue.ToString("N0")</span>
                            </div>
                        }
                    </div>
                }
                @if (!Model.TopPerformers.Any())
                {
                    <div class="text-center text-muted small py-4">Nothing to show yet</div>
                }
            </div>

            @if (topPerformersTotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                    <span class="text-muted small" id="topPerformersPageInfo">Page 1 of @topPerformersTotalPages</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="topPerformersPrevBtn" onclick="changeTopPerformersPage(-1)" disabled >Previous</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="topPerformersNextBtn" onclick="changeTopPerformersPage(1)" >Next</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Needs Attention List -->
    <div class="col-12 col-md-6">
        <div class="card p-4 border-1 shadow-sm h-100 d-flex flex-column">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="h5 mb-0">Needs attention</h2>
                </div>
            </div>
            <p class="text-muted small mb-3">Products closest to running out. Select one to restock.</p>
            
            <div class="performers-list flex-grow-1" id="needsAttentionContainer">
                @for (int p = 0; p < needsAttentionTotalPages; p++)
                {
                    var pageItems = Model.NeedsAttention.Skip(p * needsAttentionPageSize).Take(needsAttentionPageSize).ToList();
                    <div class="needs-attention-page @(p > 0 ? "d-none" : "")" data-page="@(p + 1)">
                        @foreach (var item in pageItems)
                        {
                            @if (!isStaff)
                            {
                                <div class="performers-item performers-item-clickable"
                                     role="button"
                                     tabindex="0"
                                     title="Click to restock @item.ProductName"
                                     data-product-id="@item.ProductId" data-product-name="@item.ProductName"
                                     data-stock="@item.Stock" data-qty="@item.SuggestedRestockQty" data-unit="@(item.Unit ?? "units")"
                                     onclick="openRestockFromButton(this, () => window.location.reload())"
                                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
                                    <span class="performers-num normal-rank">@item.Rank</span>
                                    <span class="fw-semibold text-dark flex-grow-1 text-truncate" title="@item.ProductName">@item.ProductName</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="performers-stock">@item.Stock left</span>
                                        <span class="btn btn-sm btn-outline-secondary py-0 px-2 d-none d-sm-inline-flex align-items-center">Restock</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="performers-item">
                                    <span class="performers-num normal-rank">@item.Rank</span>
                                    <span class="fw-semibold text-dark flex-grow-1 text-truncate" title="@item.ProductName">@item.ProductName</span>
                                    <span class="performers-stock">@item.Stock left</span>
                                </div>
                            }
                        }
                    </div>
                }
                @if (!Model.NeedsAttention.Any())
                {
                    <div class="text-center text-muted small py-4">Nothing to show yet</div>
                }
            </div>

            @if (needsAttentionTotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                    <span class="text-muted small" id="needsAttentionPageInfo">Page 1 of @needsAttentionTotalPages</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="needsAttentionPrevBtn" onclick="changeNeedsAttentionPage(-1)" disabled >Previous</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="needsAttentionNextBtn" onclick="changeNeedsAttentionPage(1)" >Next</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7"></script>
<script>
    Chart.defaults.font.family = "'Instrument Sans', sans-serif";

    // Revenue Trend Chart (Line Chart)
    const revLabels = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Date)));
    const revData = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Revenue)));

    if (document.getElementById('revenueChart')) {
        var revCtx = document.getElementById('revenueChart').getContext('2d');
        var revGradient = revCtx.createLinearGradient(0, 0, 0, 260);
        revGradient.addColorStop(0, 'rgba(15, 107, 92, 0.14)');
        revGradient.addColorStop(1, 'rgba(15, 107, 92, 0.0)');

        new Chart(revCtx, {
            type: 'line',
            data: {
                labels: revLabels,
                datasets: [{
                    label: 'Revenue (৳)',
                    data: revData,
                    borderColor: '#0f6b5c',
                    backgroundColor: revGradient,
                    borderWidth: 2,
                    tension: 0.35,
                    fill: true,
                    pointRadius: 0,
                    pointHoverRadius: 5,
                    pointBackgroundColor: '#0f6b5c',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointHoverBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 1200,
                    easing: 'easeOutQuart'
                },
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0a211d',
                        titleColor: '#a9bbb4',
                        bodyColor: '#ffffff',
                        padding: { top: 8, bottom: 8, left: 12, right: 12 },
                        cornerRadius: 6,
                        caretPadding: 8,
                        displayColors: false,
                        titleFont: { size: 11, weight: '500' },
                        bodyFont: { size: 13, weight: '700' },
                        callbacks: {
                            title: function(items) {
                                return items[0].label;
                            },
                            label: function(context) {
                                var val = context.parsed.y;
                                if (val >= 1000000) return '৳' + (val / 1000000).toFixed(2) + 'M';
                                return '৳' + val.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        border: { display: false },
                        grid: { color: '#e8edeb' },
                        ticks: {
                            color: '#62726c',
                            font: { size: 10 },
                            callback: function(value) {
                                if (value >= 1000000) return '৳' + (value / 1000000).toFixed(0) + 'M';
                                return '৳' + value.toLocaleString();
                            }
                        }
                    },
                    x: {
                        border: { display: false },
                        grid: { display: false },
                        ticks: {
                            color: '#62726c',
                            font: { size: 10 },
                            maxRotation: -30,
                            autoSkip: true,
                            maxTicksLimit: 15
                        }
                    }
                }
            }
        });
    }

    // Sales by Category Chart (Doughnut Chart)
    const catLabels = @Html.Raw(Json.Serialize(Model.CategorySales.Select(c => c.Category)));
    const catPercentages = @Html.Raw(Json.Serialize(Model.CategorySales.Select(c => c.Percentage)));

    if (document.getElementById('categoryChart')) {
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catPercentages,
                    backgroundColor: ['#0f6b5c', '#c9962e', '#3e6fa3', '#d2674a', '#7a8f87'],
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 8,
                    hoverBorderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '75%',
                animation: {
                    animateRotate: true,
                    animateScale: true,
                    duration: 1000,
                    easing: 'easeOutQuart'
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0a211d',
                        titleColor: '#a9bbb4',
                        bodyColor: '#ffffff',
                        padding: { top: 8, bottom: 8, left: 12, right: 12 },
                        cornerRadius: 6,
                        caretPadding: 8,
                        displayColors: true,
                        boxPadding: 4,
                        titleFont: { size: 11, weight: '500' },
                        bodyFont: { size: 13, weight: '700' },
                        callbacks: {
                            label: function(context) {
                                return ' ' + context.label + ': ' + context.parsed + '%';
                            }
                        }
                    }
                }
            }
        });
    }

    // Top Performers & Needs Attention Pagination
    let currentTopPerformersPage = 1;
    const totalTopPerformersPages = @topPerformersTotalPages;

    function changeTopPerformersPage(delta) {
        const newPage = currentTopPerformersPage + delta;
        if (newPage < 1 || newPage > totalTopPerformersPages) return;
        currentTopPerformersPage = newPage;
        document.querySelectorAll('.top-performers-page').forEach(el => {
            el.classList.toggle('d-none', parseInt(el.getAttribute('data-page')) !== currentTopPerformersPage);
        });
        const info = document.getElementById('topPerformersPageInfo');
        if (info) info.textContent = `Page ${currentTopPerformersPage} of ${totalTopPerformersPages}`;
        
        const prevBtn = document.getElementById('topPerformersPrevBtn');
        const nextBtn = document.getElementById('topPerformersNextBtn');
        const hPrev = document.getElementById('topPerformersHeaderPrev');
        const hNext = document.getElementById('topPerformersHeaderNext');
        if (prevBtn) prevBtn.disabled = currentTopPerformersPage === 1;
        if (nextBtn) nextBtn.disabled = currentTopPerformersPage === totalTopPerformersPages;
        if (hPrev) hPrev.disabled = currentTopPerformersPage === 1;
        if (hNext) hNext.disabled = currentTopPerformersPage === totalTopPerformersPages;
    }

    let currentNeedsAttentionPage = 1;
    const totalNeedsAttentionPages = @needsAttentionTotalPages;

    function changeNeedsAttentionPage(delta) {
        const newPage = currentNeedsAttentionPage + delta;
        if (newPage < 1 || newPage > totalNeedsAttentionPages) return;
        currentNeedsAttentionPage = newPage;
        document.querySelectorAll('.needs-attention-page').forEach(el => {
            el.classList.toggle('d-none', parseInt(el.getAttribute('data-page')) !== currentNeedsAttentionPage);
        });
        const info = document.getElementById('needsAttentionPageInfo');
        if (info) info.textContent = `Page ${currentNeedsAttentionPage} of ${totalNeedsAttentionPages}`;
        
        const prevBtn = document.getElementById('needsAttentionPrevBtn');
        const nextBtn = document.getElementById('needsAttentionNextBtn');
        const hPrev = document.getElementById('needsAttentionHeaderPrev');
        const hNext = document.getElementById('needsAttentionHeaderNext');
        if (prevBtn) prevBtn.disabled = currentNeedsAttentionPage === 1;
        if (nextBtn) nextBtn.disabled = currentNeedsAttentionPage === totalNeedsAttentionPages;
        if (hPrev) hPrev.disabled = currentNeedsAttentionPage === 1;
        if (hNext) hNext.disabled = currentNeedsAttentionPage === totalNeedsAttentionPages;
    }
</script>
}
