@model SellWise.Web.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Top Header section matching 02_dashboard.png -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Dashboard</h2>
        <p class="text-muted small mb-0">Your business at a glance</p>
    </div>
    <div class="btn-group-timeframe">
        <a href="?range=7d" class="btn-timeframe @(Context.Request.Query["range"] == "7d" ? "active" : "")">7D</a>
        <a href="?range=30d" class="btn-timeframe @(Context.Request.Query["range"] == "30d" || string.IsNullOrEmpty(Context.Request.Query["range"]) ? "active" : "")">30D</a>
        <a href="?range=90d" class="btn-timeframe @(Context.Request.Query["range"] == "90d" ? "active" : "")">90D</a>
        <a href="?range=1y" class="btn-timeframe @(Context.Request.Query["range"] == "1y" ? "active" : "")">1Y</a>
    </div>
</div>

<!-- KPI Cards & Main Revenue Trend Row -->
<div class="row g-4 mb-4">
    <!-- Left column: 2x2 Grid of KPIs -->
    <div class="col-12 col-xl-5">
        <div class="row g-3 h-100">
            <!-- Total Revenue Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Total Revenue</span>
                            <span class="kpi-badge @(Model.RevenueGrowth >= 0 ? "badge-success" : "badge-danger")">@(Model.RevenueGrowth >= 0 ? "↗" : "↘") @Math.Abs(Model.RevenueGrowth)%</span>
                        </div>
                        <div class="kpi-value text-truncate">৳@Model.TotalRevenue.ToString("N0")</div>
                    </div>
                </div>
            </div>
            
            <!-- Total Orders Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Total Orders</span>
                            <div class="kpi-icon bg-brand-soft text-brand">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">@Model.TotalOrders.ToString("N0")</div>
                    </div>
                </div>
            </div>
            
            <!-- Avg Order Value Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Avg Order Value</span>
                            <div class="kpi-icon bg-purple-soft text-purple">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">৳@Model.AvgOrderValue.ToString("N0")</div>
                    </div>
                </div>
            </div>
            
            <!-- Health Score Card -->
            <div class="col-12 col-sm-6">
                <div class="card p-4 h-100 border-1 shadow-sm">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-title">Health Score</span>
                            <div class="kpi-icon bg-sky-soft text-sky">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            </div>
                        </div>
                        <div class="kpi-value">@Model.HealthScore<span class="fs-6 text-muted">/100</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right column: Main Revenue Trend Card -->
    <div class="col-12 col-xl-7">
        <div class="card shadow-sm border-1 h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">Revenue Trend</h5>
                <span class="text-muted small">৳ in millions</span>
            </div>
            <div style="height: 240px; position: relative;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Demand Forecast & Category Sales Row -->
<div class="row g-4 mb-4">
    <!-- Demand Forecast Product List -->
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm border-1 p-4 h-100" id="forecastGridContainer" style="position: relative;">
            @{
                var currentRange = Context.Request.Query["range"].ToString();
                if (string.IsNullOrEmpty(currentRange)) currentRange = "30d";
                var forecastVm = new SellWise.Web.ViewModels.Dashboard.ForecastPagedViewModel {
                    ProductForecasts = Model.ProductForecasts,
                    CurrentPage = (int)(ViewData["ForecastPage"] ?? 1),
                    TotalPages = (int)(ViewData["ForecastTotalPages"] ?? 1),
                    Range = currentRange
                };
            }
            <partial name="_ForecastGrid" model="forecastVm" />
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-1 p-4 h-100">
            <h5 class="fw-bold mb-3">Sales by Category</h5>
            
            <div class="doughnut-wrapper">
                <canvas id="categoryChart" class="doughnut-canvas"></canvas>
                <div class="doughnut-center">
                    <small class="doughnut-center-label">Total</small>
                    <div class="fw-bold">৳@Model.TotalRevenue.ToString("N0")</div>
                </div>
            </div>

            <div class="row g-2 mt-3" style="font-size: 0.8rem;">
                @for (int i = 0; i < Model.CategorySales.Count; i++)
                {
                    var cat = Model.CategorySales[i];
                    var catColor = (i % 4) switch {
                        0 => "#4338ca",
                        1 => "#8b5cf6",
                        2 => "#0ea5e9",
                        _ => "#f97316"
                    };
                    <div class="col-6 d-flex align-items-center gap-2">
                        <span class="rounded-circle" style="width: 8px; height: 8px; background-color: @catColor; display: inline-block;"></span>
                        <div class="text-truncate">
                            <span class="fw-bold text-dark d-block text-truncate" style="font-size: 0.75rem;">@cat.Category</span>
                            <span class="text-muted" style="font-size: 0.7rem;">@cat.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Performers Lists section (Top Performers & Needs Attention) -->
<div class="row g-4">
    <!-- Top Performers List -->
    <div class="col-12 col-md-6">
        <div class="card p-4 border-1 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
                <h5 class="fw-bold mb-0">Top Performers</h5>
                <span class="badge badge-momentum">HIGH MOMENTUM</span>
            </div>
            <p class="text-muted small mb-3">Highest revenue generating items</p>
            
            <div class="performers-list">
                @foreach (var item in Model.TopPerformers)
                {
                    <div class="performers-item">
                        <span class="performers-num top-rank">@item.Rank</span>
                        <span class="fw-bold text-dark flex-grow-1 text-truncate" style="font-size: 0.85rem;">@item.ProductName</span>
                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">৳@item.Revenue.ToString("N0")</span>
                    </div>
                }
                @if (!Model.TopPerformers.Any())
                {
                    <div class="text-center text-muted small py-4">No data available</div>
                }
            </div>
        </div>
    </div>

    <!-- Needs Attention List -->
    <div class="col-12 col-md-6">
        <div class="card p-4 border-1 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2">
                <h5 class="fw-bold mb-0">Needs Attention</h5>
                <span class="badge badge-atrisk">AT RISK</span>
            </div>
            <p class="text-muted small mb-3">Lowest inventory items needing restock</p>
            
            <div class="performers-list">
                @foreach (var item in Model.NeedsAttention)
                {
                    <div class="performers-item">
                        <span class="performers-num normal-rank">@item.Rank</span>
                        <span class="fw-bold text-dark flex-grow-1 text-truncate" style="font-size: 0.85rem;">@item.ProductName</span>
                        <span class="performers-stock">@item.Stock left</span>
                    </div>
                }
                @if (!Model.NeedsAttention.Any())
                {
                    <div class="text-center text-muted small py-4">No data available</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function loadForecastPage(range, page) {
        const container = document.getElementById('forecastGridContainer');
        container.style.opacity = '0.5';
        container.style.pointerEvents = 'none';

        fetch(`/Dashboard/ForecastGrid?range=${range}&page=${page}`)
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.text();
            })
            .then(html => {
                container.innerHTML = html;
                container.style.opacity = '1';
                container.style.pointerEvents = 'auto';
                initSparklineInteractions();
            })
            .catch(error => {
                console.error('Error loading forecast page:', error);
                container.style.opacity = '1';
                container.style.pointerEvents = 'auto';
            });
    }

    function initSparklineInteractions() {
        document.querySelectorAll('.forecast-sparkline').forEach(function(el) {
            // Unbind existing to avoid duplicates if re-inited
            const newEl = el.cloneNode(true);
            el.parentNode.replaceChild(newEl, el);

            var svg = newEl.querySelector('svg');
            var dot = newEl.querySelector('.spark-dot');
            var tooltip = newEl.querySelector('.spark-hover-tooltip');
            var values = (newEl.getAttribute('data-values') || '').split(',').map(Number);
            var sMin = parseFloat(newEl.getAttribute('data-min')) || 0;
            var sMax = parseFloat(newEl.getAttribute('data-max')) || 1;
            if (!values.length || !svg || !dot) return;

            var sPadX = 2, sPadY = 2, sW = 96, sH = 26;
            var sRange = sMax - sMin;
            if (sRange < 1e-9) sRange = 1;

            newEl.addEventListener('mousemove', function(e) {
                var rect = svg.getBoundingClientRect();
                var mouseX = e.clientX - rect.left;
                var ratio = mouseX / rect.width;
                var idx = Math.round(ratio * (values.length - 1));
                idx = Math.max(0, Math.min(values.length - 1, idx));

                var ptX = sPadX + (values.length > 1 ? idx * sW / (values.length - 1) : sW / 2);
                var normalized = (values[idx] - sMin) / sRange;
                var ptY = sPadY + sH * (1.0 - normalized);

                dot.setAttribute('cx', ptX);
                dot.setAttribute('cy', ptY);
                dot.setAttribute('opacity', '1');

                var ctm = svg.getScreenCTM();
                if (!ctm) return;
                var screenX = ptX * ctm.a + ctm.e;
                var screenY = ptY * ctm.d + ctm.f;

                tooltip.textContent = Math.round(values[idx]) + ' units';
                tooltip.style.left = (screenX - rect.left) + 'px';
                tooltip.style.top = (screenY - rect.top) + 'px';
                tooltip.style.opacity = '1';
            });

            newEl.addEventListener('mouseleave', function() {
                dot.setAttribute('opacity', '0');
                tooltip.style.opacity = '0';
            });
        });
    }

    Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";

    // Revenue Trend Chart (Line Chart)
    const revLabels = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Date)));
    const revData = @Html.Raw(Json.Serialize(Model.RevenueTrend.Select(r => r.Revenue)));

    if (document.getElementById('revenueChart')) {
        var revCtx = document.getElementById('revenueChart').getContext('2d');
        var revGradient = revCtx.createLinearGradient(0, 0, 0, 240);
        revGradient.addColorStop(0, 'rgba(67, 56, 202, 0.12)');
        revGradient.addColorStop(1, 'rgba(67, 56, 202, 0.0)');

        new Chart(revCtx, {
            type: 'line',
            data: {
                labels: revLabels,
                datasets: [{
                    label: 'Revenue (৳)',
                    data: revData,
                    borderColor: '#4338ca',
                    backgroundColor: revGradient,
                    borderWidth: 2,
                    tension: 0.35,
                    fill: true,
                    pointRadius: 0,
                    pointHoverRadius: 5,
                    pointBackgroundColor: '#4338ca',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointHoverBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 1200,
                    easing: 'easeOutQuart'
                },
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1c1917',
                        titleColor: '#78716c',
                        bodyColor: '#ffffff',
                        padding: { top: 8, bottom: 8, left: 12, right: 12 },
                        cornerRadius: 6,
                        caretPadding: 8,
                        displayColors: false,
                        titleFont: { size: 11, weight: '500' },
                        bodyFont: { size: 13, weight: '700' },
                        callbacks: {
                            title: function(items) {
                                return items[0].label;
                            },
                            label: function(context) {
                                var val = context.parsed.y;
                                if (val >= 1000000) return '৳' + (val / 1000000).toFixed(2) + 'M';
                                return '৳' + val.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        border: { display: false },
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            color: '#64748b',
                            font: { size: 10 },
                            callback: function(value) {
                                if (value >= 1000000) return '৳' + (value / 1000000).toFixed(0) + 'M';
                                return '৳' + value.toLocaleString();
                            }
                        }
                    },
                    x: {
                        border: { display: false },
                        grid: { display: false },
                        ticks: {
                            color: '#64748b',
                            font: { size: 10 },
                            maxRotation: -30,
                            autoSkip: true,
                            maxTicksLimit: 15
                        }
                    }
                }
            }
        });
    }

    // Sales by Category Chart (Doughnut Chart)
    const catLabels = @Html.Raw(Json.Serialize(Model.CategorySales.Select(c => c.Category)));
    const catPercentages = @Html.Raw(Json.Serialize(Model.CategorySales.Select(c => c.Percentage)));

    if (document.getElementById('categoryChart')) {
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catPercentages,
                    backgroundColor: ['#4338ca', '#8b5cf6', '#0ea5e9', '#f97316', '#10b981'],
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 8,
                    hoverBorderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '75%',
                animation: {
                    animateRotate: true,
                    animateScale: true,
                    duration: 1000,
                    easing: 'easeOutQuart'
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1c1917',
                        titleColor: '#78716c',
                        bodyColor: '#ffffff',
                        padding: { top: 8, bottom: 8, left: 12, right: 12 },
                        cornerRadius: 6,
                        caretPadding: 8,
                        displayColors: true,
                        boxPadding: 4,
                        titleFont: { size: 11, weight: '500' },
                        bodyFont: { size: 13, weight: '700' },
                        callbacks: {
                            label: function(context) {
                                return ' ' + context.label + ': ' + context.parsed + '%';
                            }
                        }
                    }
                }
            }
        });
    }

    // Sparkline hover interaction
    initSparklineInteractions();
</script>
}
