@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
    <div class="d-flex align-items-center justify-content-center mb-3"
         style="width:56px; height:56px; border-radius:16px; background:var(--danger-bg); color:var(--danger);">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
    </div>
    <h2 class="fw-bold text-dark">Something went wrong</h2>
    <p class="text-muted mb-4" style="max-width: 420px;">
        An error occurred while processing your request. Please try again,
        and if the problem persists, contact support.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-2 px-4">Back to Dashboard</a>
</div>
