<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a211d" />
    <title>@ViewData["Title"] - SellWise</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%230F6B5C'/%3E%3Cpath d='M10 7h12a1 1 0 0 1 1 1v17.2l-2.333-1.7-2.334 1.7-2.333-1.7-2.333 1.7-2.334-1.7L9 25.2V8a1 1 0 0 1 1-1z' fill='%23F4F6F5'/%3E%3Cpath d='M12.5 12h7M12.5 15.5h7' stroke='%230F6B5C' stroke-width='1.6' stroke-linecap='round'/%3E%3Cpath d='M12.5 19h3.5' stroke='%23C9962E' stroke-width='1.8' stroke-linecap='round'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://code.jquery.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@500;700&text=%E0%A7%B3&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-shell">
        <aside class="auth-aside" aria-hidden="true">
            <span class="auth-brand">
                <partial name="_Logo" model="34" />
                <span class="brand-text">SellWise</span>
            </span>

            <div>
                <h2 class="auth-headline">Every sale updates your shelves.</h2>
                <p class="auth-lede">Ring up customers, keep stock honest, and see what to reorder before it runs out.</p>

                <div class="receipt-stage">
                    <div class="receipt">
                        <div class="receipt-head">
                            <div class="receipt-store">Corner Market</div>
                            <div class="receipt-meta">Sale #1042 · Walk-in</div>
                        </div>
                        <div class="receipt-line"><span>Basmati rice 5 kg<small>1 × ৳820</small></span><span>৳820</span></div>
                        <div class="receipt-line"><span>Mustard oil 1 L<small>2 × ৳320</small></span><span>৳640</span></div>
                        <div class="receipt-line"><span>Red lentils 1 kg<small>2 × ৳150</small></span><span>৳300</span></div>
                        <div class="receipt-line"><span>Tea leaves 400 g<small>1 × ৳380</small></span><span>৳380</span></div>
                        <div class="receipt-total"><span>Total</span><strong>৳2,140</strong></div>
                    </div>
                    <div class="receipt-chip">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Stock updated
                    </div>
                </div>
            </div>

            <div class="auth-aside-foot">SellWise · portfolio project</div>
        </aside>

        <main class="auth-main" id="mainContent">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Shared password visibility toggle for auth forms
        function togglePassword(btn) {
            var input = btn.closest('.position-relative').querySelector('input');
            var eyeOpen = btn.querySelector('.eye-open');
            var eyeClosed = btn.querySelector('.eye-closed');
            if (input.type === 'password') {
                input.type = 'text';
                eyeOpen.classList.add('d-none');
                eyeClosed.classList.remove('d-none');
                btn.setAttribute('aria-label', 'Hide password');
            } else {
                input.type = 'password';
                eyeOpen.classList.remove('d-none');
                eyeClosed.classList.add('d-none');
                btn.setAttribute('aria-label', 'Show password');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
