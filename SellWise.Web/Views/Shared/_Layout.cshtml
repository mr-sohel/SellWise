@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject SellWise.Web.Data.AppDbContext _db
@inject UserManager<ApplicationUser> _userManager
@{
    // The active store and role are resolved by BaseController; the layout only needs the store list for the switcher.
    var userId = _userManager.GetUserId(User);
    var activeStoreId = Context.Session.GetString("ActiveStoreId");
    var role = ViewData["CurrentStoreRole"] as string;
    var isOwner = role == SellWise.Web.Authorization.StoreRoles.Owner;

    var userStores = userId == null
        ? new List<SellWise.Web.Models.Store>()
        : await _db.StoreMembers
            .Where(m => m.UserId == userId)
            .OrderBy(m => m.CreatedAt)
            .Select(m => m.Store)
            .ToListAsync();
    var currentStore = userStores.FirstOrDefault(s => s.Id.ToString() == activeStoreId);

    // Unread alerts for the sidebar badge (scoped to the active store, like every other store query)
    var unreadAlerts = 0;
    if (currentStore != null)
    {
        var currentStoreId = currentStore.Id;
        unreadAlerts = await _db.Alerts.CountAsync(a => a.StoreId == currentStoreId && !a.IsRead);
    }

    // Local initials for the profile avatar (no third-party request)
    var emailName = (User.Identity?.Name ?? "User").Split('@')[0];
    var avatarInitials = new string(emailName.Where(char.IsLetterOrDigit).Take(2).ToArray()).ToUpperInvariant();
    if (string.IsNullOrEmpty(avatarInitials)) { avatarInitials = "U"; }
    var roleLabel = isOwner ? "Owner" : "Staff";

    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString();
    string Active(string c) => string.Equals(controllerName, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string? Current(string c) => string.Equals(controllerName, c, StringComparison.OrdinalIgnoreCase) ? "page" : null;

    const string svgOpen = "<svg aria-hidden=\"true\" class=\"nav-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">";
    var iconDashboard = svgOpen + "<rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1.5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1.5\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1.5\"/></svg>";
    var iconOrders = svgOpen + "<path d=\"M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/></svg>";
    var iconCustomers = svgOpen + "<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>";
    var iconProducts = svgOpen + "<path d=\"m7.5 4.27 9 5.15\"/><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"/><path d=\"m3.3 7 8.7 5 8.7-5\"/><path d=\"M12 22V12\"/></svg>";
    var iconAlerts = svgOpen + "<path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg>";
    var iconReports = svgOpen + "<path d=\"M3 3v18h18\"/><path d=\"M7 15l4-4 3 3 5-6\"/></svg>";
    var iconSettings = svgOpen + "<path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    var homeAction = isOwner ? "Dashboard" : "Order";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a211d" />
    <title>@ViewData["Title"] - SellWise</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%230F6B5C'/%3E%3Cpath d='M10 7h12a1 1 0 0 1 1 1v17.2l-2.333-1.7-2.334 1.7-2.333-1.7-2.333 1.7-2.334-1.7L9 25.2V8a1 1 0 0 1 1-1z' fill='%23F4F6F5'/%3E%3Cpath d='M12.5 12h7M12.5 15.5h7' stroke='%230F6B5C' stroke-width='1.6' stroke-linecap='round'/%3E%3Cpath d='M12.5 19h3.5' stroke='%23C9962E' stroke-width='1.8' stroke-linecap='round'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://code.jquery.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@500;700&text=%E0%A7%B3&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#mainContent" class="visually-hidden-focusable">Skip to main content</a>
    <div class="app-container d-flex">
        <!-- Sidebar -->
        <nav class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebarMenu" aria-label="Main navigation">
            <div class="offcanvas-header d-lg-none">
                <a asp-controller="@homeAction" asp-action="Index">
                    <partial name="_Logo" model="30" />
                    <span class="brand-text">SellWise</span>
                </a>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Close menu"></button>
            </div>
            <div class="sidebar-brand d-none d-lg-flex">
                <a asp-controller="@homeAction" asp-action="Index">
                    <partial name="_Logo" model="32" />
                    <span class="brand-text">SellWise</span>
                </a>
            </div>

            <div class="sidebar-cta">
                <a asp-controller="Order" asp-action="Create" class="btn-new-sale">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    New order
                </a>
            </div>

            <ul class="nav flex-column">
                @if (isOwner)
                {
                    <li class="nav-item">
                        <a class="nav-link @Active("Dashboard")" aria-current="@Current("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                            @Html.Raw(iconDashboard)
                            <span>Dashboard</span>
                        </a>
                    </li>
                }

                <li class="nav-group-label" aria-hidden="true">Sales</li>
                <li class="nav-item">
                    <a class="nav-link @Active("Order")" aria-current="@Current("Order")" asp-controller="Order" asp-action="Index">
                        @Html.Raw(iconOrders)
                        <span>Orders</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Customer")" aria-current="@Current("Customer")" asp-controller="Customer" asp-action="Index">
                        @Html.Raw(iconCustomers)
                        <span>Customers</span>
                    </a>
                </li>

                <li class="nav-group-label" aria-hidden="true">Stock</li>
                <li class="nav-item">
                    <a class="nav-link @Active("Product")" aria-current="@Current("Product")" asp-controller="Product" asp-action="Index">
                        @Html.Raw(iconProducts)
                        <span>Products</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Active("Alert")" aria-current="@Current("Alert")" asp-controller="Alert" asp-action="Index">
                        @Html.Raw(iconAlerts)
                        <span>Alerts</span>
                        @if (unreadAlerts > 0)
                        {
                            <span class="nav-count" aria-label="@unreadAlerts unread">@(unreadAlerts > 99 ? "99+" : unreadAlerts.ToString())</span>
                        }
                    </a>
                </li>

                @if (isOwner)
                {
                    <li class="nav-group-label" aria-hidden="true">Insights</li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Report")" aria-current="@Current("Report")" asp-controller="Report" asp-action="Index">
                            @Html.Raw(iconReports)
                            <span>Reports</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <span class="sidebar-avatar" aria-hidden="true">@avatarInitials</span>
                    <div class="text-truncate">
                        <div class="sidebar-user-name text-truncate">@emailName</div>
                        <div class="sidebar-user-role">@roleLabel@(currentStore != null ? " · " + currentStore.Name : "")</div>
                    </div>
                </div>
                <a class="nav-link @Active("Settings")" aria-current="@Current("Settings")" asp-controller="Settings" asp-action="Index">
                    @Html.Raw(iconSettings)
                    <span>Settings</span>
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="btn-logout">
                        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        <span>Log out</span>
                    </button>
                </form>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="main-content" id="mainContent">
            <header class="top-nav d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <button class="btn btn-sm border-0 bg-transparent d-lg-none p-1 text-body" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-label="Open menu">
                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>

                    <div class="dropdown">
                        <a href="#" class="store-switch dropdown-toggle" id="dropdownStore" role="button" aria-label="Switch store. Current store: @(currentStore?.Name ?? "none selected")" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="store-switch-icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M5 12v8h14v-8"/></svg>
                            </span>
                            <span class="store-name">@(currentStore?.Name ?? "Select a store")</span>
                            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-muted"><polyline points="6 9 12 15 18 9"/></svg>
                        </a>
                        <ul class="dropdown-menu mt-2" aria-labelledby="dropdownStore">
                            <li><h6 class="dropdown-header">Your stores</h6></li>
                            @foreach (var store in userStores)
                            {
                                var isActiveStore = store.Id.ToString() == activeStoreId;
                                <li>
                                    <form asp-controller="Auth" asp-action="SwitchStore" method="post" class="m-0 p-0">
                                        <input type="hidden" name="storeId" value="@store.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="dropdown-item justify-content-between gap-3 @(isActiveStore ? "fw-bold" : "")" aria-current="@(isActiveStore ? "true" : null)">
                                            <span class="text-truncate">@store.Name</span>
                                            @if (isActiveStore)
                                            {
                                                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            }
                                        </button>
                                    </form>
                                </li>
                            }
                            @if (isOwner)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item gap-2" data-bs-toggle="modal" data-bs-target="#createStoreModal">
                                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                        Add a store
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="dropdown">
                    <a href="#" class="topbar-profile dropdown-toggle" id="dropdownUser" role="button" aria-label="Account menu" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="role-chip d-none d-sm-inline ms-2">@roleLabel</span>
                        <span class="topbar-avatar" aria-hidden="true">@avatarInitials</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end mt-2" aria-labelledby="dropdownUser">
                        <li><h6 class="dropdown-header text-truncate">@(User.Identity?.Name)</h6></li>
                        <li>
                            <a class="dropdown-item gap-2" asp-controller="Settings" asp-action="Index">
                                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                                Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                <button type="submit" class="dropdown-item text-danger gap-2">
                                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                    Log out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <div class="page-container animate-fade-in">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="app-footer">
                <div class="footer-left">SellWise · portfolio project</div>
            </footer>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Double-Submit Protection
        document.addEventListener('submit', function (e) {
            const form = e.target;
            if (form.classList.contains('no-loader')) return;

            // Only disable if the form is valid (if jQuery validation or HTML5 validation is present)
            if (typeof $(form).valid === 'function' && !$(form).valid()) return;
            if (form.checkValidity && !form.checkValidity()) return;

            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn && !submitBtn.disabled) {
                submitBtn.disabled = true;
                const originalText = submitBtn.innerHTML;
                submitBtn.setAttribute('data-original-text', originalText);
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing…';
            }
        });

        let currentRestockCallback = null;

        // Restock buttons carry product data in data-* attributes (HTML-encoded by Razor) rather than
        // inline JS strings, so a product name containing quotes can't break out and run script.
        function openRestockFromButton(btn, callback) {
            const d = btn.dataset;
            openRestockModal(d.productId, d.productName, Number(d.stock), Number(d.qty), d.unit, callback);
        }

        function openRestockModal(productId, productName, currentStock, suggestedQty, unit, callback) {
            document.getElementById('restockProductId').value = productId;
            document.getElementById('restockProductName').textContent = productName || 'Product';
            document.getElementById('restockCurrentStock').textContent = (currentStock || 0) + ' ' + (unit || 'units');
            document.getElementById('restockQuantity').value = Math.max(1, suggestedQty || 1);
            document.getElementById('restockUnitHelp').textContent = 'Units to add to inventory (' + (unit || 'units') + ')';
            document.getElementById('restockError').classList.add('d-none');
            document.getElementById('restockError').textContent = '';

            currentRestockCallback = callback || null;

            const modalEl = document.getElementById('restockModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
            setTimeout(() => {
                const qtyInput = document.getElementById('restockQuantity');
                qtyInput.focus();
                qtyInput.select();
            }, 300);
        }

        function adjustRestockQty(delta) {
            const input = document.getElementById('restockQuantity');
            let val = (parseInt(input.value, 10) || 0) + delta;
            if (val < 1) val = 1;
            input.value = val;
        }

        function handleRestockSubmit(e) {
            e.preventDefault();
            const form = e.target;
            const submitBtn = document.getElementById('restockSubmitBtn');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Restocking...';

            const formData = new FormData(form);
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch('/Product/Restock', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(async res => {
                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.message || 'Failed to restock product.');
                }
                return data;
            })
            .then(data => {
                const modalEl = document.getElementById('restockModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();

                if (typeof currentRestockCallback === 'function') {
                    currentRestockCallback(data);
                } else {
                    if (window.location.pathname.toLowerCase().includes('/alert')) {
                        window.location.reload();
                    }
                }
            })
            .catch(err => {
                const errEl = document.getElementById('restockError');
                errEl.textContent = err.message;
                errEl.classList.remove('d-none');
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Restock Modal -->
    <div class="modal fade" id="restockModal" tabindex="-1" aria-labelledby="restockModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content">
                <form id="restockForm" onsubmit="handleRestockSubmit(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="restockProductId" name="productId" />
                    <div class="modal-header border-0 pb-0">
                        <div class="d-flex align-items-center gap-3 min-w-0">
                            <div class="modal-icon">
                                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                            </div>
                            <div class="min-w-0">
                                <h5 class="modal-title mb-0" id="restockModalLabel">Restock product</h5>
                                <p class="text-muted small mb-0 text-truncate" id="restockProductName" style="max-width: 270px;">Product name</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3">
                        <div class="d-flex justify-content-between align-items-center mb-3 px-3 py-2 bg-light rounded-3 small">
                            <span class="text-muted">Current stock</span>
                            <span class="fw-bold text-dark" id="restockCurrentStock">0 units</span>
                        </div>

                        <label class="form-label" for="restockQuantity">Units to add</label>
                        <div class="input-group mb-2">
                            <button class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" type="button" onclick="adjustRestockQty(-1)" aria-label="Decrease by 1" style="min-width: 48px;">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <input type="number" id="restockQuantity" name="quantity" class="form-control text-center fw-bold no-spinners" value="1" min="1" required style="font-size: 1.35rem;" />
                            <button class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" type="button" onclick="adjustRestockQty(1)" aria-label="Increase by 1" style="min-width: 48px;">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                        </div>

                        <div class="d-flex justify-content-center gap-1 mb-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-muted" onclick="adjustRestockQty(-10)">-10</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-muted" onclick="adjustRestockQty(-5)">-5</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn add" onclick="adjustRestockQty(5)">+5</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn add" onclick="adjustRestockQty(10)">+10</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn add" onclick="adjustRestockQty(25)">+25</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn add" onclick="adjustRestockQty(50)">+50</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn add" onclick="adjustRestockQty(100)">+100</button>
                        </div>

                        <div id="restockUnitHelp" class="form-text text-center mt-1"></div>
                        <div id="restockError" class="alert alert-danger p-2 small mt-2 d-none" role="alert"></div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="restockSubmitBtn" class="btn btn-primary px-4 d-flex align-items-center gap-2">
                            <span>Add stock</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (isOwner)
    {
        <!-- Create Store Modal -->
        <div class="modal fade" id="createStoreModal" tabindex="-1" aria-labelledby="createStoreModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Auth" asp-action="CreateStore" method="post">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title" id="createStoreModalLabel">Add a store</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label" for="newStoreName">Store name</label>
                            <input type="text" id="newStoreName" name="StoreName" class="form-control" placeholder="e.g. Downtown branch" required maxlength="100" autocomplete="off">
                            <div class="form-text mt-2">You'll be switched into the new store as its owner. It starts empty.</div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary px-4">Add store</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</body>
</html>
