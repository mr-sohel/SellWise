@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject SellWise.Web.Data.AppDbContext _db
@inject UserManager<ApplicationUser> _userManager
@{
    var userId = _userManager.GetUserId(User);
    var activeStoreId = Context.Session.GetString("ActiveStoreId");

    var userStoreMembers = new List<SellWise.Web.Models.StoreMember>();
    if (userId != null)
    {
        userStoreMembers = _db.StoreMembers
            .Include(m => m.Store)
            .Where(m => m.UserId == userId)
            .ToList();
    }
    var currentMember = userStoreMembers.FirstOrDefault(m => m.StoreId.ToString() == activeStoreId)
                        ?? userStoreMembers.FirstOrDefault();
    var currentStore = currentMember?.Store;
    var isOwner = currentMember?.Role == "owner";
    var isEmployee = currentMember?.Role == "employee" || string.Equals(ViewData["CurrentStoreRole"]?.ToString(), "employee", StringComparison.OrdinalIgnoreCase);

    // Local initials for the profile avatar (no third-party request)
    var emailName = (User.Identity?.Name ?? "User").Split('@')[0];
    var avatarInitials = new string(emailName.Where(char.IsLetterOrDigit).Take(2).ToArray()).ToUpperInvariant();
    if (string.IsNullOrEmpty(avatarInitials)) { avatarInitials = "U"; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SellWise</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%234338ca'/%3E%3Cpath d='M12 5L5 9L12 13L19 9L12 5Z' stroke='white' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M5 9V15L12 19L19 15V9' stroke='white' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M12 13V19' stroke='white' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://code.jquery.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#mainContent" class="visually-hidden-focusable">Skip to main content</a>
    <div class="app-container d-flex">
        <!-- Sidebar -->
        <nav class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebarMenu">
            <div class="offcanvas-header d-lg-none border-bottom px-4">
                <a asp-controller="@(!isEmployee ? "Dashboard" : "Order")" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
                    <div class="brand-logo">
                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect width="24" height="24" rx="6" fill="#4338ca"/>
                            <path d="M12 5L5 9L12 13L19 9L12 5Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5 9V15L12 19L19 15V9" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M12 13V19" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span class="brand-text mb-0">SellWise</span>
                </a>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="sidebar-brand d-none d-lg-flex">
                <a asp-controller="@(!isEmployee ? "Dashboard" : "Order")" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
                    <div class="brand-logo">
                        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect width="24" height="24" rx="6" fill="#4338ca"/>
                            <path d="M12 5L5 9L12 13L19 9L12 5Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5 9V15L12 19L19 15V9" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M12 13V19" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span class="brand-text">SellWise</span>
                </a>
            </div>
            <ul class="nav flex-column">
                @if (!isEmployee)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                            <svg aria-hidden="true" class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            <span>Dashboard</span>
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")" asp-controller="Product" asp-action="Index">
                        <svg aria-hidden="true" class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                        <span>Products</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")" asp-controller="Order" asp-action="Index">
                        <svg aria-hidden="true" class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                        <span>Orders</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customer" ? "active" : "")" asp-controller="Customer" asp-action="Index">
                        <svg aria-hidden="true" class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>Customers</span>
                    </a>
                </li>
                @if (!isEmployee)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Expense" ? "active" : "")" asp-controller="Expense" asp-action="Index">
                            <svg aria-hidden="true" class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                            <span>Expenses</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" ? "active" : "")" asp-controller="Report" asp-action="Index">
                            <svg aria-hidden="true" class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                            <span>Reports</span>
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Alert" ? "active" : "")" asp-controller="Alert" asp-action="Index">
                        <svg aria-hidden="true" class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                        <span>Alerts</span>
                    </a>
                </li>
            </ul>
            <div class="sidebar-footer">
                <hr class="divider" />
                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-logout w-100">
                        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        <span>Log Out</span>
                    </button>
                </form>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="main-content" id="mainContent">
            <div class="top-nav d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-light d-lg-none p-1 border-0 bg-transparent text-muted" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-label="Toggle navigation">
                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                    <h1 class="page-title mb-0">@ViewData["Title"]</h1>
                </div>
                
                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <div class="search-widget dropdown" id="omnisearch-widget">
                        <svg aria-hidden="true" class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" id="omnisearch-input" aria-label="Search" placeholder="Search…" autocomplete="off" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="search-shortcut d-none d-md-inline-block">&#8984; K</span>
                        <ul class="dropdown-menu shadow-lg border-0 mt-1" id="omnisearch-results" style="width: min(320px, calc(100vw - 2rem)); max-height: 400px; overflow-y: auto;">
                            <!-- Results will be injected here via JS -->
                        </ul>
                    </div>
                    <div class="dropdown me-2">
                        <a href="#" class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-1" id="dropdownStore" aria-label="Switch Store" data-bs-toggle="dropdown" aria-expanded="false">
                            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                            <span>@(currentStore?.Name ?? "Select Store")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="dropdownStore">
                            <li><h6 class="dropdown-header">Your Stores</h6></li>
                            @foreach (var sm in userStoreMembers)
                            {
                                var store = sm.Store;
                                if (store != null)
                                {
                                    <li>
                                        <form asp-controller="Auth" asp-action="SwitchStore" method="post" class="m-0 p-0 d-inline">
                                            <input type="hidden" name="storeId" value="@store.Id" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="dropdown-item @(store.Id.ToString() == activeStoreId ? "active fw-bold" : "")">
                                                @if (store.Id.ToString() == activeStoreId)
                                                {
                                                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                }
                                                @store.Name
                                            </button>
                                        </form>
                                    </li>
                                }
                            }
                            @if (isOwner)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#createStoreModal">
                                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                        Add Store
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle topbar-profile" id="dropdownUser" aria-label="Account menu" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="topbar-avatar" aria-hidden="true">@avatarInitials</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="dropdownUser">
                            <li><h6 class="dropdown-header">Account Management</h6></li>
                            <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index">
                                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                                Settings
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                        Log Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="page-container animate-fade-in">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="app-footer">
                <div class="footer-left">
                    &copy; 2026 SellWise Inc. All rights reserved.
                </div>
                <div class="footer-right">
                    <a href="#">Help & Support</a>
                    <a href="#">FAQ</a>
                    <a href="#">Privacy</a>
                    <a href="#">Terms</a>
                </div>
            </footer>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Double-Submit Protection
        document.addEventListener('submit', function (e) {
            const form = e.target;
            if (form.classList.contains('no-loader')) return;

            // Only disable if the form is valid (if jQuery validation or HTML5 validation is present)
            if (typeof $(form).valid === 'function' && !$(form).valid()) return;
            if (form.checkValidity && !form.checkValidity()) return;

            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn && !submitBtn.disabled) {
                submitBtn.disabled = true;
                const originalText = submitBtn.innerHTML;
                submitBtn.setAttribute('data-original-text', originalText);
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing…';
            }
        });

        // Omnisearch / Global Search Logic
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('omnisearch-input');
            const searchResults = document.getElementById('omnisearch-results');
            if (!searchInput) return;

            // Escape user-controlled values before injecting into HTML
            const esc = s => String(s ?? '').replace(/[&<>"']/g, c =>
                ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

            // Keyboard shortcut Cmd/Ctrl + K
            document.addEventListener('keydown', function(e) {
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault();
                    searchInput.focus();
                }
            });

            const dropdown = bootstrap.Dropdown.getOrCreateInstance(searchInput);
            let debounceTimer;

            searchInput.addEventListener('input', function(e) {
                clearTimeout(debounceTimer);
                const query = e.target.value.trim();

                if (query.length < 2) {
                    dropdown.hide();
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch(`/Search/QuickSearch?q=${encodeURIComponent(query)}`)
                        .then(res => {
                            if (res.redirected && res.url.includes('/Auth/Login')) {
                                window.location.href = res.url;
                                return null;
                            }
                            if (!res.ok) throw new Error("Search request failed");
                            return res.json();
                        })
                        .then(data => {
                            if (!data) return; // handled by redirect
                            if (data.success === false) return;

                            let html = '';

                                                        if (data.products && data.products.length) {
                                html += '<li><h6 class="dropdown-header px-3 mt-1 mb-1 text-primary"><small class="fw-bold">PRODUCTS</small></h6></li>';
                                data.products.forEach(p => {
                                    html += `<li><a class="dropdown-item py-2 px-3" href="${esc(p.url)}">
                                        <div class="d-flex justify-content-between align-items-center w-100">
                                            <div class="d-flex align-items-center">
                                                <svg class="me-2 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                                                <span class="fw-semibold text-dark">${esc(p.name)}</span>
                                            </div>
                                            <span class="badge bg-light text-muted border">${esc(p.detail)}</span>
                                        </div></a></li>`;
                                });
                            }

                            if (data.orders && data.orders.length) {
                                if (html) html += '<li><hr class="dropdown-divider my-1"></li>';
                                html += '<li><h6 class="dropdown-header px-3 mt-1 mb-1 text-primary"><small class="fw-bold">ORDERS</small></h6></li>';
                                data.orders.forEach(o => {
                                    html += `<li><a class="dropdown-item py-2 px-3" href="${esc(o.url)}">
                                        <div class="d-flex justify-content-between align-items-center w-100">
                                            <div class="d-flex align-items-center">
                                                <svg class="me-2 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                                                <span class="fw-semibold text-dark">${esc(o.name)}</span>
                                            </div>
                                            <span class="badge bg-light text-muted border">${esc(o.detail)}</span>
                                        </div></a></li>`;
                                });
                            }

                            if (data.customers && data.customers.length) {
                                if (html) html += '<li><hr class="dropdown-divider my-1"></li>';
                                html += '<li><h6 class="dropdown-header px-3 mt-1 mb-1 text-primary"><small class="fw-bold">CUSTOMERS</small></h6></li>';
                                data.customers.forEach(c => {
                                    html += `<li><a class="dropdown-item py-2 px-3" href="${esc(c.url)}">
                                        <div class="d-flex justify-content-between align-items-center w-100">
                                            <div class="d-flex align-items-center">
                                                <svg class="me-2 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                                <span class="fw-semibold text-dark">${esc(c.name)}</span>
                                            </div>
                                            <span class="badge bg-light text-muted border">${esc(c.detail)}</span>
                                        </div></a></li>`;
                                });
                            }

                            if (!html) {
                                html = '<li><span class="dropdown-item text-muted">No results found…</span></li>';
                            }

                            searchResults.innerHTML = html;
                            dropdown.show();
                        })
                        .catch(err => console.error('Search error:', err));
                }, 300);
            });

            // Keep dropdown open when clicking inside search input
            searchInput.addEventListener('click', function(e) {
                if (searchInput.value.trim().length >= 2 && searchResults.innerHTML !== '') {
                    e.stopPropagation();
                    dropdown.show();
                }
            });
        });

        let currentRestockCallback = null;

        function openRestockModal(productId, productName, currentStock, suggestedQty, unit, callback) {
            document.getElementById('restockProductId').value = productId;
            document.getElementById('restockProductName').textContent = productName || 'Product';
            document.getElementById('restockCurrentStock').textContent = (currentStock || 0) + ' ' + (unit || 'units');
            document.getElementById('restockQuantity').value = Math.max(1, suggestedQty || 1);
            document.getElementById('restockUnitHelp').textContent = 'Units to add to inventory (' + (unit || 'units') + ')';
            document.getElementById('restockError').classList.add('d-none');
            document.getElementById('restockError').textContent = '';
            
            currentRestockCallback = callback || null;

            const modalEl = document.getElementById('restockModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
            setTimeout(() => {
                const qtyInput = document.getElementById('restockQuantity');
                qtyInput.focus();
                qtyInput.select();
            }, 300);
        }

        function adjustRestockQty(delta) {
            const input = document.getElementById('restockQuantity');
            let val = (parseInt(input.value, 10) || 0) + delta;
            if (val < 1) val = 1;
            input.value = val;
        }

        function handleRestockSubmit(e) {
            e.preventDefault();
            const form = e.target;
            const submitBtn = document.getElementById('restockSubmitBtn');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Restocking...';

            const formData = new FormData(form);
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch('/Product/Restock', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(async res => {
                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.message || 'Failed to restock product.');
                }
                return data;
            })
            .then(data => {
                const modalEl = document.getElementById('restockModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();

                if (typeof currentRestockCallback === 'function') {
                    currentRestockCallback(data);
                } else {
                    if (typeof loadForecastPage === 'function') {
                        const range = window.currentForecastRange || '30d';
                        const page = window.currentForecastPage || 1;
                        loadForecastPage(range, page);
                    }
                    if (window.location.pathname.toLowerCase().includes('/alert')) {
                        window.location.reload();
                    }
                }
            })
            .catch(err => {
                const errEl = document.getElementById('restockError');
                errEl.textContent = err.message;
                errEl.classList.remove('d-none');
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Restock Modal -->
    <div class="modal fade" id="restockModal" tabindex="-1" aria-labelledby="restockModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-lg);">
                <form id="restockForm" onsubmit="handleRestockSubmit(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="restockProductId" name="productId" />
                    <div class="modal-header border-0 pb-0">
                        <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                            <div class="p-2 rounded-circle flex-shrink-0" style="background:#e0e7ff; color:#4338ca;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                            </div>
                            <div style="min-width: 0;">
                                <h5 class="modal-title fw-bold text-dark mb-0" id="restockModalLabel">Restock Product</h5>
                                <p class="text-muted small mb-0 text-truncate" id="restockProductName" style="max-width: 290px;">Product Name</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3">
                        <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded" style="font-size:0.85rem;">
                            <span class="text-muted">Current Stock:</span>
                            <span class="fw-bold text-dark" id="restockCurrentStock">0 units</span>
                        </div>

                        <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.85rem;" for="restockQuantity">Units to Add</label>
                        <div class="input-group mb-2">
                            <button class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" type="button" onclick="adjustRestockQty(-1)" title="Decrease by 1" style="min-width: 48px; border-color: var(--border-color);">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <input type="number" id="restockQuantity" name="quantity" class="form-control text-center fw-bold no-spinners" value="1" min="1" required style="font-size: 1.35rem; border-color: var(--border-color);" />
                            <button class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" type="button" onclick="adjustRestockQty(1)" title="Increase by 1" style="min-width: 48px; border-color: var(--border-color);">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                        </div>
                        
                        <div class="d-flex items-center justify-content-center gap-1 mb-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-muted" onclick="adjustRestockQty(-10)">-10</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-muted" onclick="adjustRestockQty(-5)">-5</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-primary" style="background-color: var(--brand-lighter); border-color: #c7d2fe !important;" onclick="adjustRestockQty(5)">+5</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-primary" style="background-color: var(--brand-lighter); border-color: #c7d2fe !important;" onclick="adjustRestockQty(10)">+10</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-primary" style="background-color: var(--brand-lighter); border-color: #c7d2fe !important;" onclick="adjustRestockQty(25)">+25</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-primary" style="background-color: var(--brand-lighter); border-color: #c7d2fe !important;" onclick="adjustRestockQty(50)">+50</button>
                            <button type="button" class="btn btn-sm btn-light border restock-quick-btn text-primary" style="background-color: var(--brand-lighter); border-color: #c7d2fe !important;" onclick="adjustRestockQty(100)">+100</button>
                        </div>

                        <div id="restockUnitHelp" class="form-text text-muted small text-center mt-1"></div>
                        <div id="restockError" class="alert alert-danger p-2 small mt-2 d-none"></div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal" style="border-radius: 20px;">Cancel</button>
                        <button type="submit" id="restockSubmitBtn" class="btn btn-primary px-4 d-flex align-items-center gap-2" style="background-color: #4338ca; border: none; border-radius: 20px;">
                            <span>Confirm Restock</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (isOwner)
    {
        <!-- Create Store Modal -->
        <div class="modal fade" id="createStoreModal" tabindex="-1" aria-labelledby="createStoreModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius: var(--radius-lg);">
                    <form asp-controller="Auth" asp-action="CreateStore" method="post">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title fw-bold text-dark" id="createStoreModalLabel">Create New Store</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;" for="newStoreName">Store Name</label>
                            <input type="text" id="newStoreName" name="StoreName" class="form-control px-3 py-2" placeholder="e.g. My New Store" required maxlength="100" autocomplete="off" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
                            <small class="text-muted">A new empty store will be created and you'll be switched into it as owner.</small>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="border-radius: 20px;">Cancel</button>
                            <button type="submit" class="btn btn-primary px-4" style="background-color: #4338ca; border: none; border-radius: 20px;">Create Store</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</body>
</html>
