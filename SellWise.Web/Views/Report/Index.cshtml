@{
    ViewData["Title"] = "Reports";
    var totalOrders = ViewData["TotalOrders"] ?? 0;
    var totalRevenue = Convert.ToDecimal(ViewData["TotalRevenue"] ?? 0m);
}

<div class="mb-4">
    <h2 class="fw-bold text-dark">Reports</h2>
</div>

<div class="card p-5 border-1 shadow-sm mx-auto" style="max-width: 800px; margin-top: 2rem;">
    <h2 class="fw-bold text-dark mb-2">Generate PDF Report</h2>
    <p class="text-muted mb-4">Download a comprehensive summary of your store's performance, including revenue, growth metrics, and top products.</p>

    <div class="p-4 bg-light rounded-3 mb-4" style="border: 1px solid var(--border-color);">
        <form method="post" action="#" onsubmit="alert('PDF Generation started! (Simulation)'); return false;">
            <div class="row align-items-end g-3">
                <div class="col-12 col-md-8">
                    <label class="form-label mb-2 d-flex align-items-center gap-2">
                        <span>📅</span> Reporting Period
                    </label>
                    <select class="form-select" style="background-color: #ffffff; border-color: #cbd5e1;">
                        <option value="30">Last 30 Days</option>
                        <option value="7">Last 7 Days</option>
                        <option value="90">Last 90 Days</option>
                        <option value="365">Last 365 Days</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2 py-2" style="background-color: #18181b; border: none; border-radius: var(--radius-md);">
                        <span>📥</span> Download PDF
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="text-muted small">
        <strong>Preview:</strong> This report will include <strong>@totalOrders</strong> orders totaling <strong>৳@totalRevenue.ToString("N0")</strong> in revenue for the selected period.
    </div>
</div>
