@model SellWise.Web.ViewModels.Report.ReportViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="mb-4">
    <h2 class="fw-bold text-dark">Reports</h2>
</div>

<div class="card p-5 border-1 shadow-sm mx-auto" style="max-width: 800px; margin-top: 2rem;">
    <h2 class="fw-bold text-dark mb-2">Generate PDF Report</h2>
    <p class="text-muted mb-4">Download a comprehensive summary of your store's performance, including revenue, growth metrics, and top products.</p>

    <div class="p-4 bg-light rounded-3 mb-4" style="border: 1px solid var(--border-color);">
        <form method="post" action="#">
            <div class="row align-items-end g-3">
                <div class="col-12 col-md-8">
                    <label class="form-label mb-2 d-flex align-items-center gap-2">
                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Reporting Period
                    </label>
                    <select class="form-select" style="background-color: #ffffff; border-color: #cbd5e1;">
                        <option value="30">Last 30 Days</option>
                        <option value="7">Last 7 Days</option>
                        <option value="90">Last 90 Days</option>
                        <option value="365">Last 365 Days</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2 py-2" style="background-color: #18181b; border: none; border-radius: var(--radius-md);">
                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download PDF
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="text-muted small">
        <strong>Preview:</strong> This report will include <strong>@Model.TotalOrders</strong> orders totaling <strong>৳@Model.TotalRevenue.ToString("N0")</strong> in revenue for the selected period.
    </div>
</div>
