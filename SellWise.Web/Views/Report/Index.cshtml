@model SellWise.Web.ViewModels.Report.ReportViewModel
@{
    ViewData["Title"] = "Reports";
    var isEmployee = string.Equals(ViewData["CurrentStoreRole"]?.ToString(), "employee", StringComparison.OrdinalIgnoreCase);
}

<div class="mb-4">
    <h2 class="fw-bold text-dark">Reports</h2>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="max-width: 800px; margin: 0 auto;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card p-3 p-md-5 border-1 shadow-sm mx-auto" style="max-width: 800px; margin-top: 2rem;">
    <h2 class="fw-bold text-dark mb-2">Generate PDF Report</h2>
    <p class="text-muted mb-4">Download a comprehensive summary of your store's performance, including revenue, growth metrics, and top products.</p>

    <div class="p-4 bg-light rounded-3 mb-4" style="border: 1px solid var(--border-color);">
        <form method="post" asp-action="ExportPdf">
            <div class="row align-items-end g-3">
                <div class="col-12 col-md-8">
                    <label class="form-label mb-2 d-flex align-items-center gap-2">
                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Reporting Period
                    </label>
                    <select class="form-select" name="days" style="background-color: #ffffff; border-color: #cbd5e1;">
                        <option value="30">Last 30 Days</option>
                        <option value="7">Last 7 Days</option>
                        <option value="90">Last 90 Days</option>
                        <option value="365">Last 365 Days</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    @if (!isEmployee)
                    {
                        <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            Download PDF
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary w-100 d-flex align-items-center justify-content-center gap-2 py-2" disabled title="Employees cannot generate PDF reports">
                            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            Download PDF
                        </button>
                    }
                </div>
            </div>
            @if (isEmployee)
            {
                <div class="alert alert-warning small mt-3 mb-0 py-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Employees are not permitted to generate or download PDF reports.
                </div>
            }
        </form>
    </div>

    <div class="text-muted small">
        <strong>Preview:</strong> This report will include <strong>@Model.TotalOrders</strong> orders totaling <strong>৳@Model.TotalRevenue.ToString("N0")</strong> in revenue for the selected period.
    </div>
</div>
