@model SellWise.Web.ViewModels.Settings.ProfileViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <h2 class="fw-bold text-dark mb-0">Settings</h2>
    <span class="text-muted mx-1">&rsaquo;</span>
    <span class="text-muted">Profile</span>
</div>
<p class="text-muted mb-0">Manage your account and store preferences.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert" style="max-width: 800px;">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert" style="max-width: 800px;">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Navigation Tabs -->
<ul class="nav nav-tabs mb-4 mt-4 flex-nowrap overflow-auto scroll-shadow" style="border-bottom: 1px solid #e2e8f0; white-space: nowrap;" id="settingsTabs">
    <li class="nav-item">
        <button class="nav-link active fw-bold px-4 py-2" data-target="#profile" type="button" style="color: #0f172a; background-color: #ffffff; border: 1px solid #e2e8f0; border-bottom: 1px solid #ffffff; border-radius: var(--radius-md) var(--radius-md) 0 0;">
            <span class="d-flex align-items-center gap-2">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Profile
            </span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link text-muted px-4 py-2 border-0 bg-transparent" data-target="#security" type="button">
            <span class="d-flex align-items-center gap-2">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Account Security
            </span>
        </button>
    </li>
    <li class="nav-item">
        <a class="nav-link text-muted px-4 py-2 border-0" asp-controller="Settings" asp-action="Staff">
            <span class="d-flex align-items-center gap-2">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Staff Management
            </span>
        </a>
    </li>
</ul>

<div id="tabContents">
<!-- Profile Card -->
<div class="card p-4 border-1 shadow-sm mb-4 tab-pane" style="max-width: 800px; display: block;" id="profile">
    <h5 class="fw-bold text-dark mb-1">Profile Information</h5>
    <p class="text-muted small mb-4">Your account details and store information.</p>
    
    <hr class="mb-4" style="border-color: #e2e8f0;">

    <form asp-controller="Settings" asp-action="UpdateProfile" method="post">
        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Email Address</label>
                <input type="email" class="form-control px-3 py-2 text-muted" value="@Model.Email" style="border-radius: var(--radius-md); border-color: #e2e8f0; background-color: #f1f5f9; cursor: not-allowed;" readonly>
                <small class="text-muted">Email cannot be changed here.</small>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Role</label>
                <div>
                    <span class="badge @(Model.Role?.ToLower() == "owner" ? "badge-champion" : "badge-potential") px-3 py-2" style="font-size: 0.85rem; border-radius: 50px;">
                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        @(string.IsNullOrEmpty(Model.Role) ? "Member" : char.ToUpper(Model.Role[0]) + Model.Role.Substring(1))
                    </span>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="StoreName" class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Store Name</label>
                <input asp-for="StoreName" type="text" class="form-control px-3 py-2" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
                <span asp-validation-for="StoreName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PreferredLang" class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Preferred Language</label>
                <select asp-for="PreferredLang" class="form-select px-3 py-2" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
                    <option value="en">English</option>
                    <option value="bn">Bengali</option>
                </select>
                <span asp-validation-for="PreferredLang" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-secondary px-4 py-2 d-flex align-items-center gap-2" style="background-color: #64748b; border: none; border-radius: 20px;">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Save Profile
            </button>
        </div>
    </form>
</div>

<!-- Account Security Card -->
<div class="card p-4 border-1 shadow-sm mb-4 tab-pane" style="max-width: 800px; display: none;" id="security">
    <h5 class="fw-bold text-dark mb-1">Account Security</h5>
    <p class="text-muted small mb-4">Update your password.</p>
    
    <hr class="mb-4" style="border-color: #e2e8f0;">

    <form asp-controller="Settings" asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label text-dark mb-2" style="font-size: 0.85rem;">Current Password</label>
            <input type="password" name="CurrentPassword" class="form-control px-3 py-2" placeholder="Enter current password" required style="border-radius: var(--radius-md); border-color: #e2e8f0;">
            <span class="text-danger field-validation-valid" data-valmsg-for="CurrentPassword" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3">
            <label class="form-label text-dark mb-2" style="font-size: 0.85rem;">New Password</label>
            <input type="password" name="NewPassword" class="form-control px-3 py-2" placeholder="Enter new password (min 8 characters)" required style="border-radius: var(--radius-md); border-color: #e2e8f0;">
            <span class="text-danger field-validation-valid" data-valmsg-for="NewPassword" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-4">
            <label class="form-label text-dark mb-2" style="font-size: 0.85rem;">Confirm New Password</label>
            <input type="password" name="ConfirmNewPassword" class="form-control px-3 py-2" placeholder="Confirm new password" required style="border-radius: var(--radius-md); border-color: #e2e8f0;">
            <span class="text-danger field-validation-valid" data-valmsg-for="ConfirmNewPassword" data-valmsg-replace="true"></span>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-secondary px-4 py-2 d-flex align-items-center gap-2" style="background-color: #64748b; border: none; border-radius: 20px;">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Change Password
            </button>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll("#settingsTabs button[data-target]");
            const panes = document.querySelectorAll("#tabContents .tab-pane");

            function activateTab(hash) {
                if (!hash) hash = "#profile";
                const targetBtn = Array.from(tabs).find(t => t.dataset.target === hash);
                if (!targetBtn) return;

                // Reset all
                tabs.forEach(t => {
                    t.classList.remove('active', 'fw-bold');
                    t.classList.add('text-muted', 'border-0', 'bg-transparent');
                    t.style.backgroundColor = 'transparent';
                    t.style.border = 'none';
                    t.style.borderBottom = 'none';
                    t.style.color = '';
                });

                panes.forEach(p => p.style.display = 'none');

                // Activate selected
                targetBtn.classList.add('active', 'fw-bold');
                targetBtn.classList.remove('text-muted', 'border-0', 'bg-transparent');
                targetBtn.style.color = '#0f172a';
                targetBtn.style.backgroundColor = '#ffffff';
                targetBtn.style.border = '1px solid #e2e8f0';
                targetBtn.style.borderBottom = '1px solid #ffffff';
                targetBtn.style.borderRadius = 'var(--radius-md) var(--radius-md) 0 0';

                const targetPane = document.querySelector(hash);
                if (targetPane) targetPane.style.display = 'block';
            }

            tabs.forEach(tab => {
                tab.addEventListener("click", function (e) {
                    e.preventDefault();
                    const hash = this.dataset.target;
                    window.history.pushState(null, null, hash);
                    activateTab(hash);
                });
            });

            // Read hash on load
            activateTab(window.location.hash);

            window.addEventListener('hashchange', () => {
                activateTab(window.location.hash);
            });
        });
    </script>
}
