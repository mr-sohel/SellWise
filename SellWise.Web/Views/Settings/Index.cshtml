@{
    ViewData["Title"] = Html.Raw("Settings <span class='text-muted mx-2'>›</span> Profile");
}

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">Settings</h2>
    <p class="text-muted mb-0">Manage your account and store preferences.</p>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-tabs mb-4" style="border-bottom: 1px solid #e2e8f0;">
    <li class="nav-item">
        <a class="nav-link active fw-bold px-4 py-2" href="#" style="color: #0f172a; background-color: #ffffff; border: 1px solid #e2e8f0; border-bottom: 1px solid #ffffff; border-radius: var(--radius-md) var(--radius-md) 0 0;">
            <span class="d-flex align-items-center gap-2">
                <span>👤</span> Profile
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-muted px-4 py-2 border-0" href="#">
            <span class="d-flex align-items-center gap-2">
                <span>👥</span> Staff Management
            </span>
        </a>
    </li>
</ul>

<!-- Account Security Card -->
<div class="card p-4 border-1 shadow-sm mb-4" style="max-width: 800px;">
    <h5 class="fw-bold text-dark mb-1">Account Security</h5>
    <p class="text-muted small mb-4">Update your email address and password.</p>
    
    <hr class="mb-4" style="border-color: #e2e8f0;">

    <form method="post" action="#" onsubmit="alert('Settings saved!'); return false;">
        
        <div class="mb-4">
            <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Email Address</label>
            <input type="email" class="form-control px-3 py-2" value="sohel@gmail.com" style="border-radius: var(--radius-md); border-color: #e2e8f0;" readonly>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Change Password</label>
        </div>
        
        <div class="mb-3">
            <label class="form-label text-dark mb-2" style="font-size: 0.85rem;">Current Password (Required)</label>
            <input type="password" class="form-control px-3 py-2" placeholder="••••••••" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
        </div>

        <div class="mb-4">
            <label class="form-label text-dark mb-2" style="font-size: 0.85rem;">New Password</label>
            <input type="password" class="form-control px-3 py-2" placeholder="Leave blank to keep current password" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-secondary px-4 py-2 d-flex align-items-center gap-2" style="background-color: #64748b; border: none; border-radius: 20px;">
                <span>💾</span> Save Changes
            </button>
        </div>
    </form>
</div>
