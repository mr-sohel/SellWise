@model SellWise.Web.ViewModels.Settings.ProfileViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <h2 class="fw-bold text-dark mb-0">Settings</h2>
    <span class="text-muted mx-1">&rsaquo;</span>
    <span class="text-muted">Profile</span>
</div>
<p class="text-muted mb-0">Manage your account and store preferences.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert" style="max-width: 800px;">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert" style="max-width: 800px;">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Navigation Tabs -->
<ul class="nav nav-tabs mb-4 mt-4 flex-nowrap overflow-auto scroll-shadow" style="border-bottom: 1px solid #e2e8f0; white-space: nowrap;" id="settingsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-4 py-2" data-target="#profile" type="button" role="tab" aria-selected="true" aria-controls="profile" id="tab-profile" style="color: #0f172a; background-color: #ffffff; border: 1px solid #e2e8f0; border-bottom: 1px solid #ffffff; border-radius: var(--radius-md) var(--radius-md) 0 0;">
            <span class="d-flex align-items-center gap-2">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Profile
            </span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link text-muted px-4 py-2 border-0 bg-transparent" data-target="#security" type="button" role="tab" aria-selected="false" aria-controls="security" id="tab-security">
            <span class="d-flex align-items-center gap-2">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Account Security
            </span>
        </button>
    </li>
    @if (string.Equals(Model.Role, "owner", StringComparison.OrdinalIgnoreCase))
    {
        <li class="nav-item">
            <a class="nav-link text-muted px-4 py-2 border-0" asp-controller="Settings" asp-action="Staff">
                <span class="d-flex align-items-center gap-2">
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Staff Management
                </span>
            </a>
        </li>
    }
</ul>

<div id="tabContents">
<!-- Profile Card -->
<div class="card p-4 border-1 shadow-sm mb-4 tab-pane" style="max-width: 800px; display: block;" id="profile" role="tabpanel" aria-labelledby="tab-profile">
    <h5 class="fw-bold text-dark mb-1">Profile Information</h5>
    <p class="text-muted small mb-4">Your account details and store information.</p>
    
    <hr class="mb-4" style="border-color: #e2e8f0;">

    <form asp-controller="Settings" asp-action="UpdateProfile" method="post">
        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;" for="settingsEmail">Email Address</label>
                <input type="email" id="settingsEmail" class="form-control px-3 py-2 text-muted" value="@Model.Email" style="border-radius: var(--radius-md); border-color: #e2e8f0; background-color: #f1f5f9; cursor: not-allowed;" readonly>
                <small class="text-muted">Email cannot be changed here.</small>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Role</label>
                <div>
                    <span class="badge @(Model.Role?.ToLower() == "owner" ? "badge-champion" : "badge-potential") px-3 py-2" style="font-size: 0.85rem; border-radius: 50px;">
                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        @(string.IsNullOrEmpty(Model.Role) ? "Member" : char.ToUpper(Model.Role[0]) + Model.Role.Substring(1))
                    </span>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="StoreName" class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Store Name</label>
                @if (string.Equals(Model.Role, "owner", StringComparison.OrdinalIgnoreCase))
                {
                    <input asp-for="StoreName" type="text" class="form-control px-3 py-2" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
                    <span asp-validation-for="StoreName" class="text-danger"></span>
                }
                else
                {
                    <input asp-for="StoreName" type="text" class="form-control px-3 py-2 text-muted" style="border-radius: var(--radius-md); border-color: #e2e8f0; background-color: #f1f5f9; cursor: not-allowed;" readonly>
                    <small class="text-muted">Only store owners can edit the store name.</small>
                }
            </div>
            <div class="col-md-6">
                <label asp-for="OwnerName" class="form-label fw-bold text-dark mb-2" style="font-size: 0.9rem;">Owner Name</label>
                <input asp-for="OwnerName" type="text" class="form-control px-3 py-2" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
                <span asp-validation-for="OwnerName" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-secondary px-4 py-2 d-flex align-items-center gap-2" style="background-color: #64748b; border: none; border-radius: 20px;">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Save Profile
            </button>
        </div>
    </form>

    @if (string.Equals(Model.Role, "owner", StringComparison.OrdinalIgnoreCase))
    {
        <hr class="my-4" style="border-color: #e2e8f0;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h6 class="fw-bold text-danger mb-1">Danger Zone</h6>
                <p class="text-muted small mb-0">Remove this store permanently. All products, orders, customers, and expenses will be deleted. This action cannot be undone.</p>
            </div>
            <button type="button" class="btn btn-outline-danger px-4 py-2" data-bs-toggle="modal" data-bs-target="#deleteStoreModal" style="border-radius: 20px;">Remove Store</button>
        </div>
    }
</div>

<!-- Account Security Card -->
<div class="card p-4 border-1 shadow-sm mb-4 tab-pane" style="max-width: 800px; display: none;" id="security" role="tabpanel" aria-labelledby="tab-security">
    <h5 class="fw-bold text-dark mb-1">Account Security</h5>
    <p class="text-muted small mb-4">Update your password.</p>
    
    <hr class="mb-4" style="border-color: #e2e8f0;">

    <form asp-controller="Settings" asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label text-dark mb-2" style="font-size: 0.85rem;" for="currentPassword">Current Password</label>
            <input type="password" name="CurrentPassword" id="currentPassword" class="form-control px-3 py-2" placeholder="Enter current password" required autocomplete="current-password" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
            <span class="text-danger field-validation-valid" data-valmsg-for="CurrentPassword" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-3">
            <label class="form-label text-dark mb-2" style="font-size: 0.85rem;" for="newPassword">New Password</label>
            <input type="password" name="NewPassword" id="newPassword" class="form-control px-3 py-2" placeholder="Enter new password (min 8 characters)" required minlength="8" autocomplete="new-password" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
            <span class="text-danger field-validation-valid" data-valmsg-for="NewPassword" data-valmsg-replace="true"></span>
        </div>

        <div class="mb-4">
            <label class="form-label text-dark mb-2" style="font-size: 0.85rem;" for="confirmNewPassword">Confirm New Password</label>
            <input type="password" name="ConfirmNewPassword" id="confirmNewPassword" class="form-control px-3 py-2" placeholder="Confirm new password" required autocomplete="new-password" style="border-radius: var(--radius-md); border-color: #e2e8f0;">
            <span class="text-danger field-validation-valid" data-valmsg-for="ConfirmNewPassword" data-valmsg-replace="true"></span>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-secondary px-4 py-2 d-flex align-items-center gap-2" style="background-color: #64748b; border: none; border-radius: 20px;">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Change Password
            </button>
        </div>
    </form>
</div>
</div>

<!-- Remove Store Modal -->
<div class="modal fade" id="deleteStoreModal" tabindex="-1" aria-labelledby="deleteStoreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--radius-lg);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger" id="deleteStoreModalLabel">Remove Store</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to remove <strong>@Model.StoreName</strong>? All products, orders, customers, and expenses associated with this store will be permanently deleted. This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="border-radius: 20px;">Cancel</button>
                <form asp-controller="Settings" asp-action="DeleteStore" method="post" class="m-0">
                    <button type="submit" class="btn btn-danger px-4" style="border-radius: 20px;">Yes, Remove Store</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll("#settingsTabs button[data-target]");
            const panes = document.querySelectorAll("#tabContents .tab-pane");

            function activateTab(hash) {
                if (!hash) hash = "#profile";
                const targetBtn = Array.from(tabs).find(t => t.dataset.target === hash);
                if (!targetBtn) return;

                // Reset all
                tabs.forEach(t => {
                    t.classList.remove('active', 'fw-bold');
                    t.classList.add('text-muted', 'border-0', 'bg-transparent');
                    t.style.backgroundColor = 'transparent';
                    t.style.border = 'none';
                    t.style.borderBottom = 'none';
                    t.style.color = '';
                    t.setAttribute('aria-selected', 'false');
                });

                panes.forEach(p => p.style.display = 'none');

                // Activate selected
                targetBtn.classList.add('active', 'fw-bold');
                targetBtn.classList.remove('text-muted', 'border-0', 'bg-transparent');
                targetBtn.style.color = '#0f172a';
                targetBtn.style.backgroundColor = '#ffffff';
                targetBtn.style.border = '1px solid #e2e8f0';
                targetBtn.style.borderBottom = '1px solid #ffffff';
                targetBtn.style.borderRadius = 'var(--radius-md) var(--radius-md) 0 0';
                targetBtn.setAttribute('aria-selected', 'true');

                const targetPane = document.querySelector(hash);
                if (targetPane) targetPane.style.display = 'block';
            }

            tabs.forEach(tab => {
                tab.addEventListener("click", function (e) {
                    e.preventDefault();
                    const hash = this.dataset.target;
                    window.history.pushState(null, null, hash);
                    activateTab(hash);
                });
            });

            // Read hash on load
            activateTab(window.location.hash);

            if (document.querySelector('#security .text-danger:not(.field-validation-valid)') || 
                document.querySelector('#security .validation-summary-errors')) {
                activateTab('#security');
            }

            window.addEventListener('hashchange', () => {
                activateTab(window.location.hash);
            });
        });
    </script>
}
