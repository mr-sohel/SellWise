@model SellWise.Web.ViewModels.Settings.ProfileViewModel
@{
    ViewData["Title"] = "Settings";
    var isOwner = string.Equals(Model.Role, "owner", StringComparison.OrdinalIgnoreCase);
    var roleLabel = string.IsNullOrEmpty(Model.Role) ? "Member" : char.ToUpper(Model.Role[0]) + Model.Role.Substring(1);
    var passwordHasErrors = !ViewData.ModelState.IsValid;
}

<partial name="_SettingsHeader" />

<div class="settings-stack">

    <!-- Profile -->
    <section class="card settings-card" aria-labelledby="profileHeading">
        <form asp-controller="Settings" asp-action="UpdateProfile" method="post">
            <div class="settings-card-head">
                <h2 class="h5 mb-1" id="profileHeading">Profile</h2>
                <p class="text-muted small mb-0">Your details and the store you are working in.</p>
            </div>

            <div class="settings-card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OwnerName" class="form-label">Your name</label>
                        <input asp-for="OwnerName" class="form-control" placeholder="e.g. Amina Rahman" autocomplete="name" />
                        <span asp-validation-for="OwnerName" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="settingsEmail">Email</label>
                        <input type="email" id="settingsEmail" class="form-control" value="@Model.Email" readonly />
                        <div class="form-text">The email you sign in with can't be changed here.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StoreName" class="form-label">Store name</label>
                        @if (isOwner)
                        {
                            <input asp-for="StoreName" class="form-control" />
                            <span asp-validation-for="StoreName" class="field-validation-error"></span>
                        }
                        else
                        {
                            <input asp-for="StoreName" class="form-control" readonly />
                            <div class="form-text">Only owners can rename the store.</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="settingsRole">Role</label>
                        <input type="text" id="settingsRole" class="form-control" value="@roleLabel" readonly />
                    </div>
                </div>
            </div>

            <div class="settings-card-foot">
                <button type="submit" class="btn btn-primary">Save profile</button>
            </div>
        </form>
    </section>

    <!-- Password -->
    <section class="card settings-card" id="password" aria-labelledby="passwordHeading">
        <form asp-controller="Settings" asp-action="ChangePassword" method="post">
            <div class="settings-card-head">
                <h2 class="h5 mb-1" id="passwordHeading">Password</h2>
                <p class="text-muted small mb-0">Use at least 8 characters. You stay signed in on this device.</p>
            </div>

            <div class="settings-card-body">
                <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="currentPassword">Current password</label>
                        <input type="password" name="CurrentPassword" id="currentPassword" class="form-control" required autocomplete="current-password" />
                        <span class="field-validation-valid" data-valmsg-for="CurrentPassword" data-valmsg-replace="true"></span>
                    </div>
                    <div class="w-100"></div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="newPassword">New password</label>
                        <input type="password" name="NewPassword" id="newPassword" class="form-control" required minlength="8" autocomplete="new-password" />
                        <span class="field-validation-valid" data-valmsg-for="NewPassword" data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="confirmNewPassword">Confirm new password</label>
                        <input type="password" name="ConfirmNewPassword" id="confirmNewPassword" class="form-control" required autocomplete="new-password" />
                        <span class="field-validation-valid" data-valmsg-for="ConfirmNewPassword" data-valmsg-replace="true"></span>
                    </div>
                </div>
            </div>

            <div class="settings-card-foot">
                <button type="submit" class="btn btn-primary">Change password</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (passwordHasErrors)
    {
        <script>
            // A failed password change re-renders the page; bring the form back into view.
            document.getElementById('password')?.scrollIntoView({ block: 'center' });
        </script>
    }
}
