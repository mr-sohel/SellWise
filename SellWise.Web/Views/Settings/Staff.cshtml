@model List<SellWise.Web.ViewModels.Settings.StaffMemberViewModel>
@{
    ViewData["Title"] = "Team";
}

<partial name="_SettingsHeader" />

<div class="row g-4 align-items-start">

    <!-- Members -->
    <div class="col-xl-8">
        <section class="card settings-card" aria-labelledby="membersHeading">
            <div class="settings-card-head d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h2 class="h5 mb-1" id="membersHeading">Team members</h2>
                    <p class="text-muted small mb-0">People who can sign in to this store.</p>
                </div>
                <span class="text-muted small text-nowrap pt-1">@Model.Count @(Model.Count == 1 ? "member" : "members")</span>
            </div>

            @if (!Model.Any())
            {
                <div class="settings-card-body text-center text-muted">No team members yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col" class="d-none d-sm-table-cell">Role</th>
                                <th scope="col" class="d-none d-md-table-cell">Joined</th>
                                <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model)
                            {
                                var parts = (member.FullName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                var initials = parts.Length == 0 ? "?"
                                    : (parts.Length > 1 ? parts[0][..1] + parts[1][..1]
                                    : parts[0].Length > 1 ? parts[0][..2] : parts[0]).ToUpperInvariant();
                                var memberIsOwner = member.Role == SellWise.Web.Authorization.StoreRoles.Owner;
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3 min-w-0">
                                            <span class="avatar flex-shrink-0" aria-hidden="true">@initials</span>
                                            <div class="min-w-0">
                                                <div class="fw-semibold text-dark text-truncate" title="@member.FullName">@member.FullName</div>
                                                <div class="text-muted small text-truncate" title="@member.Email">@member.Email</div>
                                                <span class="role-chip d-sm-none mt-1 @(memberIsOwner ? "is-owner" : "")">@(memberIsOwner ? "Owner" : "Staff")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="d-none d-sm-table-cell"><span class="role-chip @(memberIsOwner ? "is-owner" : "")">@(memberIsOwner ? "Owner" : "Staff")</span></td>
                                    <td class="text-muted text-nowrap d-none d-md-table-cell">@member.JoinedAt.ToString("d MMM yyyy")</td>
                                    <td class="text-end">
                                        @if (!memberIsOwner)
                                        {
                                            <form asp-controller="Settings" asp-action="RemoveStaff" method="post" class="d-inline m-0"
                                                  onsubmit="return confirm('Remove @member.FullName from this store?');">
                                                <input type="hidden" name="userId" value="@member.UserId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <!-- Add staff -->
    <div class="col-xl-4">
        <section class="card settings-card" aria-labelledby="addHeading">
            <form asp-controller="Settings" asp-action="AddStaff" method="post">
                <div class="settings-card-head">
                    <h2 class="h5 mb-1" id="addHeading">Add a staff member</h2>
                    <p class="text-muted small mb-0">Staff can use the POS, orders and customers.</p>
                </div>

                <div class="settings-card-body">
                    <div class="mb-3">
                        <label class="form-label" for="staffName">Full name</label>
                        <input type="text" id="staffName" name="FullName" class="form-control" placeholder="e.g. Rahim Uddin" required autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="staffEmail">Email</label>
                        <input type="email" id="staffEmail" name="Email" class="form-control" placeholder="rahim@example.com" required autocomplete="off" />
                    </div>
                    <div>
                        <label class="form-label" for="staffPassword">Password</label>
                        <input type="password" id="staffPassword" name="Password" class="form-control" minlength="8" autocomplete="new-password" />
                        <div class="form-text">Needed for new accounts only. If the email already has an account, its password is kept.</div>
                    </div>
                </div>

                <div class="settings-card-foot">
                    <button type="submit" class="btn btn-primary">Add staff member</button>
                </div>
            </form>
        </section>
    </div>
</div>
