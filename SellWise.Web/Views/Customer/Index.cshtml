@model IEnumerable<SellWise.Web.ViewModels.Customer.CustomerViewModel>
@{
    ViewData["Title"] = "Customers";
    int currentPage = (int)ViewData["CurrentPage"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
    var searchVal  = ViewData["Search"]?.ToString();
    var segmentVal = ViewData["Segment"]?.ToString();
    var sortVal    = ViewData["Sort"]?.ToString();
    var totalItems = (int)(ViewData["TotalItems"] ?? 0);
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <h2 class="fw-bold text-dark mb-0">Customers</h2>
    <form asp-action="RecalculateRfm" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-primary d-flex align-items-center gap-2">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
            Update RFM
        </button>
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-1 shadow-sm p-3 mb-4">
    <form method="get" class="d-flex flex-column flex-sm-row gap-3">
        <div class="search-widget" style="width: 100%; max-width: 400px;">
            <svg aria-hidden="true" class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" value="@searchVal" aria-label="Search customers" placeholder="Search by name, phone or email…">
        </div>
        <select class="form-select" name="segment" style="width: 100%; max-width: 200px;" onchange="this.form.submit();">
            <option value="">All Segments</option>
            <option value="CHAMPION" selected="@(segmentVal == "CHAMPION")">Champion</option>
            <option value="LOYAL" selected="@(segmentVal == "LOYAL")">Loyal</option>
            <option value="POTENTIAL_LOYALIST" selected="@(segmentVal == "POTENTIAL_LOYALIST")">Potential Loyalist</option>
            <option value="NEW_CUSTOMER" selected="@(segmentVal == "NEW_CUSTOMER")">New Customer</option>
            <option value="AT_RISK" selected="@(segmentVal == "AT_RISK")">At Risk</option>
            <option value="CANT_LOSE_THEM" selected="@(segmentVal == "CANT_LOSE_THEM")">Can't Lose Them</option>
            <option value="NEED_ATTENTION" selected="@(segmentVal == "NEED_ATTENTION")">Need Attention</option>
            <option value="LOST" selected="@(segmentVal == "LOST")">Lost</option>
        </select>
        <div class="dropdown">
            <button class="sort-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5h10M11 9h7M11 13h4M3 17l3 3 3-3M6 18V4"/></svg>
                <span id="sortLabel">@(sortVal switch {
                    "name_asc" => "Name A-Z",
                    "name_desc" => "Name Z-A",
                    "spent_desc" => "Highest Spent",
                    "spent_asc" => "Lowest Spent",
                    "orders_desc" => "Most Orders",
                    "orders_asc" => "Fewest Orders",
                    "rfm_desc" => "Best RFM Score",
                    "rfm_asc" => "Worst RFM Score",
                    "recent_desc" => "Most Recent",
                    "recent_asc" => "Least Recent",
                    _ => "Newest First"
                })</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow sort-dropdown-menu">
                <li><span class="dropdown-header">Name</span></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "name_asc" ? "active" : "")" onclick="setSort('name_asc')">Name A-Z</button></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "name_desc" ? "active" : "")" onclick="setSort('name_desc')">Name Z-A</button></li>
                <li><hr class="dropdown-divider"></li>
                <li><span class="dropdown-header">Total Spent</span></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "spent_desc" ? "active" : "")" onclick="setSort('spent_desc')">Highest Spent</button></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "spent_asc" ? "active" : "")" onclick="setSort('spent_asc')">Lowest Spent</button></li>
                <li><hr class="dropdown-divider"></li>
                <li><span class="dropdown-header">Orders</span></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "orders_desc" ? "active" : "")" onclick="setSort('orders_desc')">Most Orders</button></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "orders_asc" ? "active" : "")" onclick="setSort('orders_asc')">Fewest Orders</button></li>
                <li><hr class="dropdown-divider"></li>
                <li><span class="dropdown-header">RFM Score</span></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "rfm_desc" ? "active" : "")" onclick="setSort('rfm_desc')">Best RFM Score</button></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "rfm_asc" ? "active" : "")" onclick="setSort('rfm_asc')">Worst RFM Score</button></li>
                <li><hr class="dropdown-divider"></li>
                <li><span class="dropdown-header">Last Order</span></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "recent_desc" ? "active" : "")" onclick="setSort('recent_desc')">Most Recent</button></li>
                <li><button type="button" class="dropdown-item sort-item @(sortVal == "recent_asc" ? "active" : "")" onclick="setSort('recent_asc')">Least Recent</button></li>
            </ul>
        </div>
        <input type="hidden" name="sort" id="sortInput" value="@sortVal" />
        <button type="submit" class="btn btn-primary d-none">Search</button>
    </form>
</div>

<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="customerTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 25%;">Name</th>
                    <th style="width: 25%;">Contact</th>
                    <th style="width: 15%;">Orders</th>
                    <th style="width: 15%;">Segment (RFM)</th>
                    <th style="width: 12%;">Total Spent</th>
                    <th style="width: 8%;" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold text-dark">@c.Name</td>
                        <td class="align-middle">
                            <div class="text-dark fw-medium">@c.Phone</div>
                            <div class="text-muted" style="font-size: 0.75rem;">@c.Email</div>
                        </td>
                        <td class="align-middle">@c.TotalOrders</td>
                        <td class="align-middle">
                            <span class="badge @c.SegmentClass d-inline-block mb-1">@c.Segment</span>
                            <div class="text-muted" style="font-size: 0.7rem;">@c.RfmText</div>
                        </td>
                        <td class="align-middle fw-bold text-dark">৳@c.TotalSpent.ToString("N0")</td>
                        <td class="align-middle text-end">
                            <div class="d-flex align-items-center justify-content-end">
                                <div class="dropdown">
                                    <button class="order-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions" aria-label="Actions for customer @c.Name">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li>
                                            <a asp-action="Edit" asp-route-id="@c.Id" class="dropdown-item d-flex align-items-center gap-2">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                                Edit
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No customers found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pagination-wrap">
    <div>Showing <strong>@Model.Count()</strong> of <strong>@totalItems</strong> customers</div>
    <div class="d-flex gap-2">
        @if (currentPage > 1)
        {
            <a href="?page=@(currentPage - 1)&search=@Uri.EscapeDataString(searchVal ?? "")&segment=@Uri.EscapeDataString(segmentVal ?? "")&sort=@Uri.EscapeDataString(sortVal ?? "")" class="pagination-btn">Previous</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Previous</span>
        }

        @if (currentPage < totalPages)
        {
            <a href="?page=@(currentPage + 1)&search=@Uri.EscapeDataString(searchVal ?? "")&segment=@Uri.EscapeDataString(segmentVal ?? "")&sort=@Uri.EscapeDataString(sortVal ?? "")" class="pagination-btn">Next</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Next</span>
        }
    </div>
</div>

@section Scripts {
<script>
function setSort(val) {
    document.getElementById('sortInput').value = val;
    document.querySelector('form[method="get"]').submit();
}
</script>
}
