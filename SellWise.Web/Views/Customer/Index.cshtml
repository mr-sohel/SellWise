@model IEnumerable<SellWise.Web.ViewModels.Customer.CustomerViewModel>
@{
    ViewData["Title"] = "Customers";
    var customerCount = Model.Count();
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <h2 class="fw-bold text-dark mb-0">Customers</h2>
    <form asp-action="RecalculateRfm" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-primary d-flex align-items-center gap-2">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
            Recalculate RFM
        </button>
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="card border-1 shadow-sm p-3 mb-4">
    <form method="get" class="d-flex flex-column flex-sm-row gap-3">
        <div class="search-widget" style="width: 100%; max-width: 400px;">
            <svg aria-hidden="true" class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" value="@ViewData["Search"]" aria-label="Search" placeholder="Search by name, phone or email...">
        </div>
        <select class="form-select" name="segment" style="width: 100%; max-width: 200px; background-color: #ffffff; border-color: #cbd5e1;" onchange="this.form.submit();">
            <option value="">All Segments</option>
            <option value="CHAMPION" selected="@((ViewData["Segment"]?.ToString() == "CHAMPION") ? "selected" : null)">Champion</option>
            <option value="LOYAL" selected="@((ViewData["Segment"]?.ToString() == "LOYAL") ? "selected" : null)">Loyal</option>
            <option value="POTENTIAL_LOYALIST" selected="@((ViewData["Segment"]?.ToString() == "POTENTIAL_LOYALIST") ? "selected" : null)">Potential Loyalist</option>
            <option value="NEW_CUSTOMER" selected="@((ViewData["Segment"]?.ToString() == "NEW_CUSTOMER") ? "selected" : null)">New Customer</option>
            <option value="AT_RISK" selected="@((ViewData["Segment"]?.ToString() == "AT_RISK") ? "selected" : null)">At Risk</option>
            <option value="CANT_LOSE_THEM" selected="@((ViewData["Segment"]?.ToString() == "CANT_LOSE_THEM") ? "selected" : null)">Can't Lose Them</option>
            <option value="NEED_ATTENTION" selected="@((ViewData["Segment"]?.ToString() == "NEED_ATTENTION") ? "selected" : null)">Need Attention</option>
            <option value="LOST" selected="@((ViewData["Segment"]?.ToString() == "LOST") ? "selected" : null)">Lost</option>
        </select>
        <select class="form-select" name="sort" style="width: 100%; max-width: 200px; background-color: #ffffff; border-color: #cbd5e1;" onchange="this.form.submit();">
            <option value="">Sort: Newest First</option>
            <optgroup label="Name">
                <option value="name_asc" selected="@((ViewData["Sort"]?.ToString() == "name_asc") ? "selected" : null)">Name A-Z</option>
                <option value="name_desc" selected="@((ViewData["Sort"]?.ToString() == "name_desc") ? "selected" : null)">Name Z-A</option>
            </optgroup>
            <optgroup label="Total Spent">
                <option value="spent_desc" selected="@((ViewData["Sort"]?.ToString() == "spent_desc") ? "selected" : null)">Highest Spent</option>
                <option value="spent_asc" selected="@((ViewData["Sort"]?.ToString() == "spent_asc") ? "selected" : null)">Lowest Spent</option>
            </optgroup>
            <optgroup label="Orders">
                <option value="orders_desc" selected="@((ViewData["Sort"]?.ToString() == "orders_desc") ? "selected" : null)">Most Orders</option>
                <option value="orders_asc" selected="@((ViewData["Sort"]?.ToString() == "orders_asc") ? "selected" : null)">Fewest Orders</option>
            </optgroup>
            <optgroup label="RFM Score">
                <option value="rfm_desc" selected="@((ViewData["Sort"]?.ToString() == "rfm_desc") ? "selected" : null)">Best RFM Score</option>
                <option value="rfm_asc" selected="@((ViewData["Sort"]?.ToString() == "rfm_asc") ? "selected" : null)">Worst RFM Score</option>
            </optgroup>
            <optgroup label="Last Order">
                <option value="recent_desc" selected="@((ViewData["Sort"]?.ToString() == "recent_desc") ? "selected" : null)">Most Recent</option>
                <option value="recent_asc" selected="@((ViewData["Sort"]?.ToString() == "recent_asc") ? "selected" : null)">Least Recent</option>
            </optgroup>
        </select>
        <button type="submit" class="btn btn-primary d-none">Search</button>
    </form>
</div>

<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="customerTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 25%;">Name</th>
                    <th style="width: 25%;">Contact</th>
                    <th style="width: 15%;">Orders</th>
                    <th style="width: 15%;">Segment (RFM)</th>
                    <th style="width: 12%;">Total Spent</th>
                    <th style="width: 8%;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold text-dark">@c.Name</td>
                        <td class="align-middle">
                            <div class="text-dark fw-medium">@c.Phone</div>
                            <div class="text-muted" style="font-size: 0.75rem;">@c.Email</div>
                        </td>
                        <td class="align-middle">@c.TotalOrders</td>
                        <td class="align-middle">
                            <span class="badge @c.SegmentClass d-inline-block mb-1">@c.Segment</span>
                            <div class="text-muted" style="font-size: 0.7rem;">@c.RfmText</div>
                        </td>
                        <td class="align-middle fw-bold text-dark">৳@c.TotalSpent.ToString("N0")</td>
                        <td class="align-middle text-end">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm d-inline-flex align-items-center gap-1" style="color: #4338ca; background-color: #eef2ff; border: none; font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.6rem;" title="Edit">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                Edit
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No customers found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pagination-wrap">
    <div>Showing <strong>@Model.Count()</strong> of <strong>@ViewData["TotalItems"]</strong> results</div>
    <div class="d-flex gap-2">
        @{
            int currentPage = (int)ViewData["CurrentPage"]!;
            int totalPages = (int)ViewData["TotalPages"]!;
            var search = ViewData["Search"]?.ToString();
            var segment = ViewData["Segment"]?.ToString();
            var sort = ViewData["Sort"]?.ToString();
        }
        @if (currentPage > 1)
        {
            <a href="?page=@(currentPage - 1)&search=@(search != null ? Uri.EscapeDataString(search) : "")&segment=@(segment != null ? Uri.EscapeDataString(segment) : "")&sort=@(sort != null ? Uri.EscapeDataString(sort) : "")" class="pagination-btn">Previous</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Previous</span>
        }

        @if (currentPage < totalPages)
        {
            <a href="?page=@(currentPage + 1)&search=@(search != null ? Uri.EscapeDataString(search) : "")&segment=@(segment != null ? Uri.EscapeDataString(segment) : "")&sort=@(sort != null ? Uri.EscapeDataString(sort) : "")" class="pagination-btn">Next</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Next</span>
        }
    </div>
</div>

@section Scripts {
}
