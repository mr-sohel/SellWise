@model IEnumerable<SellWise.Web.ViewModels.Expense.ExpenseViewModel>
@{
    ViewData["Title"] = "Expenses";
    var expenseCount = Model.Count();
    var isEmployee = string.Equals(ViewData["CurrentStoreRole"]?.ToString(), "employee", StringComparison.OrdinalIgnoreCase);
}

<style>
@@media print {
    .d-print-none, .d-print-none * { display: none !important; }
    body { background: #fff; }
    .sidebar, .top-nav, .app-footer { display: none !important; }
    .main-content { margin: 0 !important; padding: 0 !important; width: 100% !important; }
    .page-container { padding: 1rem 0 !important; max-width: 100% !important; }
    .card { border: 1px solid #ddd !important; box-shadow: none !important; }
    table { font-size: .8rem; }
    th, td { padding: .4rem .6rem !important; }
}
</style>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3 d-print-none">
    <h2 class="fw-bold text-dark mb-0">Expenses</h2>
    <div style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center;">
        <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2" onclick="window.print()" title="Print list">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Print
        </button>
        @if (!isEmployee)
        {
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Expense
            </button>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 d-print-none mb-3"
         role="alert" style="border-radius:var(--radius-md); font-size:.875rem; border:1px solid #a7f3d0;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 d-print-none mb-3"
         role="alert" style="border-radius:var(--radius-md); font-size:.875rem;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-1 shadow-sm p-3 mb-4 d-print-none">
    <div class="btn-group-timeframe" style="background-color: #f1f5f9; border: 1px solid var(--border-color); padding: 0.25rem; border-radius: var(--radius-md);">
        <a href="?days=7" class="btn-timeframe @((ViewData["Days"]?.ToString() == "7") ? "active" : "")">7 Days</a>
        <a href="?days=15" class="btn-timeframe @((ViewData["Days"]?.ToString() == "15") ? "active" : "")">15 Days</a>
        <a href="?days=30" class="btn-timeframe @((ViewData["Days"]?.ToString() == "30") ? "active" : "")">30 Days</a>
        <a href="?days=0" class="btn-timeframe @((ViewData["Days"]?.ToString() == "0" || string.IsNullOrEmpty(ViewData["Days"]?.ToString())) ? "active" : "")">All Time</a>
    </div>
</div>

<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="expenseTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 25%;">Date</th>
                    <th style="width: 25%;">Category</th>
                    <th style="width: 35%;">Notes</th>
                    <th style="width: 15%;">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr data-date="@e.ExpenseDate.ToString("yyyy-MM-dd")">
                        <td class="align-middle text-muted">@e.ExpenseDate.ToString("M/d/yyyy")</td>
                        <td class="align-middle fw-bold text-dark">@e.Category</td>
                        <td class="align-middle text-muted">@e.Notes</td>
                        <td class="align-middle fw-bold text-dark">৳@e.Amount.ToString("N0")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-5">No expenses found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pagination-wrap d-print-none">
    <div>Showing <strong>@Model.Count()</strong> of <strong>@ViewData["TotalItems"]</strong> results</div>
    <div class="d-flex gap-2">
        @{
            int currentPage = (int)ViewData["CurrentPage"]!;
            int totalPages = (int)ViewData["TotalPages"]!;
            var days = ViewData["Days"]?.ToString();
        }
        @if (currentPage > 1)
        {
            <a href="?page=@(currentPage - 1)&days=@days" class="pagination-btn">Previous</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Previous</span>
        }

        @if (currentPage < totalPages)
        {
            <a href="?page=@(currentPage + 1)&days=@days" class="pagination-btn">Next</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Next</span>
        }
    </div>
</div>

@if (!isEmployee)
{
    <!-- Add Expense Modal -->
    <div class="modal fade d-print-none" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: var(--radius-lg); border: none; overflow: hidden; box-shadow: var(--shadow-lg);">
                <div class="modal-header bg-light border-bottom p-4">
                    <h5 class="modal-title fw-bold text-dark" id="addExpenseModalLabel">Add New Expense</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Create" method="post">
                    <div class="modal-body p-4">
                        @{
                            var newExpense = ViewData["NewExpense"] as SellWise.Web.ViewModels.Expense.ExpenseCreateViewModel;
                        }
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label class="form-label" for="expenseCategory">Category</label>
                            <select name="Category" id="expenseCategory" class="form-select" required>
                                <option value="Rent" selected="@(newExpense?.Category == "Rent")">Rent</option>
                                <option value="Salary" selected="@(newExpense?.Category == "Salary")">Salary</option>
                                <option value="Utilities" selected="@(newExpense?.Category == "Utilities")">Utilities</option>
                                <option value="Marketing" selected="@(newExpense?.Category == "Marketing")">Marketing</option>
                                <option value="Packaging" selected="@(newExpense?.Category == "Packaging")">Packaging</option>
                                <option value="Supplies" selected="@(newExpense?.Category == "Supplies")">Supplies</option>
                                <option value="Other" selected="@(newExpense?.Category == "Other")">Other</option>
                            </select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="Category" data-valmsg-replace="true"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="expenseAmount">Amount (৳)</label>
                            <input type="number" name="Amount" id="expenseAmount" class="form-control" placeholder="e.g. 5000" min="1" value="@(newExpense?.Amount)" required />
                            <span class="text-danger field-validation-valid" data-valmsg-for="Amount" data-valmsg-replace="true"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="expenseDate">Expense Date</label>
                            <input type="date" name="ExpenseDate" id="expenseDate" class="form-control" value="@(newExpense?.ExpenseDate.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" required />
                            <span class="text-danger field-validation-valid" data-valmsg-for="ExpenseDate" data-valmsg-replace="true"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="expenseNotes">Notes</label>
                            <textarea name="Notes" id="expenseNotes" class="form-control" rows="3" placeholder="Describe the expense details…">@(newExpense?.Notes)</textarea>
                            <span class="text-danger field-validation-valid" data-valmsg-for="Notes" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top p-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Expense</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (ViewData["ShowExpenseModal"] != null && ((bool?)ViewData["ShowExpenseModal"] ?? false))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var myModal = new bootstrap.Modal(document.getElementById('addExpenseModal'));
                myModal.show();
            });
        </script>
    }
}
