@model SellWise.Web.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="d-flex flex-column align-items-center" style="width: 100%; max-width: 440px;">
    <div class="text-center mb-4">
        <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
            <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="24" height="24" rx="6" fill="#4338ca"/>
                <path d="M12 5L5 9L12 13L19 9L12 5Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M5 9V15L12 19L19 15V9" stroke="white" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 13V19" stroke="white" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h1 class="fw-bold mb-0 text-brand" style="font-size: 2rem; letter-spacing: -1px;">SellWise</h1>
        </div>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">AI-powered sales analytics for your store</p>
    </div>

    <div class="auth-card">
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label mb-2">Email</label>
                <input asp-for="Email" class="form-control py-2" placeholder="you@example.com" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Password" class="form-label mb-2">Password</label>
                <div class="position-relative">
                    <input asp-for="Password" class="form-control py-2 pe-5" placeholder="Enter your password" autocomplete="current-password" aria-required="true" />
                    <button type="button" class="btn password-toggle position-absolute top-50 end-0 translate-middle-y me-2 p-0 border-0 bg-transparent" onclick="togglePassword(this)" aria-label="Show password">
                        <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="eye-closed d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
            
            <button type="submit" class="btn-dark-pill">Sign In</button>
        </form>
    </div>
    
    <div class="text-center mt-4" style="font-size: 0.9rem;">
        <span class="text-muted">Don't have an account?</span> <a asp-action="Signup" class="text-decoration-none fw-bold text-brand">Sign Up</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
