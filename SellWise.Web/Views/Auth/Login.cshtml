@model SellWise.Web.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="auth-form-wrap">
    <h1 class="auth-title">Sign in</h1>
    <p class="auth-sub">Enter your email and password.</p>

    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="username" aria-required="true" autofocus />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="position-relative">
                <input asp-for="Password" class="form-control pe-5" placeholder="Your password" autocomplete="current-password" aria-required="true" />
                <button type="button" class="btn password-toggle position-absolute top-50 end-0 translate-middle-y me-2 p-1 border-0 bg-transparent" onclick="togglePassword(this)" aria-label="Show password">
                    <svg class="eye-open" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-closed d-none" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn-dark-pill">Sign in</button>
    </form>

    <p class="auth-switch">New to SellWise? <a asp-action="Signup">Create your store</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
