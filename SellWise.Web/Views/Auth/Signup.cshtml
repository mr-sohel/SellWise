@model SellWise.Web.ViewModels.Auth.SignupViewModel

@{
    ViewData["Title"] = "Sign Up";
    Layout = "_AuthLayout";
}

<div class="d-flex flex-column align-items-center" style="width: 100%; max-width: 440px;">
    <div class="text-center mb-4">
        <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
            <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="24" height="24" rx="6" fill="#4338ca"/>
                <path d="M12 5L5 9L12 13L19 9L12 5Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M5 9V15L12 19L19 15V9" stroke="white" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 13V19" stroke="white" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h1 class="fw-bold mb-0 text-primary" style="font-size: 2rem; letter-spacing: -1px;">SellWise</h1>
        </div>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Create your account to get started.</p>
    </div>

    <div class="auth-card" style="width: 100%;">
        <form asp-action="Signup" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="StoreName" class="form-label text-bold mb-2">Store Name</label>
                <input asp-for="StoreName" class="form-control py-2" placeholder="e.g. My Demo Store" required style="background-color: #ffffff; border-color: #e5e7eb;" />
                <span asp-validation-for="StoreName" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OwnerName" class="form-label text-bold mb-2">Owner Name</label>
                <input asp-for="OwnerName" class="form-control py-2" placeholder="e.g. John Doe" autocomplete="name" aria-required="true" required style="background-color: #ffffff; border-color: #e5e7eb;" />
                <span asp-validation-for="OwnerName" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-bold mb-2">Email</label>
                <input asp-for="Email" class="form-control py-2" placeholder="you@example.com" autocomplete="username" aria-required="true" style="background-color: #ffffff; border-color: #e5e7eb;" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Password" class="form-label text-bold mb-2">Password</label>
                <div class="position-relative">
                    <input asp-for="Password" class="form-control py-2 pe-5" placeholder="••••••••" autocomplete="new-password" aria-required="true" style="background-color: #ffffff; border-color: #e5e7eb;" />
                    <button type="button" class="btn password-toggle position-absolute top-50 end-0 translate-middle-y me-2 p-0 border-0 bg-transparent" onclick="togglePassword(this)" aria-label="Show password">
                        <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="eye-closed d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label text-bold mb-2">Confirm Password</label>
                <div class="position-relative">
                    <input asp-for="ConfirmPassword" class="form-control py-2 pe-5" placeholder="••••••••" autocomplete="new-password" aria-required="true" style="background-color: #ffffff; border-color: #e5e7eb;" />
                    <button type="button" class="btn password-toggle position-absolute top-50 end-0 translate-middle-y me-2 p-0 border-0 bg-transparent" onclick="togglePassword(this)" aria-label="Show password">
                        <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="eye-closed d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>
            
            
            <button type="submit" class="btn-dark-pill w-100">Sign Up</button>
        </form>
    </div>
    
    <div class="text-center mt-4" style="font-size: 0.9rem;">
        <span class="text-muted">Already have an account?</span> <a asp-action="Login" class="text-decoration-none fw-bold" style="color: #2563eb;">Sign In</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(btn) {
            var input = btn.closest('.position-relative').querySelector('input');
            var eyeOpen = btn.querySelector('.eye-open');
            var eyeClosed = btn.querySelector('.eye-closed');
            if (input.type === 'password') {
                input.type = 'text';
                eyeOpen.classList.add('d-none');
                eyeClosed.classList.remove('d-none');
                btn.setAttribute('aria-label', 'Hide password');
            } else {
                input.type = 'password';
                eyeOpen.classList.remove('d-none');
                eyeClosed.classList.add('d-none');
                btn.setAttribute('aria-label', 'Show password');
            }
        }
    </script>
}
