@model IEnumerable<SellWise.Web.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary">Add Product</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>SKU</th>
                    <th>Stock</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold">@p.Name</td>
                        <td class="align-middle">@p.Category</td>
                        <td class="align-middle">@p.Sku</td>
                        <td class="align-middle">
                            <span class="badge @(p.StockQuantity <= p.LowStockThreshold ? "bg-danger" : "bg-success")">
                                @p.StockQuantity @p.Unit
                            </span>
                        </td>
                        <td class="align-middle">৳@p.SellingPrice.ToString("N0")</td>
                        <td class="align-middle">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="6" class="text-center text-muted py-4">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
