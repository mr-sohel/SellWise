@model IEnumerable<SellWise.Web.ViewModels.Product.ProductViewModel>
@{
    ViewData["Title"] = "Products";
    var productCount = Model.Count();
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <h2 class="fw-bold text-dark mb-0">Products</h2>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#bulkImportModal">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Bulk Import
        </button>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2" style="background-color: #18181b; border: none;">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Product
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-1 shadow-sm p-3 mb-4">
    <form method="get" class="search-widget" style="width: 100%; max-width: 400px;">
        <svg aria-hidden="true" class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" name="search" value="@ViewData["Search"]" aria-label="Search" placeholder="Search products...">
        <button type="submit" class="btn btn-primary d-none">Search</button>
    </form>
</div>

<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="productTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 40%;">Name</th>
                    <th style="width: 20%;">Sku</th>
                    <th style="width: 20%;">Price</th>
                    <th style="width: 15%;">Stock</th>
                    <th style="width: 10%;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var isLowStock = p.StockQuantity <= p.LowStockThreshold;
                    <tr class="@(isLowStock ? "table-danger opacity-75" : "")">
                        <td class="align-middle fw-bold text-dark">
                            @p.Name
                            @if(isLowStock)
                            {
                                <span class="badge bg-danger ms-2">Low Stock</span>
                            }
                        </td>
                        <td class="align-middle text-muted">@p.Sku</td>
                        <td class="align-middle fw-bold text-dark">৳@p.SellingPrice.ToString("N0")</td>
                        <td class="align-middle">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="text-decoration-none fw-bold" style="color: #2563eb;">
                                @p.StockQuantity @p.Unit
                            </a>
                        </td>
                        <td class="align-middle text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm d-inline-flex align-items-center gap-1" style="color: #4338ca; background-color: #eef2ff; border: none; font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.6rem;" title="Edit">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                    Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" class="m-0 p-0">
                                    <button type="submit" class="btn btn-sm d-inline-flex align-items-center gap-1" style="color: #dc2626; background-color: #fef2f2; border: none; font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.6rem;" title="Delete">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pagination-wrap">
    <div>Showing <strong>@Model.Count()</strong> of <strong>@ViewData["TotalItems"]</strong> results</div>
    <div class="d-flex gap-2">
        @{
            int currentPage = (int)ViewData["CurrentPage"]!;
            int totalPages = (int)ViewData["TotalPages"]!;
            var search = ViewData["Search"]?.ToString();
        }
        @if (currentPage > 1)
        {
            <a href="?page=@(currentPage - 1)&search=@(search != null ? Uri.EscapeDataString(search) : "")" class="pagination-btn">Previous</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Previous</span>
        }

        @if (currentPage < totalPages)
        {
            <a href="?page=@(currentPage + 1)&search=@(search != null ? Uri.EscapeDataString(search) : "")" class="pagination-btn">Next</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Next</span>
        }
    </div>
</div>

<div class="modal fade" id="bulkImportModal" tabindex="-1" aria-labelledby="bulkImportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="BulkImport" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="bulkImportModalLabel">Bulk Import Products</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Upload a CSV file containing product information. The CSV should have headers: Name, Sku, Category, CostPrice, SellingPrice, StockQuantity, LowStockThreshold, Unit.</p>
                    <div class="mb-3">
                        <label for="csvFile" class="form-label fw-bold">Select CSV File</label>
                        <input type="file" class="form-control" id="csvFile" name="file" accept=".csv" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background-color: #18181b; border: none;">Import Products</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
}
