@model IEnumerable<SellWise.Web.Models.Product>
@{
    ViewData["Title"] = "Products";
    var productCount = Model.Count();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">Products</h2>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Bulk Import
        </button>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2" style="background-color: #18181b; border: none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Product
        </a>
    </div>
</div>

<div class="card border-1 shadow-sm p-3 mb-4">
    <div class="search-widget" style="width: 100%; max-width: 400px;">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="productSearch" placeholder="Search products..." onkeyup="searchProducts();">
    </div>
</div>

<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="productTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 40%;">Name</th>
                    <th style="width: 20%;">Sku</th>
                    <th style="width: 20%;">Price</th>
                    <th style="width: 15%;">Stock</th>
                    <th style="width: 5%;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var isLowStock = p.StockQuantity <= p.LowStockThreshold;
                    <tr>
                        <td class="align-middle fw-bold text-dark">@p.Name</td>
                        <td class="align-middle text-muted">@p.Sku</td>
                        <td class="align-middle fw-bold text-dark">৳@p.SellingPrice.ToString("N0")</td>
                        <td class="align-middle">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="text-decoration-none fw-bold" style="color: #2563eb;">
                                @p.StockQuantity @p.Unit
                            </a>
                        </td>
                        <td class="align-middle text-end">
                            <div class="dropdown">
                                <button class="btn btn-link p-0 text-muted dropdown-toggle no-arrow" type="button" data-bs-toggle="dropdown">
                                    •••
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-1 mt-1">
                                    <li><a asp-action="Edit" asp-route-id="@p.Id" class="dropdown-item">Edit</a></li>
                                    <li>
                                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" class="m-0 p-0">
                                            <button type="submit" class="dropdown-item text-danger">Delete</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pagination-wrap">
    <div>Showing <strong>1</strong> to <strong>@productCount</strong> of <strong>@productCount</strong> results</div>
    <div class="d-flex gap-2">
        <a href="#" class="pagination-btn">Previous</a>
        <a href="#" class="pagination-btn">Next</a>
    </div>
</div>

@section Scripts {
    <script>
        function searchProducts() {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("productSearch");
            filter = input.value.toUpperCase();
            table = document.getElementById("productTable");
            tr = table.getElementsByTagName("tr");
            for (i = 1; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td")[0];
                if (td) {
                    txtValue = td.textContent || td.innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>
}
