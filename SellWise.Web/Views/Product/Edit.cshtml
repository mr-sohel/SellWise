@model SellWise.Web.ViewModels.Product.ProductFormViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1 px-3" style="border-radius:10px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Products
            </a>
        </div>
        <h2 class="fw-bold mb-0">Edit Product</h2>
        <p class="text-muted small mb-0 mt-1">Update product details and inventory levels</p>
    </div>
</div>

<div class="row g-4">
    <!-- Main Form -->
    <div class="col-12 col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />

            <partial name="_ProductForm" model="Model" />

            <!-- Actions -->
            <div class="d-flex align-items-center gap-3">
                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-1">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold">Cancel</a>
            </div>
        </form>
    </div>

    <!-- Sidebar -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-1 p-4 mb-4">
            <h6 class="fw-bold text-dark mb-3">Quick Summary</h6>
            <div class="d-flex flex-column gap-3" style="font-size: 0.85rem;">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Product Name</span>
                    <span class="fw-semibold text-dark text-truncate ms-2" style="max-width: 180px;">@(Model.Name ?? "—")</span>
                </div>
                <hr class="my-0" style="border-color: var(--border-light);">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">SKU</span>
                    <span class="fw-semibold text-dark">@(Model.Sku ?? "—")</span>
                </div>
                <hr class="my-0" style="border-color: var(--border-light);">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Category</span>
                    <span class="fw-semibold text-dark">@(Model.Category ?? "—")</span>
                </div>
                <hr class="my-0" style="border-color: var(--border-light);">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Cost Price</span>
                    <span class="fw-semibold text-dark">৳@Model.CostPrice.ToString("N2")</span>
                </div>
                <hr class="my-0" style="border-color: var(--border-light);">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Selling Price</span>
                    <span class="fw-semibold text-dark">৳@Model.SellingPrice.ToString("N2")</span>
                </div>
                <hr class="my-0" style="border-color: var(--border-light);">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Stock</span>
                    <span class="fw-semibold @(Model.StockQuantity <= Model.LowStockThreshold ? "text-danger" : "text-dark")">
                        @Model.StockQuantity @Model.Unit
                    </span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-1 p-4">
            <h6 class="fw-bold text-dark mb-2">Tips</h6>
            <ul class="mb-0" style="font-size: 0.8rem; color: var(--text-muted); padding-left: 1.1rem;">
                <li class="mb-1">Set the <strong>Low Stock Alert</strong> to get notified before running out.</li>
                <li class="mb-1">Use a unique <strong>SKU</strong> for barcode scanning.</li>
                <li class="mb-0">Cost price is used for <strong>profit margin</strong> calculations.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
