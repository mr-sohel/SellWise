@model SellWise.Web.ViewModels.Product.ProductFormViewModel
@{
    ViewData["Title"] = "Add Product";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1 px-3" style="border-radius:10px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Products
            </a>
        </div>
        <h2 class="fw-bold mb-0">Add Product</h2>
        <p class="text-muted small mb-0 mt-1">Add a new product to your inventory</p>
    </div>
</div>

<div class="row g-4">
    <!-- Main Form -->
    <div class="col-12 col-lg-8">
        <form asp-action="Create" method="post">

            <partial name="_ProductForm" model="Model" />

            <!-- Actions -->
            <div class="d-flex align-items-center gap-3">
                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-1">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                    Save Product
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold">Cancel</a>
            </div>
        </form>
    </div>

    <!-- Sidebar -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-1 p-4">
            <h6 class="fw-bold text-dark mb-2">Tips</h6>
            <ul class="mb-0" style="font-size: 0.8rem; color: var(--text-muted); padding-left: 1.1rem;">
                <li class="mb-1">Set the <strong>Low Stock Alert</strong> to get notified before running out.</li>
                <li class="mb-1">Use a unique <strong>SKU</strong> for barcode scanning.</li>
                <li class="mb-0">Cost price is used for <strong>profit margin</strong> calculations.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
