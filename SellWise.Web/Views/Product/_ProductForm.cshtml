@model SellWise.Web.ViewModels.Product.ProductFormViewModel

            <div class="card shadow-sm border-1 p-4 mb-4">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand);"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                    Basic Information
                </h6>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Canon EF 50mm Lens" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Sku" class="form-label fw-semibold">SKU / Barcode</label>
                        <input asp-for="Sku" class="form-control" placeholder="e.g. SKU-001" />
                        <span asp-validation-for="Sku" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label fw-semibold">Category</label>
                        <input asp-for="Category" class="form-control" placeholder="e.g. Cameras" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-1 p-4 mb-4">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand);"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Pricing
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CostPrice" class="form-label fw-semibold">Cost Price <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text fw-semibold" style="background: #f8fafc; border-color: #e2e8f0; font-size: 0.85rem;">৳</span>
                            <input asp-for="CostPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="CostPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SellingPrice" class="form-label fw-semibold">Selling Price <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text fw-semibold" style="background: #f8fafc; border-color: #e2e8f0; font-size: 0.85rem;">৳</span>
                            <input asp-for="SellingPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                        @if (Model.SellingPrice > 0 && Model.CostPrice > 0)
                        {
                            var margin = ((Model.SellingPrice - Model.CostPrice) / Model.CostPrice * 100);
                            <div class="form-text">
                                Margin: <span class="fw-semibold" style="color: @(margin > 0 ? "var(--success)" : "var(--danger)");">@margin.ToString("N1")%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-1 p-4 mb-4">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand);"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                    Inventory
                </h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="StockQuantity" class="form-label fw-semibold">Stock Quantity <span class="text-danger">*</span></label>
                        <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LowStockThreshold" class="form-label fw-semibold">Low Stock Alert</label>
                        <input asp-for="LowStockThreshold" type="number" class="form-control" placeholder="10" />
                        <span asp-validation-for="LowStockThreshold" class="text-danger small"></span>
                        <div class="form-text">Trigger alert when stock falls below this</div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Unit" class="form-label fw-semibold">Unit</label>
                        <input asp-for="Unit" class="form-control" placeholder="pcs" />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>
                </div>
            </div>
