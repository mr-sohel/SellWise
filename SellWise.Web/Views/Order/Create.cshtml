@model SellWise.Web.ViewModels.Order.OrderFormViewModel
@{
    ViewData["Title"] = "New Order";
}

<style>
.pos-products-scroll {
    flex: 1; overflow-y: auto; min-height: 0;
    max-height: calc(100vh - 260px);
}
@@media (max-width: 991.98px) { .pos-products-scroll { max-height: 400px; } }
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: .65rem;
}
.product-card {
    background: #fff;
    border: 1.5px solid #e7e2dc;
    border-radius: 10px;
    padding: .85rem .85rem .7rem;
    cursor: pointer; transition: all .12s ease;
    display: flex; flex-direction: column;
    position: relative; overflow: hidden; user-select: none;
}
.product-card:hover {
    border-color: #18181b;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,.08), 0 4px 6px -4px rgba(0,0,0,.04);
    transform: translateY(-2px);
}
.product-card:active { transform: scale(.97); }
.product-card.in-cart { border-color: #18181b; background: #f4f4f5; }
.product-card.oos { opacity: .5; cursor: not-allowed; }
.product-card.oos:hover { border-color: #e7e2dc; box-shadow: none; transform: none; }
.prod-cat {
    font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
    padding: .15rem .5rem; border-radius: 4px;
    background: #f4f4f5; color: #18181b;
    align-self: flex-start; margin-bottom: .4rem;
}
.prod-name { font-size: .85rem; font-weight: 700; color: #212529; line-height: 1.35; margin-bottom: .2rem; flex: 1; }
.prod-sku  { font-size: .67rem; color: var(--text-muted); margin-bottom: .4rem; }
.prod-footer {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-top: auto; padding-top: .4rem; border-top: 1px solid #f0ece6;
}
.prod-price { font-size: 1rem; font-weight: 800; color: #18181b; }
.prod-stock { font-size: .67rem; font-weight: 600; color: var(--text-muted); }
.prod-stock.oos-label { color: #ef4444; }
.prod-qty-badge {
    position: absolute; top: 6px; right: 6px;
    background: #18181b; color: #fff; border-radius: 50px;
    font-size: .63rem; font-weight: 800; padding: .1rem .42rem;
    min-width: 18px; text-align: center;
}
.cart-item {
    background: #fff; border: 1.5px solid #e7e2dc;
    border-radius: 10px; padding: .6rem .75rem;
    margin-bottom: .4rem; display: flex; align-items: center; gap: .6rem;
    transition: border-color .12s;
}
.cart-item:hover { border-color: #18181b; }
.ci-info { flex: 1; min-width: 0; }
.ci-name { font-size: .8rem; font-weight: 700; color: #212529; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ci-price { font-size: .7rem; color: var(--text-muted); margin-top: 1px; }
.ci-right { display: flex; align-items: center; gap: .5rem; flex-shrink: 0; }
.qty-ctrl { display: flex; align-items: center; gap: .3rem; }
.qty-val { font-size: .85rem; font-weight: 800; color: #212529; min-width: 20px; text-align: center; }
.ci-total { font-size: .85rem; font-weight: 800; color: #212529; min-width: 56px; text-align: right; }
.autocomplete-list {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0;
    background: #fff; border: 1.5px solid #e7e2dc;
    border-radius: 10px; box-shadow: 0 10px 15px -3px rgba(0,0,0,.08);
    z-index: 200; display: none; max-height: 170px; overflow-y: auto;
}
.autocomplete-row {
    padding: .5rem .75rem; cursor: pointer; font-size: .8rem;
    border-bottom: 1px solid #f0ece6; transition: background .1s;
}
.autocomplete-row:last-child { border-bottom: none; }
.autocomplete-row:hover { background: #f4f4f5; }
.autocomplete-row .row-phone { font-weight: 700; color: #212529; }
.autocomplete-row .row-name { color: var(--text-muted); font-size: .73rem; }
.cat-chip {
    border:1.5px solid var(--border-color); background:#fff; color:var(--text-primary);
    font-weight:600; font-size:.78rem; cursor:pointer; user-select:none;
}
.cat-chip.active { background:#18181b; color:#fff; border-color:#18181b; }
</style>

<div class="d-flex align-items-center gap-3 mb-3">
    <a asp-action="Index" class="btn btn-outline-primary d-inline-flex align-items-center gap-1 px-3" style="border-radius:10px; font-size:.82rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Orders
    </a>
    <div>
        <h2 class="fw-bold text-dark mb-0">New Order</h2>
        <p class="text-muted small mb-0">Tap a product to add it to the cart</p>
    </div>
</div>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" style="border-radius:10px; font-size:.875rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<div class="row g-3" style="min-height: calc(100vh - 155px);">

    <div class="col-12 col-lg-8 d-flex flex-column gap-3">
        <div class="position-relative">
            <svg class="position-absolute" style="left:.75rem;top:50%;transform:translateY(-50%);color:var(--text-muted);pointer-events:none;" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="posSearch" class="form-control" placeholder="Search by name or SKU…" autocomplete="off" style="padding-left:2.25rem;">
        </div>
        <div class="d-flex gap-1 overflow-auto flex-shrink-0" id="catChips" style="scrollbar-width:none;"></div>
        <div class="pos-products-scroll">
            <div class="product-grid" id="productGrid"></div>
        </div>
    </div>

    <div class="col-12 col-lg-4 d-flex">
        <div class="card shadow-sm w-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center px-3 py-3 border-bottom">
                <span class="fw-bold d-flex align-items-center gap-2">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#18181b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    Cart
                    <span class="badge bg-primary rounded-pill" id="cartCountBadge" style="display:none; font-size:.6rem;">0</span>
                </span>
                <button type="button" onclick="clearCart()" id="btnClearCart" class="btn btn-sm btn-outline-primary" style="display:none; font-size:.75rem;">Clear all</button>
            </div>

            <div class="px-3 pt-3 pb-2 border-bottom">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-uppercase text-muted" style="font-size:.65rem; letter-spacing:.5px;">Customer</span>
                    <span class="badge bg-success rounded-pill d-none" id="customerSelectedTag" style="font-size:.6rem;">
                        <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Linked
                    </span>
                </div>
                <div class="position-relative mb-2">
                    <input type="text" class="form-control form-control-sm" id="custSearch" placeholder="Search by phone or name…" autocomplete="off">
                    <div class="autocomplete-list" id="custDropdown"></div>
                </div>
                <div class="row g-1">
                    <div class="col-6">
                        <input type="text" class="form-control form-control-sm" id="custName" placeholder="Full Name">
                    </div>
                    <div class="col-6">
                        <input type="text" class="form-control form-control-sm" id="custAddress" placeholder="Address (optional)">
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <small class="text-muted" id="custHelperText">Leave blank for walk-in</small>
                    <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none small" id="btnClearCustomer" style="display:none;" onclick="clearCustomer()">✕ Clear</button>
                </div>
            </div>

            <div class="flex-grow-1 overflow-auto p-3 bg-light" id="cartItems" style="min-height:200px;">
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted text-center py-4" id="cartEmpty">
                    <div class="d-flex align-items-center justify-content-center mb-2" style="width:44px;height:44px;border-radius:10px;background:#f0ece6;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-muted)"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    </div>
                    <p class="fw-bold text-dark mb-1" style="font-size:.875rem;">Cart is empty</p>
                    <p style="font-size:.75rem;">Tap a product on the left to add it</p>
                </div>
            </div>

            <div class="px-3 py-3 border-top">
                <div class="mb-2">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold text-dark" id="cartSubtotal">৳0</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-1 align-items-center">
                        <span class="text-muted">Delivery</span>
                        <input type="number" class="form-control form-control-sm" id="cartDelivery" value="0" min="0" style="width:88px;text-align:right;">
                    </div>
                    <div class="d-flex justify-content-between small mb-1 align-items-center">
                        <span class="text-muted">Discount</span>
                        <input type="number" class="form-control form-control-sm" id="cartDiscount" value="0" min="0" style="width:88px;text-align:right;color:#dc2626;">
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-2 mb-2">
                    <span class="fw-bold text-dark">Total</span>
                    <span class="fs-4 fw-bold" style="color:#18181b;" id="cartTotal">৳0</span>
                </div>

                <div class="mb-2">
                    <textarea class="form-control form-control-sm" id="orderNotes" rows="2" placeholder="Order notes (optional)…" style="resize:none;"></textarea>
                </div>

                <div class="d-none align-items-center gap-1 small text-danger bg-danger-subtle p-2 rounded mb-2" id="cartError">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span id="cartErrorMsg"></span>
                </div>

                <button type="button" class="btn btn-primary w-100 py-3 fw-bold d-flex align-items-center justify-content-center gap-2" id="btnCheckout" style="box-shadow:0 4px 14px rgba(24,24,27,.3);font-size:1rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    Place Order
                </button>
            </div>
        </div>
    </div>

</div>

<form asp-action="Create" method="post" id="hiddenPosForm" style="display:none;">
    <input type="hidden" name="CustomerId"         id="hfCustomerId" />
    <input type="hidden" name="NewCustomerName"    id="hfCustName" />
    <input type="hidden" name="NewCustomerPhone"   id="hfCustPhone" />
    <input type="hidden" name="NewCustomerAddress" id="hfCustAddress" />
    <input type="hidden" name="DeliveryCharge"     id="hfDelivery" />
    <input type="hidden" name="Discount"           id="hfDiscount" />
    <input type="hidden" name="Notes"              id="hfNotes" />
    <div id="hiddenItems"></div>
</form>

@section Scripts {
<script>
const ALL_PRODUCTS  = @Html.Raw(Model.ProductsJson);
const ALL_CUSTOMERS = @Html.Raw(Model.CustomersJson);

let state = {
    products:   ALL_PRODUCTS,
    customers:  ALL_CUSTOMERS,
    cart:       [],
    search:     '',
    category:   'All',
    delivery:   0,
    discount:   0,
    customerId: null,
};

const productGrid    = document.getElementById('productGrid');
const catChips       = document.getElementById('catChips');
const cartItems      = document.getElementById('cartItems');
const cartEmpty      = document.getElementById('cartEmpty');
const cartSubtotal   = document.getElementById('cartSubtotal');
const cartTotal      = document.getElementById('cartTotal');
const cartCountBadge = document.getElementById('cartCountBadge');
const btnClearCart   = document.getElementById('btnClearCart');
const cartError      = document.getElementById('cartError');
const cartErrorMsg   = document.getElementById('cartErrorMsg');
const custSearch     = document.getElementById('custSearch');
const custDropdown   = document.getElementById('custDropdown');
const custName       = document.getElementById('custName');
const custAddress    = document.getElementById('custAddress');
const custHelperText = document.getElementById('custHelperText');
const btnClearCust   = document.getElementById('btnClearCustomer');
const custSelTag     = document.getElementById('customerSelectedTag');
const deliveryInput  = document.getElementById('cartDelivery');
const discountInput  = document.getElementById('cartDiscount');

function init() {
    const cats = ['All', ...new Set(ALL_PRODUCTS.map(p => p.category))];
    cats.forEach(cat => {
        const el = document.createElement('span');
        el.className = 'cat-chip badge rounded-pill px-3 py-2';
        el.textContent = cat;
        if (cat === 'All') el.classList.add('active');
        el.onclick = () => {
            document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
            state.category = cat;
            renderProducts();
        };
        catChips.appendChild(el);
    });

    document.getElementById('posSearch').addEventListener('input', e => {
        state.search = e.target.value.toLowerCase();
        renderProducts();
    });

    custSearch.addEventListener('input', onCustomerSearch);
    custSearch.addEventListener('focus', onCustomerSearch);
    document.addEventListener('click', e => {
        if (!custSearch.contains(e.target)) custDropdown.style.display = 'none';
    });

    deliveryInput.addEventListener('input', e => { state.delivery = parseFloat(e.target.value) || 0; renderTotals(); });
    discountInput.addEventListener('input', e => { state.discount = parseFloat(e.target.value) || 0; renderTotals(); });

    document.getElementById('btnCheckout').addEventListener('click', submitOrder);

    renderProducts();
}

function renderProducts() {
    productGrid.innerHTML = '';
    const filtered = ALL_PRODUCTS.filter(p => {
        const matchCat    = state.category === 'All' || p.category === state.category;
        const matchSearch = !state.search ||
            p.name.toLowerCase().includes(state.search) ||
            (p.sku && p.sku.toLowerCase().includes(state.search));
        return matchCat && matchSearch;
    });

    if (filtered.length === 0) {
        productGrid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:3rem 1rem;color:var(--text-muted);font-size:.875rem;"><div style="font-size:2rem;margin-bottom:.5rem;">🔍</div>No products match your search</div>';
        return;
    }

    filtered.forEach(p => {
        const oos    = p.stockQuantity <= 0;
        const inCart = state.cart.find(i => i.id === p.id);
        const card   = document.createElement('div');
        card.className = `product-card${oos ? ' oos' : ''}${inCart ? ' in-cart' : ''}`;
        card.innerHTML = `
            <span class="prod-cat">${p.category}</span>
            <div class="prod-name">${p.name}</div>
            ${p.sku ? `<div class="prod-sku">${p.sku}</div>` : ''}
            <div class="prod-footer">
                <span class="prod-price">৳${p.sellingPrice.toLocaleString('en-BD', {minimumFractionDigits:0, maximumFractionDigits:0})}</span>
                <span class="prod-stock${oos ? ' oos-label' : ''}">${oos ? 'Out of stock' : `${p.stockQuantity} left`}</span>
            </div>
            ${inCart ? `<div class="prod-qty-badge">${inCart.qty}</div>` : ''}
        `;
        if (!oos) card.addEventListener('click', () => addToCart(p));
        productGrid.appendChild(card);
    });
}

function addToCart(p) {
    hideError();
    const existing = state.cart.find(i => i.id === p.id);
    if (existing) {
        if (existing.qty < p.stockQuantity) existing.qty++;
        else { showError(`Only ${p.stockQuantity} units available for "${p.name}".`); return; }
    } else {
        state.cart.push({ ...p, qty: 1 });
    }
    renderCart();
    renderProducts();
}

function updateQty(id, delta) {
    const item = state.cart.find(i => i.id === id);
    if (!item) return;
    const newQty = item.qty + delta;
    if (newQty <= 0) {
        state.cart = state.cart.filter(i => i.id !== id);
    } else if (newQty > item.stockQuantity) {
        showError(`Max ${item.stockQuantity} for "${item.name}".`); return;
    } else {
        item.qty = newQty;
    }
    hideError();
    renderCart();
    renderProducts();
}

function removeItem(id) {
    state.cart = state.cart.filter(i => i.id !== id);
    hideError(); renderCart(); renderProducts();
}

function clearCart() {
    state.cart = [];
    hideError(); renderCart(); renderProducts();
}

function renderCart() {
    Array.from(cartItems.children).forEach(el => { if (el !== cartEmpty) el.remove(); });

    const hasItems = state.cart.length > 0;
    cartEmpty.style.display            = hasItems ? 'none'         : 'flex';
    btnClearCart.style.display         = hasItems ? 'block'        : 'none';
    cartCountBadge.style.display       = hasItems ? 'inline-block' : 'none';
    cartCountBadge.textContent          = state.cart.reduce((s, i) => s + i.qty, 0);

    state.cart.forEach(item => {
        const div = document.createElement('div');
        div.className = 'cart-item';
        div.innerHTML = `
            <div class="ci-info">
                <div class="ci-name" title="${item.name}">${item.name}</div>
                <div class="ci-price">৳${item.sellingPrice.toLocaleString('en-BD', {minimumFractionDigits:0})} × ${item.qty}</div>
            </div>
            <div class="ci-right">
                <div class="qty-ctrl">
                    <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center justify-content-center" style="width:26px;height:26px;padding:0;font-size:1rem;line-height:1;border-radius:7px;font-weight:700;" onclick="updateQty('${item.id}', -1)">−</button>
                    <span class="qty-val">${item.qty}</span>
                    <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center justify-content-center" style="width:26px;height:26px;padding:0;font-size:1rem;line-height:1;border-radius:7px;font-weight:700;" onclick="updateQty('${item.id}', 1)">+</button>
                </div>
                <div class="ci-total">৳${(item.sellingPrice * item.qty).toLocaleString('en-BD', {minimumFractionDigits:0})}</div>
                <button class="btn btn-sm d-flex align-items-center justify-content-center" style="width:26px;height:26px;padding:0;border:none;border-radius:4px;color:var(--text-muted);background:none;" onclick="removeItem('${item.id}')" title="Remove">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
        `;
        cartItems.insertBefore(div, cartEmpty);
    });

    renderTotals();
}

function renderTotals() {
    const subtotal = state.cart.reduce((s, i) => s + i.sellingPrice * i.qty, 0);
    const total    = Math.max(0, subtotal + state.delivery - state.discount);
    cartSubtotal.textContent = `৳${subtotal.toLocaleString('en-BD', {minimumFractionDigits:0})}`;
    cartTotal.textContent    = `৳${total.toLocaleString('en-BD', {minimumFractionDigits:0})}`;
}

function onCustomerSearch() {
    if (state.customerId) return;
    const val = custSearch.value.toLowerCase().trim();
    custDropdown.innerHTML = '';
    if (!val) { custDropdown.style.display = 'none'; return; }

    const matches = ALL_CUSTOMERS.filter(c =>
        (c.phone && c.phone.toLowerCase().includes(val)) ||
        (c.name  && c.name.toLowerCase().includes(val))
    ).slice(0, 6);

    if (matches.length) {
        matches.forEach(c => {
            const row = document.createElement('div');
            row.className = 'autocomplete-row';
            row.innerHTML = `<div class="row-phone">${c.phone || '—'}</div><div class="row-name">${c.name}</div>`;
            row.onclick = () => selectCustomer(c);
            custDropdown.appendChild(row);
        });
        custDropdown.style.display = 'block';
    } else {
        custDropdown.style.display = 'none';
    }
}

function selectCustomer(c) {
    state.customerId = c.id;
    custSearch.value  = c.phone || '';
    custName.value    = c.name  || '';
    custAddress.value = c.address || '';
    custSearch.readOnly = custName.readOnly = custAddress.readOnly = true;
    custDropdown.style.display = 'none';
    btnClearCust.style.display = 'inline';
    custSelTag.classList.remove('d-none');
    custHelperText.textContent = c.name;
}

function clearCustomer() {
    state.customerId = null;
    custSearch.value = custName.value = custAddress.value = '';
    custSearch.readOnly = custName.readOnly = custAddress.readOnly = false;
    btnClearCust.style.display = 'none';
    custSelTag.classList.add('d-none');
    custHelperText.textContent = 'Leave blank for walk-in';
    custSearch.focus();
}

function showError(msg) {
    cartErrorMsg.textContent = msg;
    cartError.classList.remove('d-none');
    cartError.classList.add('d-flex');
    setTimeout(hideError, 4000);
}
function hideError() { cartError.classList.add('d-none'); cartError.classList.remove('d-flex'); }

function submitOrder() {
    if (state.cart.length === 0) { showError('Add at least one product to place an order.'); return; }
    const subtotal = state.cart.reduce((s, i) => s + i.sellingPrice * i.qty, 0);
    if (state.discount > subtotal + state.delivery) { showError('Discount cannot exceed the total.'); return; }

    const btn = document.getElementById('btnCheckout');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Placing Order…';

    document.getElementById('hfCustomerId').value  = state.customerId || '';
    document.getElementById('hfCustName').value    = state.customerId ? '' : custName.value.trim();
    document.getElementById('hfCustPhone').value   = state.customerId ? '' : custSearch.value.trim();
    document.getElementById('hfCustAddress').value = state.customerId ? '' : custAddress.value.trim();
    document.getElementById('hfDelivery').value    = state.delivery;
    document.getElementById('hfDiscount').value    = state.discount;
    document.getElementById('hfNotes').value       = document.getElementById('orderNotes').value.trim();

    const itemsContainer = document.getElementById('hiddenItems');
    itemsContainer.innerHTML = '';
    state.cart.forEach((item, i) => {
        itemsContainer.innerHTML += `<input type="hidden" name="Items[${i}].ProductId" value="${item.id}" />`;
        itemsContainer.innerHTML += `<input type="hidden" name="Items[${i}].Quantity"  value="${item.qty}" />`;
    });

    document.getElementById('hiddenPosForm').submit();
}

init();
</script>
}
