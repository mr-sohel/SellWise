@model SellWise.Web.ViewModels.Order.OrderFormViewModel
@{
    ViewData["Title"] = "Create POS Order";
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 p-4 mb-4">
            <h5 class="fw-bold mb-3">Order Details</h5>
            <form asp-action="Create" method="post" id="orderForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label">Customer</label>
                        <select asp-for="CustomerId" asp-items="Model.AvailableCustomers" class="form-select">
                            <option value="">Walk-in Customer</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Source" class="form-label">Order Source</label>
                        <select asp-for="Source" class="form-select">
                            <option value="walk_in">In-Store / Walk-in</option>
                            <option value="online">Online / Delivery</option>
                        </select>
                        <span asp-validation-for="Source" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Products</label>
                    <div id="product-list">
                        <!-- Single product dropdown for simplicity in MVC without React -->
                        <div class="row mb-2">
                            <div class="col-md-8">
                                <select name="Items[0].ProductId" asp-items="Model.AvailableProducts" class="form-select">
                                    <option value="">-- Select a Product --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <input name="Items[0].Quantity" type="number" class="form-control" value="1" min="1" placeholder="Qty" />
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">For this simplified defense version, add one product line at a time. A real POS would use JavaScript to add multiple rows.</small>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="DeliveryCharge" class="form-label">Delivery Charge (৳)</label>
                        <input asp-for="DeliveryCharge" type="number" class="form-control" value="0" />
                        <span asp-validation-for="DeliveryCharge" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Discount" class="form-label">Discount (৳)</label>
                        <input asp-for="Discount" type="number" class="form-control" value="0" />
                        <span asp-validation-for="Discount" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Order Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">Complete Order</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-4 bg-light position-sticky" style="top: 80px;">
            <h5 class="fw-bold text-dark mb-4">Order Summary</h5>

            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Subtotal</span>
                <span class="fw-bold text-dark" id="summarySubtotal">৳0</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Delivery</span>
                <span class="fw-bold text-dark" id="summaryDelivery">৳0</span>
            </div>
            <div class="d-flex justify-content-between mb-3 text-danger">
                <span>Discount</span>
                <span class="fw-bold" id="summaryDiscount">-৳0</span>
            </div>

            <hr />

            <div class="d-flex justify-content-between mb-2">
                <span class="fw-bold" style="font-size: 1.1rem;">Total</span>
                <span class="fw-bold text-primary" style="font-size: 1.25rem;" id="summaryTotal">৳0</span>
            </div>

            <p class="small text-muted mt-4 mb-0">Stock will be automatically deducted upon completion.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const productSelect = document.querySelector("select[name='Items[0].ProductId']");
            const quantityInput = document.querySelector("input[name='Items[0].Quantity']");
            const deliveryInput = document.getElementById("DeliveryCharge");
            const discountInput = document.getElementById("Discount");

            const summarySubtotal = document.getElementById("summarySubtotal");
            const summaryDelivery = document.getElementById("summaryDelivery");
            const summaryDiscount = document.getElementById("summaryDiscount");
            const summaryTotal = document.getElementById("summaryTotal");

            function calculateSummary() {
                let subtotal = 0;
                const qty = parseInt(quantityInput.value) || 0;

                if (productSelect.selectedIndex > 0) {
                    const optionText = productSelect.options[productSelect.selectedIndex].text;
                    const priceMatch = optionText.match(/\(৳([\d.]+)\s-/);
                    if (priceMatch && priceMatch[1]) {
                        subtotal = parseFloat(priceMatch[1]) * qty;
                    }
                }

                const delivery = parseFloat(deliveryInput.value) || 0;
                const discount = parseFloat(discountInput.value) || 0;

                const total = Math.max(0, subtotal + delivery - discount);

                summarySubtotal.innerText = `৳${subtotal.toLocaleString()}`;
                summaryDelivery.innerText = `৳${delivery.toLocaleString()}`;
                summaryDiscount.innerText = `-৳${discount.toLocaleString()}`;
                summaryTotal.innerText = `৳${total.toLocaleString()}`;
            }

            productSelect.addEventListener("change", calculateSummary);
            quantityInput.addEventListener("input", calculateSummary);
            deliveryInput.addEventListener("input", calculateSummary);
            discountInput.addEventListener("input", calculateSummary);
        });
    </script>
}
