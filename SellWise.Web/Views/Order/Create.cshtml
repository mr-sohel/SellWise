@model SellWise.Web.ViewModels.Order.OrderFormViewModel
@{
    ViewData["Title"] = "Create POS Order";
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 p-4 mb-4">
            <h5 class="fw-bold mb-3">Order Details</h5>
            <form asp-action="Create" method="post" id="orderForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label">Customer</label>
                        <select asp-for="CustomerId" asp-items="Model.AvailableCustomers" class="form-select">
                            <option value="">Walk-in Customer</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Source" class="form-label">Order Source</label>
                        <select asp-for="Source" class="form-select">
                            <option value="walk_in">In-Store / Walk-in</option>
                            <option value="online">Online / Delivery</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Products</label>
                    <div id="product-list">
                        <!-- Single product dropdown for simplicity in MVC without React -->
                        <div class="row mb-2">
                            <div class="col-md-8">
                                <select name="Items[0].ProductId" asp-items="Model.AvailableProducts" class="form-select">
                                    <option value="">-- Select a Product --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <input name="Items[0].Quantity" type="number" class="form-control" value="1" min="1" placeholder="Qty" />
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">For this simplified defense version, add one product line at a time. A real POS would use JavaScript to add multiple rows.</small>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="DeliveryCharge" class="form-label">Delivery Charge (৳)</label>
                        <input asp-for="DeliveryCharge" type="number" class="form-control" value="0" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Discount" class="form-label">Discount (৳)</label>
                        <input asp-for="Discount" type="number" class="form-control" value="0" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Order Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">Complete Order</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-4 bg-light">
            <h5 class="fw-bold text-muted mb-3">Order Summary</h5>
            <p>Select products and click "Complete Order" to checkout.</p>
            <p class="small text-muted">Stock will be automatically deducted from inventory.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
