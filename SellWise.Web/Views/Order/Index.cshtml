@model IEnumerable<SellWise.Web.ViewModels.Order.OrderViewModel>
@{
    ViewData["Title"] = "Orders";
    var orderCount = Model.Count();
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <h2 class="fw-bold text-dark mb-0">Orders</h2>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#bulkImportModal">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Bulk Import
        </button>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2" style="background-color: #18181b; border: none;">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Create Order
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-1 shadow-sm p-3 mb-4">
    <form method="get" class="d-flex flex-column flex-sm-row gap-3">
        <div class="search-widget" style="width: 100%; max-width: 400px;">
            <svg aria-hidden="true" class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" value="@ViewData["Search"]" aria-label="Search" placeholder="Search by Order # or Customer...">
        </div>
        <select class="form-select" name="status" style="width: 100%; max-width: 200px; background-color: #ffffff; border-color: #cbd5e1;" onchange="this.form.submit();">
            <option value="">All Statuses</option>
            <option value="pending" selected="@(ViewData["Status"]?.ToString()?.ToLower() == "pending")">Pending</option>
            <option value="processing" selected="@(ViewData["Status"]?.ToString()?.ToLower() == "processing")">Processing</option>
            <option value="delivered" selected="@(ViewData["Status"]?.ToString()?.ToLower() == "delivered")">Delivered</option>
            <option value="completed" selected="@(ViewData["Status"]?.ToString()?.ToLower() == "completed")">Completed</option>
            <option value="cancelled" selected="@(ViewData["Status"]?.ToString()?.ToLower() == "cancelled")">Cancelled</option>
            <option value="returned" selected="@(ViewData["Status"]?.ToString()?.ToLower() == "returned")">Returned</option>
        </select>
        <button type="submit" class="btn btn-primary d-none">Search</button>
    </form>
</div>

<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="orderTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 20%;">Order #</th>
                    <th style="width: 30%;">Customer</th>
                    <th style="width: 20%;">Date</th>
                    <th style="width: 15%;">Total</th>
                    <th style="width: 10%;">Status</th>
                    <th style="width: 12%;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold text-dark">@o.OrderNumber</td>
                        <td class="align-middle">
                            <div class="fw-bold text-dark">@(o.CustomerName ?? "Walk-in Customer")</div>
                            @if (!string.IsNullOrEmpty(o.CustomerPhone))
                            {
                                <div class="text-muted" style="font-size: 0.75rem;">@o.CustomerPhone</div>
                            }
                        </td>
                        <td class="align-middle text-muted">@o.OrderDate.ToString("M/d/yyyy")</td>
                        <td class="align-middle fw-bold text-dark">৳@o.Total.ToString("N0")</td>
                        <td class="align-middle">
                            @{
                                var statusCls = o.Status?.ToLower() switch {
                                    "completed" => "status-completed",
                                    "delivered" => "status-delivered",
                                    "pending" => "status-pending",
                                    "processing" => "status-processing",
                                    "cancelled" => "status-cancelled",
                                    "returned" => "status-returned",
                                    _ => "status-pending"
                                };
                            }
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle fw-semibold order-status-badge @statusCls" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.75rem; border: none; cursor: pointer;">
                                    @(o.Status?.Replace("_", " ") ?? "pending")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="min-width: 160px; font-size: 0.8rem;">
                                    <li class="dropdown-header text-muted" style="font-size: 0.7rem;">Change Status</li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    @foreach (var s in new[] { "pending", "processing", "delivered", "completed", "cancelled", "returned" })
                                    {
                                        <li>
                                            <form asp-action="ChangeStatus" asp-route-id="@o.Id" method="post" class="m-0 p-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="status" value="@s" />
                                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 @(o.Status?.ToLower() == s ? "fw-bold" : "")">
                                                    <span class="order-status-dot @("status-dot-" + s)"></span>
                                                    @s
                                                    @if (o.Status?.ToLower() == s)
                                                    {
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ms-auto"><polyline points="20 6 9 17 4 12"/></svg>
                                                    }
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                        <td class="align-middle text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm d-inline-flex align-items-center gap-1" style="color: #4338ca; background-color: #eef2ff; border: none; font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.6rem;" title="View Details">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    View
                                </a>
                                @if (o.Status?.ToLower() != "cancelled" && o.Status?.ToLower() != "returned" && o.Status?.ToLower() != "completed")
                                {
                                    <form asp-action="Cancel" asp-route-id="@o.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel order @o.OrderNumber?');" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm d-inline-flex align-items-center gap-1" style="color: #dc2626; background-color: #fef2f2; border: none; font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.6rem;" title="Cancel Order">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                            Cancel
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No orders found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pagination-wrap">
    <div>Showing <strong>@Model.Count()</strong> of <strong>@ViewData["TotalItems"]</strong> results</div>
    <div class="d-flex gap-2">
        @{
            int currentPage = (int)ViewData["CurrentPage"]!;
            int totalPages = (int)ViewData["TotalPages"]!;
            var search = ViewData["Search"]?.ToString();
            var status = ViewData["Status"]?.ToString();
        }
        @if (currentPage > 1)
        {
            <a href="?page=@(currentPage - 1)&search=@(search != null ? Uri.EscapeDataString(search) : "")&status=@(status != null ? Uri.EscapeDataString(status) : "")" class="pagination-btn">Previous</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Previous</span>
        }

        @if (currentPage < totalPages)
        {
            <a href="?page=@(currentPage + 1)&search=@(search != null ? Uri.EscapeDataString(search) : "")&status=@(status != null ? Uri.EscapeDataString(status) : "")" class="pagination-btn">Next</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Next</span>
        }
    </div>
</div>

<div class="modal fade" id="bulkImportModal" tabindex="-1" aria-labelledby="bulkImportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="BulkImport" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="bulkImportModalLabel">Bulk Import Orders</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Upload a CSV file containing order information. The CSV should have headers: OrderNumber, CustomerName, CustomerPhone, Total, Status, OrderDate.</p>
                    <div class="mb-3">
                        <label for="csvFile" class="form-label fw-bold">Select CSV File</label>
                        <input type="file" class="form-control" id="csvFile" name="file" accept=".csv" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background-color: #18181b; border: none;">Import Orders</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
}
