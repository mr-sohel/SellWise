@model IEnumerable<SellWise.Web.ViewModels.Order.OrderViewModel>
@{
    ViewData["Title"] = "Orders";
    var currentStatus   = ViewData["Status"]?.ToString()?.ToLower()    ?? "all";
    var currentDateRange = ViewData["DateRange"]?.ToString()?.ToLower() ?? "all";
    int currentPage  = (int)ViewData["CurrentPage"]!;
    int totalPages   = (int)ViewData["TotalPages"]!;
    var searchVal    = ViewData["Search"]?.ToString();
    var totalItems   = (int)(ViewData["TotalItems"] ?? 0);
}

<style>
/* ── Page header ── */
.ord-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
}
.ord-title   { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); letter-spacing: -.5px; margin: 0; }
.ord-sub     { font-size: .8rem; color: var(--text-muted); margin: .15rem 0 0; }

/* ── KPI strip ── */
.kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: .85rem;
    margin-bottom: 1.25rem;
}
@@media (max-width: 991px) { .kpi-strip { grid-template-columns: repeat(2,1fr); } }
@@media (max-width: 479px) { .kpi-strip { grid-template-columns: 1fr 1fr; } }

.kpi-tile {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: .85rem;
    box-shadow: var(--shadow-sm);
}
.kpi-icon {
    width: 40px; height: 40px;
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.kpi-label {
    font-size: .68rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .5px;
    color: var(--text-muted); margin-bottom: .2rem;
}
.kpi-value {
    font-size: 1.45rem; font-weight: 800;
    letter-spacing: -.5px; line-height: 1.1;
    font-family: 'Outfit', sans-serif; color: var(--text-primary);
}

/* ── Toolbar ── */
.toolbar {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: .7rem 1rem;
    margin-bottom: .85rem;
    display: flex;
    gap: .75rem;
    align-items: center;
    flex-wrap: wrap;
    box-shadow: var(--shadow-sm);
}
.status-pills { display: flex; gap: .3rem; flex-wrap: wrap; flex: 1; min-width: 0; }
.s-pill {
    padding: .38rem .95rem;
    border-radius: 50px;
    font-size: .78rem; font-weight: 600;
    cursor: pointer;
    border: 1.5px solid transparent;
    background: var(--bg-app);
    color: var(--text-main);
    transition: all .15s ease;
    text-decoration: none; display: inline-block;
    white-space: nowrap;
}
.s-pill:hover                { background: var(--brand-light); color: var(--brand); border-color: #c7d2fe; }
.s-pill.sp-all               { background: var(--brand); color: #fff; border-color: var(--brand); box-shadow: 0 2px 6px rgba(67,56,202,.22); }
.s-pill.sp-pending           { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
.s-pill.sp-processing        { background: #dbeafe; color: #1e40af; border-color: #93c5fd; }
.s-pill.sp-delivered         { background: #d1fae5; color: #065f46; border-color: #6ee7b7; }
.s-pill.sp-completed         { background: #d1fae5; color: #065f46; border-color: #6ee7b7; }
.s-pill.sp-cancelled         { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
.s-pill.sp-returned          { background: #fce7f3; color: #9d174d; border-color: #f9a8d4; }

.toolbar-right { display: flex; gap: .5rem; align-items: center; flex-shrink: 0; flex-wrap: wrap; }

/* Search */
.t-search { position: relative; }
.t-search input {
    width: 210px;
    padding: .44rem .85rem .44rem 2.1rem;
    background: var(--bg-app);
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: .82rem; color: var(--text-primary);
    outline: none; transition: all .15s ease;
}
.t-search input:focus { background: #fff; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(67,56,202,.08); }
.t-search input::placeholder { color: var(--text-muted); }
.t-search-icon { position: absolute; left: .65rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }

.t-date {
    padding: .44rem .75rem;
    background: var(--bg-app);
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: .82rem; color: var(--text-primary);
    cursor: pointer; font-weight: 500; outline: none;
    transition: all .15s ease;
}
.t-date:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(67,56,202,.08); }

/* ── Table card ── */
.orders-card {
    background: #fff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}
.ord-table thead th {
    background: #fafafa;
    border-bottom: 1px solid var(--border-color);
    padding: .85rem 1.25rem;
    font-size: .68rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .5px;
    color: var(--text-muted); white-space: nowrap;
}
.ord-table tbody td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-light);
    font-size: .875rem; vertical-align: middle;
}
.ord-table tbody tr:last-child td { border-bottom: none; }
.ord-table tbody tr { transition: background .12s; }
.ord-table tbody tr:hover td { background: var(--brand-lighter); }

.ord-num {
    font-weight: 700; color: var(--text-primary);
    text-decoration: none; font-size: .875rem;
    transition: color .15s;
}
.ord-num:hover { color: var(--brand); }

.cust-name  { font-weight: 600; color: var(--text-primary); }
.cust-phone { font-size: .75rem; color: var(--text-muted); margin-top: 2px; }

.ord-date      { color: var(--text-muted); font-size: .82rem; white-space: nowrap; }
.ord-date-time { font-size: .72rem; color: var(--text-muted); margin-top: 1px; }

.ord-amount { font-weight: 700; color: var(--text-primary); font-size: .9rem; }

/* ── Row actions ── */
.row-actions { display: flex; align-items: center; gap: .4rem; justify-content: flex-end; }

.ra-btn {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .38rem .8rem;
    border-radius: 7px;
    font-size: .75rem; font-weight: 700;
    border: 1.5px solid transparent;
    cursor: pointer; transition: all .15s ease;
    text-decoration: none; white-space: nowrap;
    line-height: 1.2;
}
.ra-process { background: #fffbeb; color: #92400e; border-color: #fcd34d; }
.ra-process:hover { background: #f59e0b; color: #fff; border-color: #f59e0b; }
.ra-deliver { background: #eff6ff; color: #1e40af; border-color: #93c5fd; }
.ra-deliver:hover { background: #3b82f6; color: #fff; border-color: #3b82f6; }
.ra-complete { background: #ecfdf5; color: #065f46; border-color: #6ee7b7; }
.ra-complete:hover { background: #10b981; color: #fff; border-color: #10b981; }
.ra-view { background: var(--bg-app); color: var(--text-main); border-color: var(--border-color); }
.ra-view:hover { background: var(--brand-light); color: var(--brand); border-color: var(--brand); }
.ra-invoice { background: var(--bg-app); color: var(--text-main); border-color: var(--border-color); }
.ra-invoice:hover { background: var(--brand-light); color: var(--brand); border-color: var(--brand); }

.more-btn {
    width: 32px; height: 32px;
    border-radius: 7px;
    border: 1.5px solid var(--border-color);
    background: var(--bg-app); color: var(--text-muted);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all .15s ease;
}
.more-btn:hover { background: var(--brand-light); color: var(--brand); border-color: var(--brand); }

/* ── Empty state ── */
.empty-state {
    text-align: center; padding: 4.5rem 2rem;
}
.empty-icon {
    width: 60px; height: 60px;
    border-radius: var(--radius-lg);
    background: var(--brand-light);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.1rem;
}
.empty-title { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: .35rem; }
.empty-text  { font-size: .85rem; color: var(--text-muted); margin-bottom: 1.25rem; }

/* ── Pagination ── */
.pager {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 1.1rem; flex-wrap: wrap; gap: .75rem;
}
.pager-info { font-size: .82rem; color: var(--text-muted); }
.pager-info strong { color: var(--text-primary); }
.pager-nav { display: flex; gap: .35rem; align-items: center; }
.pg-btn {
    padding: .38rem .9rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-color);
    background: #fff; color: var(--text-primary);
    font-size: .8rem; font-weight: 600;
    text-decoration: none; transition: all .15s ease;
    display: inline-flex; align-items: center; gap: .3rem;
}
.pg-btn:hover:not(.disabled) { border-color: var(--brand); color: var(--brand); background: var(--brand-light); }
.pg-btn.disabled { opacity: .4; cursor: default; pointer-events: none; }
.pg-num {
    width: 34px; height: 34px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-color);
    font-size: .8rem; font-weight: 600;
    text-decoration: none; color: var(--text-primary);
    transition: all .15s ease;
}
.pg-num:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-light); }
.pg-num.active { background: var(--brand); color: #fff; border-color: var(--brand); }

/* ── Header buttons ── */
.btn-ghost-sm {
    padding: .48rem 1rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-color);
    background: #fff; color: var(--text-main);
    font-size: .82rem; font-weight: 600;
    display: inline-flex; align-items: center; gap: .4rem;
    cursor: pointer; transition: all .15s ease; text-decoration: none;
}
.btn-ghost-sm:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-light); }

.btn-new-order {
    padding: .52rem 1.2rem;
    border-radius: var(--radius-md); border: none;
    background: var(--brand); color: #fff;
    font-size: .875rem; font-weight: 700;
    display: inline-flex; align-items: center; gap: .45rem;
    cursor: pointer; transition: all .15s ease; text-decoration: none;
    box-shadow: 0 2px 8px rgba(67,56,202,.3);
    letter-spacing: .01em;
}
.btn-new-order:hover { background: var(--brand-hover); color: #fff; box-shadow: 0 4px 14px rgba(67,56,202,.35); transform: translateY(-1px); }

@@media print {
    .no-print { display: none !important; }
    body * { visibility: hidden; }
    #orderTable, #orderTable * { visibility: visible; }
    #orderTable { position: absolute; left: 0; top: 0; width: 100%; }
}
</style>

<!-- ── Header ── -->
<div class="ord-header no-print">
    <div>
        <h1 class="ord-title">Orders</h1>
        <p class="ord-sub">Track and manage every sale in one place</p>
    </div>
    <div style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center;">
        <button type="button" class="btn-ghost-sm" data-bs-toggle="modal" data-bs-target="#bulkImportModal">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Import
        </button>
        <button type="button" class="btn-ghost-sm" onclick="window.print()" title="Print list">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Print
        </button>
        <a asp-action="Create" class="btn-new-order">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Order
        </a>
    </div>
</div>

<!-- ── Alerts ── -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 no-print mb-3"
         role="alert" style="border-radius:var(--radius-md); font-size:.875rem; border:1px solid #a7f3d0;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 no-print mb-3"
         role="alert" style="border-radius:var(--radius-md); font-size:.875rem;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ── KPI Strip ── -->
<div class="kpi-strip no-print">
    <div class="kpi-tile">
        <div class="kpi-icon" style="background:var(--success-bg);">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div>
            <div class="kpi-label">Today's Revenue</div>
            <div class="kpi-value" style="color:var(--success);">৳@(ViewBag.TodayRevenue?.ToString("N0") ?? "0")</div>
        </div>
    </div>
    <div class="kpi-tile">
        <div class="kpi-icon" style="background:var(--brand-light);">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <div>
            <div class="kpi-label">Orders Today</div>
            <div class="kpi-value">@(ViewBag.TodayOrdersCount ?? 0)</div>
        </div>
    </div>
    <div class="kpi-tile">
        <div class="kpi-icon" style="background:var(--warning-bg);">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
            <div class="kpi-label">Needs Attention</div>
            <div class="kpi-value" style="color:var(--warning);">@(ViewBag.PendingOrdersCount ?? 0)</div>
        </div>
    </div>
    <div class="kpi-tile">
        <div class="kpi-icon" style="background:var(--purple-bg);">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        <div>
            <div class="kpi-label">Showing</div>
            <div class="kpi-value" style="color:var(--purple);">@totalItems</div>
        </div>
    </div>
</div>

<!-- ── Filter toolbar ── -->
<form method="get" id="filterForm" class="no-print">
    <div class="toolbar">
        <div class="status-pills">
            <input type="hidden" name="status" id="statusFilter" value="@currentStatus" />
            @{
                var tabs = new[] {
                    ("all",        "All"),
                    ("pending",    "Pending"),
                    ("processing", "Processing"),
                    ("delivered",  "Delivered"),
                    ("completed",  "Completed"),
                    ("cancelled",  "Cancelled"),
                    ("returned",   "Returned"),
                };
            }
            @foreach (var (val, label) in tabs)
            {
                var isActive  = currentStatus == val;
                var activeClass = isActive ? (val == "all" ? " sp-all" : $" sp-{val}") : "";
                <a href="javascript:void(0)" onclick="setStatus('@val')"
                   class="s-pill@(activeClass)">@label</a>
            }
        </div>

        <div class="toolbar-right">
            @{
                var dateOpts = new[] {
                    ("all",       "All Time"),
                    ("today",     "Today"),
                    ("yesterday", "Yesterday"),
                    ("week",      "Last 7 Days"),
                    ("month",     "This Month"),
                };
                var selectHtml = new System.Text.StringBuilder();
                selectHtml.Append("<select class=\"t-date\" name=\"dateRange\" onchange=\"this.form.submit()\">");
                foreach (var (v, lbl) in dateOpts)
                {
                    var sel = currentDateRange == v ? " selected" : "";
                    selectHtml.Append($"<option value=\"{v}\"{sel}>{lbl}</option>");
                }
                selectHtml.Append("</select>");
            }
            @Html.Raw(selectHtml.ToString())

            <div class="t-search">
                <svg class="t-search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" value="@searchVal"
                       placeholder="Order # or customer…" id="searchInput" aria-label="Search orders" />
            </div>
        </div>
    </div>
</form>

<!-- ── Orders table ── -->
<div class="orders-card">
    <div class="table-responsive">
        <table class="table ord-table mb-0" id="orderTable">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-end no-print">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                                </div>
                                <div class="empty-title">No orders found</div>
                                <p class="empty-text">
                                    @if (!string.IsNullOrEmpty(searchVal) || currentStatus != "all")
                                    {
                                        <span>Try clearing your filters or search.</span>
                                    }
                                    else
                                    {
                                        <span>Create your first order to get started.</span>
                                    }
                                </p>
                                <a asp-action="Create" class="btn-new-order" style="margin: 0 auto;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    Create Order
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var o in Model)
                {
                    var sc = o.Status?.ToLower() switch {
                        "completed"  => "status-completed",
                        "delivered"  => "status-delivered",
                        "pending"    => "status-pending",
                        "processing" => "status-processing",
                        "cancelled"  => "status-cancelled",
                        "returned"   => "status-returned",
                        _ => "status-pending"
                    };
                    <tr class="animate-fade-in">
                        <td>
                            <a asp-action="Details" asp-route-id="@o.Id" class="ord-num">@o.OrderNumber</a>
                        </td>
                        <td>
                            <div class="cust-name">@(o.CustomerName ?? "Walk-in")</div>
                            @if (!string.IsNullOrEmpty(o.CustomerPhone))
                            {
                                <div class="cust-phone">@o.CustomerPhone</div>
                            }
                        </td>
                        <td>
                            <div class="ord-date">@o.OrderDate.ToString("MMM d, yyyy")</div>
                            <div class="ord-date-time">@o.OrderDate.ToString("h:mm tt")</div>
                        </td>
                        <td>
                            <span class="ord-amount">৳@o.Total.ToString("N0")</span>
                        </td>
                        <td>
                            <span class="order-status-badge @sc">@(o.Status?.Replace("_", " "))</span>
                        </td>
                        <td class="no-print">
                            <div class="row-actions">
                                @if (o.Status?.ToLower() == "pending")
                                {
                                    <form asp-action="ChangeStatus" asp-route-id="@o.Id" method="post" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="processing" />
                                        <button type="submit" class="ra-btn ra-process">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                            Process
                                        </button>
                                    </form>
                                }
                                else if (o.Status?.ToLower() == "processing")
                                {
                                    <form asp-action="ChangeStatus" asp-route-id="@o.Id" method="post" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="delivered" />
                                        <button type="submit" class="ra-btn ra-deliver">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                            Deliver
                                        </button>
                                    </form>
                                }
                                else if (o.Status?.ToLower() == "delivered")
                                {
                                    <form asp-action="ChangeStatus" asp-route-id="@o.Id" method="post" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="status" value="completed" />
                                        <button type="submit" class="ra-btn ra-complete">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                            Complete
                                        </button>
                                    </form>
                                }

                                <a asp-action="Details" asp-route-id="@o.Id" class="ra-btn ra-view" title="View Details">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    View
                                </a>

                                <a asp-action="Invoice" asp-route-id="@o.Id" target="_blank" class="ra-btn ra-invoice" title="Invoice">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                    Invoice
                                </a>

                                @if (o.Status?.ToLower() != "cancelled" && o.Status?.ToLower() != "returned" && o.Status?.ToLower() != "completed")
                                {
                                    <div class="dropdown">
                                        <button class="more-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="More">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li>
                                                <form asp-action="Cancel" asp-route-id="@o.Id" method="post" class="m-0 p-0"
                                                      onsubmit="return confirm('Cancel order @o.OrderNumber?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                                        Cancel Order
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Pagination ── -->
<div class="pager no-print">
    <div class="pager-info">
        Showing <strong>@Model.Count()</strong> of <strong>@totalItems</strong> orders
        @if (totalPages > 1) { <span>&nbsp;·&nbsp; Page <strong>@currentPage</strong> of <strong>@totalPages</strong></span> }
    </div>
    @if (totalPages > 1)
    {
        <div class="pager-nav">
            @{ string PageUrl(int p) => $"?page={p}&search={Uri.EscapeDataString(searchVal ?? "")}&status={Uri.EscapeDataString(currentStatus)}&dateRange={Uri.EscapeDataString(currentDateRange)}"; }
            <a href="@(currentPage > 1 ? PageUrl(currentPage - 1) : "#")" class="pg-btn @(currentPage <= 1 ? "disabled" : "")">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Prev
            </a>
            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="@PageUrl(p)" class="pg-num @(p == currentPage ? "active" : "")">@p</a>
            }
            <a href="@(currentPage < totalPages ? PageUrl(currentPage + 1) : "#")" class="pg-btn @(currentPage >= totalPages ? "disabled" : "")">
                Next
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
        </div>
    }
</div>

<!-- Bulk Import Modal -->
<div class="modal fade no-print" id="bulkImportModal" tabindex="-1" aria-labelledby="bulkImportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="BulkImport" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="bulkImportModalLabel">Bulk Import Orders</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Upload a CSV file containing orders. The CSV should have headers: <strong>OrderNumber, CustomerName, CustomerPhone, Total, Status, OrderDate</strong>.</p>
                    <div class="mb-3">
                        <label for="csvFile" class="form-label fw-bold">Select CSV File</label>
                        <input type="file" class="form-control" id="csvFile" name="file" accept=".csv" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background-color: #18181b; border: none;">Import Orders</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function setStatus(s) {
    document.getElementById('statusFilter').value = s;
    document.getElementById('filterForm').submit();
}
document.getElementById('searchInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') document.getElementById('filterForm').submit();
});
</script>
}
