@model IEnumerable<SellWise.Web.Models.Order>
@{
    ViewData["Title"] = "Orders";
    var orderCount = Model.Count();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">Orders</h2>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2" style="background-color: #18181b; border: none;">
        + Create Order
    </a>
</div>

<div class="card border-1 shadow-sm p-3 mb-4">
    <div class="d-flex gap-3">
        <div class="search-widget" style="width: 100%; max-width: 400px;">
            <span class="search-icon">🔍</span>
            <input type="text" id="orderSearch" placeholder="Search by Order # or Customer..." onkeyup="searchOrders();">
        </div>
        <select class="form-select" id="statusFilter" style="width: 100%; max-width: 200px; background-color: #ffffff; border-color: #cbd5e1;" onchange="filterOrders();">
            <option value="">All Statuses</option>
            <option value="COMPLETED">Completed</option>
            <option value="PENDING">Pending</option>
            <option value="DELIVERED">Delivered</option>
        </select>
    </div>
</div>

<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="orderTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 20%;">Order #</th>
                    <th style="width: 30%;">Customer</th>
                    <th style="width: 20%;">Date</th>
                    <th style="width: 15%;">Total</th>
                    <th style="width: 10%;">Status</th>
                    <th style="width: 5%;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold text-dark">@o.OrderNumber</td>
                        <td class="align-middle">
                            <div class="fw-bold text-dark">@(o.Customer?.Name ?? "Walk-in Customer")</div>
                            @if (o.Customer != null && !string.IsNullOrEmpty(o.Customer.Phone))
                            {
                                <div class="text-muted" style="font-size: 0.75rem;">@o.Customer.Phone</div>
                            }
                        </td>
                        <td class="align-middle text-muted">@o.OrderDate.ToString("M/d/yyyy")</td>
                        <td class="align-middle fw-bold text-dark">৳@o.Total.ToString("N0")</td>
                        <td class="align-middle">
                            <span class="text-decoration-none fw-bold" style="color: #2563eb; font-size: 0.85rem;">
                                @(o.Status.ToLower() == "completed" ? "delivered" : o.Status.ToLower())
                            </span>
                        </td>
                        <td class="align-middle text-end">
                            <div class="dropdown">
                                <button class="btn btn-link p-0 text-muted dropdown-toggle no-arrow" type="button" data-bs-toggle="dropdown">
                                    •••
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-1 mt-1">
                                    <li><a href="#" class="dropdown-item">View Details</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a href="#" class="dropdown-item text-danger">Cancel Order</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No orders found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pagination-wrap">
    <div>Showing <strong>1</strong> to <strong>@orderCount</strong> of <strong>@orderCount</strong> results</div>
    <div class="d-flex gap-2">
        <a href="#" class="pagination-btn">Previous</a>
        <a href="#" class="pagination-btn">Next</a>
    </div>
</div>

@section Scripts {
    <script>
        function searchOrders() {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("orderSearch");
            filter = input.value.toUpperCase();
            table = document.getElementById("orderTable");
            tr = table.getElementsByTagName("tr");
            for (i = 1; i < tr.length; i++) {
                var tdNum = tr[i].getElementsByTagName("td")[0];
                var tdCust = tr[i].getElementsByTagName("td")[1];
                if (tdNum || tdCust) {
                    var numVal = tdNum ? (tdNum.textContent || tdNum.innerText) : "";
                    var custVal = tdCust ? (tdCust.textContent || tdCust.innerText) : "";
                    if (numVal.toUpperCase().indexOf(filter) > -1 || custVal.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }

        function filterOrders() {
            var select, filter, table, tr, td, i, txtValue;
            select = document.getElementById("statusFilter");
            filter = select.value.toUpperCase();
            table = document.getElementById("orderTable");
            tr = table.getElementsByTagName("tr");
            for (i = 1; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td")[4];
                if (td) {
                    txtValue = td.textContent || td.innerText;
                    // Standardize status text comparison
                    var status = txtValue.trim().toUpperCase();
                    if (status === "DELIVERED") status = "COMPLETED"; // Handle display mapping

                    if (filter === "" || status.indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>
}
