@model IEnumerable<SellWise.Web.Models.Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary">Create Order</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold">@o.OrderNumber</td>
                        <td class="align-middle">@o.OrderDate.ToString("MMM dd, yyyy")</td>
                        <td class="align-middle">@(o.Customer?.Name ?? "Walk-in Customer")</td>
                        <td class="align-middle">@o.Items.Sum(i => i.Quantity) items</td>
                        <td class="align-middle fw-bold text-success">৳@o.Total.ToString("N0")</td>
                        <td class="align-middle">
                            <span class="badge bg-success">@o.Status.ToUpper()</span>
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="6" class="text-center text-muted py-4">No orders found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
