@model IEnumerable<SellWise.Web.ViewModels.Order.OrderViewModel>
@{
    ViewData["Title"] = "Orders";
    var orderCount = Model.Count();
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <h2 class="fw-bold text-dark mb-0">Orders</h2>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#bulkImportModal">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Bulk Import
        </button>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2" style="background-color: #18181b; border: none;">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Create Order
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-1 shadow-sm p-3 mb-4">
    <form method="get" class="d-flex flex-column flex-sm-row gap-3">
        <div class="search-widget" style="width: 100%; max-width: 400px;">
            <svg aria-hidden="true" class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" value="@ViewData["Search"]" aria-label="Search" placeholder="Search by Order # or Customer...">
        </div>
        <select class="form-select" name="status" style="width: 100%; max-width: 200px; background-color: #ffffff; border-color: #cbd5e1;" onchange="this.form.submit();">
            <option value="">All Statuses</option>
            <option value="COMPLETED" selected="@((ViewData["Status"]?.ToString() == "COMPLETED") ? "selected" : null)">Completed</option>
            <option value="PENDING" selected="@((ViewData["Status"]?.ToString() == "PENDING") ? "selected" : null)">Pending</option>
            <option value="DELIVERED" selected="@((ViewData["Status"]?.ToString() == "DELIVERED") ? "selected" : null)">Delivered</option>
        </select>
        <button type="submit" class="btn btn-primary d-none">Search</button>
    </form>
</div>

<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="orderTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 20%;">Order #</th>
                    <th style="width: 30%;">Customer</th>
                    <th style="width: 20%;">Date</th>
                    <th style="width: 15%;">Total</th>
                    <th style="width: 10%;">Status</th>
                    <th style="width: 5%;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold text-dark">@o.OrderNumber</td>
                        <td class="align-middle">
                            <div class="fw-bold text-dark">@(o.CustomerName ?? "Walk-in Customer")</div>
                            @if (!string.IsNullOrEmpty(o.CustomerPhone))
                            {
                                <div class="text-muted" style="font-size: 0.75rem;">@o.CustomerPhone</div>
                            }
                        </td>
                        <td class="align-middle text-muted">@o.OrderDate.ToString("M/d/yyyy")</td>
                        <td class="align-middle fw-bold text-dark">৳@o.Total.ToString("N0")</td>
                        <td class="align-middle">
                            <span class="text-decoration-none fw-bold" style="color: #2563eb; font-size: 0.85rem;">
                                @(o.Status.ToLower() == "completed" ? "delivered" : o.Status.ToLower())
                            </span>
                        </td>
                        <td class="align-middle text-end">
                            <div class="dropdown">
                                <button class="btn btn-link p-0 text-muted dropdown-toggle no-arrow" type="button" aria-label="Options" data-bs-toggle="dropdown">
                                    •••
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-1 mt-1">
                                    <li><a asp-action="Details" asp-route-id="@o.Id" class="dropdown-item">View Details</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-action="Cancel" asp-route-id="@o.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel order @o.OrderNumber?');" class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">Cancel Order</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No orders found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pagination-wrap">
    <div>Showing <strong>@Model.Count()</strong> of <strong>@ViewData["TotalItems"]</strong> results</div>
    <div class="d-flex gap-2">
        @{
            int currentPage = (int)ViewData["CurrentPage"]!;
            int totalPages = (int)ViewData["TotalPages"]!;
            var search = ViewData["Search"]?.ToString();
            var status = ViewData["Status"]?.ToString();
        }
        @if (currentPage > 1)
        {
            <a href="?page=@(currentPage - 1)&search=@search&status=@status" class="pagination-btn">Previous</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Previous</span>
        }

        @if (currentPage < totalPages)
        {
            <a href="?page=@(currentPage + 1)&search=@search&status=@status" class="pagination-btn">Next</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Next</span>
        }
    </div>
</div>

<div class="modal fade" id="bulkImportModal" tabindex="-1" aria-labelledby="bulkImportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="BulkImport" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="bulkImportModalLabel">Bulk Import Orders</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Upload a CSV file containing order information. The CSV should have headers: OrderNumber, CustomerName, CustomerPhone, Total, Status, Source, OrderDate.</p>
                    <div class="mb-3">
                        <label for="csvFile" class="form-label fw-bold">Select CSV File</label>
                        <input type="file" class="form-control" id="csvFile" name="file" accept=".csv" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background-color: #18181b; border: none;">Import Orders</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
}
