@model IEnumerable<SellWise.Web.ViewModels.Order.OrderViewModel>
@{
    ViewData["Title"] = "Orders";
    var currentStatus   = ViewData["Status"]?.ToString()?.ToLower()    ?? "all";
    var currentDateRange = ViewData["DateRange"]?.ToString()?.ToLower() ?? "all";
    int currentPage  = (int)ViewData["CurrentPage"]!;
    int totalPages   = (int)ViewData["TotalPages"]!;
    var searchVal    = ViewData["Search"]?.ToString();
    var totalItems   = (int)(ViewData["TotalItems"] ?? 0);
}

<!-- ── Header ── -->
<div class="page-header">
    <h1 class="page-heading">Orders</h1>
    <div class="d-flex gap-2 no-print">
        <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2" onclick="window.print()" title="Print list">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Print
        </button>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New order
        </a>
    </div>
</div>

<!-- ── Alerts ── -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ── Key figures ── -->
<div class="stat-strip mb-4 no-print">
    <div class="stat">
        <span class="stat-label">Today's revenue</span>
        <div class="stat-value text-truncate">৳@(ViewBag.TodayRevenue?.ToString("N0") ?? "0")</div>
    </div>
    <div class="stat">
        <span class="stat-label">Orders today</span>
        <div class="stat-value">@(((int)(ViewBag.TodayOrdersCount ?? 0)).ToString("N0"))</div>
    </div>
    <div class="stat @((ViewBag.PendingOrdersCount ?? 0) > 0 ? "is-warning" : "")">
        <span class="stat-label">Pending orders</span>
        <div class="stat-value">@(((int)(ViewBag.PendingOrdersCount ?? 0)).ToString("N0"))</div>
    </div>
    <div class="stat">
        <span class="stat-label">Matching your filters</span>
        <div class="stat-value">@totalItems.ToString("N0")</div>
    </div>
</div>

<!-- ── Filter toolbar ── -->
<div class="card border-1 shadow-sm p-3 mb-4 no-print">
    <form method="get" id="filterForm" class="d-flex flex-column flex-sm-row gap-3 align-items-start align-items-sm-center">
        <div class="d-flex gap-1 flex-wrap">
            <input type="hidden" name="status" id="statusFilter" value="@currentStatus" />
            @{
                var tabs = new[] {
                    ("all",        "All"),
                    ("pending",    "Pending"),
                    ("processing", "Processing"),
                    ("delivered",  "Delivered"),
                    ("completed",  "Completed"),
                    ("cancelled",  "Cancelled"),
                    ("returned",   "Returned"),
                };
            }
            @foreach (var (val, label) in tabs)
            {
                var isActive = currentStatus == val;
                <button type="button" onclick="setStatus('@val')" aria-pressed="@isActive.ToString().ToLower()"
                   class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-primary")">@label</button>
            }
        </div>
        <div class="d-flex gap-2 ms-auto flex-wrap">
            <select class="form-select form-select-sm" name="dateRange" onchange="this.form.submit()" style="width: auto; min-width: 130px;">
                @{
                    var dateOpts = new[] {
                        ("all",       "All Time"),
                        ("today",     "Today"),
                        ("yesterday", "Yesterday"),
                        ("week",      "Last 7 days"),
                        ("month",     "This Month"),
                    };
                }
                @foreach (var (v, lbl) in dateOpts)
                {
                    <option value="@v" selected="@(currentDateRange == v)">@lbl</option>
                }
            </select>
            <input type="text" name="search" value="@searchVal" class="form-control form-control-sm" placeholder="Order # or customer…" id="searchInput" aria-label="Search orders" style="width: 180px;" />
        </div>
    </form>
</div>

<!-- ── Orders table ── -->
<div class="card shadow-sm border-1 mb-3">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="orderTable">
            <thead class="table-light">
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            @if (!string.IsNullOrEmpty(searchVal) || currentStatus != "all")
                            {
                                <span>No orders found matching your filters.</span>
                            }
                            else
                            {
                                <span>No orders yet. Create your first order to get started.</span>
                                <br/>
                                <a asp-action="Create" class="btn btn-primary mt-3">Create Order</a>
                            }
                        </td>
                    </tr>
                }
                @foreach (var o in Model)
                {
                    var sc = o.Status?.ToLower() switch {
                        "completed"  => "status-completed",
                        "delivered"  => "status-delivered",
                        "pending"    => "status-pending",
                        "processing" => "status-processing",
                        "cancelled"  => "status-cancelled",
                        "returned"   => "status-returned",
                        _ => "status-pending"
                    };
                    <tr>
                        <td class="align-middle fw-bold">
                            <a asp-action="Details" asp-route-id="@o.Id" class="text-dark text-decoration-none">@o.OrderNumber</a>
                            <div class="mt-1">
                                @if (string.Equals(o.OrderType, "online", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-primary-subtle text-primary border" style="font-size: .65rem; font-weight: 600;">Online</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-dark border" style="font-size: .65rem; font-weight: 600;">In-Store</span>
                                }
                            </div>
                        </td>
                        <td class="align-middle">
                            <div class="fw-semibold text-dark">@(o.CustomerName ?? "Walk-in")</div>
                            @if (!string.IsNullOrEmpty(o.CustomerPhone))
                            {
                                <div style="font-size: .75rem; color: var(--text-muted);">@o.CustomerPhone</div>
                            }
                        </td>
                        <td class="align-middle">
                            <div style="color: var(--text-muted); font-size: .82rem;">@o.OrderDate.ToString("MMM d, yyyy")</div>
                            <div style="font-size: .72rem; color: var(--text-muted);">@o.OrderDate.ToString("h:mm tt")</div>
                        </td>
                        <td class="align-middle fw-bold text-dark" style="font-size: .9rem;">৳@o.Total.ToString("N0")</td>
                        <td class="align-middle">
                            <span class="order-status-badge @sc">@(o.Status?.Replace("_", " "))</span>
                        </td>
                        <td class="align-middle text-end">
                            <div class="d-flex align-items-center justify-content-end">
                                <div class="dropdown">
                                    <button class="order-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions" aria-label="Actions for order @o.OrderNumber">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li>
                                            <a asp-action="Details" asp-route-id="@o.Id" class="dropdown-item d-flex align-items-center gap-2">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                                View details
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-action="Invoice" asp-route-id="@o.Id" target="_blank" class="dropdown-item d-flex align-items-center gap-2">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                                Invoice
                                            </a>
                                        </li>
                                        @if (o.Status?.ToLower() == "pending")
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="ChangeStatus" asp-route-id="@o.Id" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="status" value="processing" />
                                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                                        Process
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        else if (o.Status?.ToLower() == "processing")
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="ChangeStatus" asp-route-id="@o.Id" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="status" value="delivered" />
                                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                                        Mark as delivered
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        else if (o.Status?.ToLower() == "delivered")
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="ChangeStatus" asp-route-id="@o.Id" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="status" value="completed" />
                                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                                        Mark as completed
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                        @if (o.Status?.ToLower() != "cancelled" && o.Status?.ToLower() != "returned" && o.Status?.ToLower() != "completed")
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="Cancel" asp-route-id="@o.Id" method="post" class="m-0 p-0"
                                                      onsubmit="return confirm('Cancel order @o.OrderNumber?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                                        Cancel order
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Pagination ── -->
<div class="pagination-wrap">
    <div>Showing <strong>@Model.Count()</strong> of <strong>@totalItems</strong> orders</div>
    <div class="d-flex gap-2">
        @if (currentPage > 1)
        {
            <a href="?page=@(currentPage - 1)&search=@Uri.EscapeDataString(searchVal ?? "")&status=@Uri.EscapeDataString(currentStatus)&dateRange=@Uri.EscapeDataString(currentDateRange)" class="pagination-btn">Previous</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Previous</span>
        }

        @if (currentPage < totalPages)
        {
            <a href="?page=@(currentPage + 1)&search=@Uri.EscapeDataString(searchVal ?? "")&status=@Uri.EscapeDataString(currentStatus)&dateRange=@Uri.EscapeDataString(currentDateRange)" class="pagination-btn">Next</a>
        }
        else
        {
            <span class="pagination-btn text-muted" style="cursor: not-allowed; opacity: 0.5;">Next</span>
        }
    </div>
</div>

@section Scripts {
<script>
function setStatus(s) {
    document.getElementById('statusFilter').value = s;
    document.getElementById('filterForm').submit();
}
document.getElementById('searchInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') document.getElementById('filterForm').submit();
});
</script>
}
