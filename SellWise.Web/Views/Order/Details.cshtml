@model SellWise.Web.Models.Order
@{
    ViewData["Title"] = "Order Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Order @Model.OrderNumber</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Orders</a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-1 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold">Items</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="align-middle fw-bold">@item.ProductName</td>
                                <td class="align-middle">@item.Quantity</td>
                                <td class="align-middle">৳@item.UnitPrice.ToString("N0")</td>
                                <td class="align-middle">৳@((item.UnitPrice * item.Quantity).ToString("N0"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-1 mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Order Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal</span>
                    <span>৳@Model.Items.Sum(i => i.UnitPrice * i.Quantity).ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Delivery</span>
                    <span>৳@Model.DeliveryCharge.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-3 text-danger">
                    <span>Discount</span>
                    <span>-৳@Model.Discount.ToString("N0")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-bold">Total</span>
                    <span class="fw-bold text-primary fs-5">৳@Model.Total.ToString("N0")</span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-1">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Customer Details</h5>
                @if (Model.Customer != null)
                {
                    <p class="mb-1"><strong>Name:</strong> @Model.Customer.Name</p>
                    @if (!string.IsNullOrEmpty(Model.Customer.Phone))
                    {
                        <p class="mb-1"><strong>Phone:</strong> @Model.Customer.Phone</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Customer.Email))
                    {
                        <p class="mb-1"><strong>Email:</strong> @Model.Customer.Email</p>
                    }
                }
                else
                {
                    <p class="text-muted">Walk-in Customer</p>
                }
                <hr />
                <p class="mb-1"><strong>Status:</strong> <span class="badge bg-primary text-uppercase">@Model.Status</span></p>
                <p class="mb-1"><strong>Date:</strong> @Model.OrderDate.ToString("MMM dd, yyyy h:mm tt")</p>
                <p class="mb-0"><strong>Source:</strong> @(Model.Source == "walk_in" ? "In-Store" : "Online")</p>
            </div>
        </div>
    </div>
</div>
