@model SellWise.Web.ViewModels.Order.OrderDetailsViewModel
@{
    ViewData["Title"] = "Order Details";
    var currency = Model.Currency ?? "৳";

    var allStatuses = new[] { "pending", "processing", "delivered", "completed", "cancelled", "returned" };
    var statusCssClass = Model.Status?.ToLower() switch {
        "completed"  => "status-completed",
        "delivered"  => "status-delivered",
        "pending"    => "status-pending",
        "processing" => "status-processing",
        "cancelled"  => "status-cancelled",
        "returned"   => "status-returned",
        _ => "status-pending"
    };

    // Pipeline steps (linear happy path)
    var pipeline = new[] { "pending", "processing", "delivered", "completed" };
    var currentStatusLower = Model.Status?.ToLower() ?? "pending";
    var isCancelled = currentStatusLower == "cancelled" || currentStatusLower == "returned";
    int pipelineIndex = Array.IndexOf(pipeline, currentStatusLower);
}

<style>
    /* ── Page Header ── */
    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.75rem;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .detail-back {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.4rem 0.75rem;
        border-radius: var(--radius-md);
        border: 1.5px solid var(--border-color);
        background: #fff;
        transition: all 0.15s ease;
        margin-bottom: 0.6rem;
        white-space: nowrap;
    }
    .detail-back:hover { color: var(--brand); border-color: var(--brand); background: var(--brand-light); }
    .detail-title { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.5px; margin: 0; line-height: 1.2; }
    .detail-subtitle { font-size: 0.82rem; color: var(--text-muted); margin: 0.25rem 0 0; }
    .detail-header-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }

    /* ── Cards ── */
    .detail-card {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }
    .detail-card-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .detail-card-title {
        font-size: 0.82rem;
        font-weight: 800;
        color: var(--text-primary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
        flex: 1;
    }
    .detail-card-body { padding: 1.25rem; }

    /* ── Pipeline tracker ── */
    .pipeline-wrap {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
    }
    .pipeline-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        flex: 1;
        min-width: 80px;
        position: relative;
    }
    .pipeline-step:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 16px;
        left: calc(50% + 16px);
        right: calc(-50% + 16px);
        height: 2px;
        background: var(--border-color);
        z-index: 0;
    }
    .pipeline-step.done:not(:last-child)::after { background: var(--brand); }
    .pipeline-step.cancelled-step:not(:last-child)::after { background: var(--border-color); }

    .step-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid var(--border-color);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
        flex-shrink: 0;
    }
    .pipeline-step.done .step-dot {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
    }
    .pipeline-step.current .step-dot {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
        box-shadow: 0 0 0 4px rgba(67,56,202,0.15);
    }
    .pipeline-step.cancelled-step .step-dot {
        background: var(--danger-bg);
        border-color: var(--danger);
        color: var(--danger);
    }
    .step-label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: var(--text-muted);
        text-align: center;
        white-space: nowrap;
    }
    .pipeline-step.current .step-label { color: var(--brand); }
    .pipeline-step.done .step-label { color: var(--text-primary); }
    .pipeline-step.cancelled-step .step-label { color: var(--danger); }

    /* ── Items table ── */
    .items-table thead th {
        background: #fafafa;
        border-bottom: 1px solid var(--border-color);
        padding: 0.75rem 1.25rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        white-space: nowrap;
        border-top: none;
    }
    .items-table tbody td {
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.875rem;
        vertical-align: middle;
        border-top: none;
    }
    .items-table tbody tr:last-child td { border-bottom: none; }
    .items-table { margin: 0; }

    /* ── Summary rows ── */
    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        font-size: 0.875rem;
        border-bottom: 1px solid var(--border-light);
    }
    .summary-row:last-child { border-bottom: none; }
    .summary-label { color: var(--text-muted); font-weight: 500; }
    .summary-value { font-weight: 700; color: var(--text-primary); }
    .summary-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 0 0;
        margin-top: 0.25rem;
        border-top: 2px solid var(--border-color);
    }
    .summary-total-label { font-size: 1rem; font-weight: 800; color: var(--text-primary); }
    .summary-total-value { font-size: 1.35rem; font-weight: 800; color: var(--brand); font-family: 'Outfit', sans-serif; letter-spacing: -0.5px; }

    /* ── Info rows ── */
    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 0.55rem 0;
        font-size: 0.875rem;
        border-bottom: 1px solid var(--border-light);
        gap: 1rem;
    }
    .info-row:last-child { border-bottom: none; }
    .info-label { color: var(--text-muted); font-weight: 500; flex-shrink: 0; }
    .info-value { font-weight: 600; color: var(--text-primary); text-align: right; }

    /* ── Action Buttons ── */
    .action-btn-primary {
        width: 100%;
        padding: 0.6rem 1rem;
        border-radius: var(--radius-md);
        border: none;
        background: var(--text-primary);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none;
        box-shadow: 0 2px 6px rgba(28,25,23,0.15);
        margin-bottom: 0.5rem;
    }
    .action-btn-primary:hover { background: var(--brand); color: #fff; box-shadow: 0 4px 12px rgba(67,56,202,0.3); }

    .action-btn-ghost {
        width: 100%;
        padding: 0.6rem 1rem;
        border-radius: var(--radius-md);
        border: 1.5px solid var(--border-color);
        background: #fff;
        color: var(--text-main);
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none;
        margin-bottom: 0.5rem;
    }
    .action-btn-ghost:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-light); }

    .action-btn-danger {
        width: 100%;
        padding: 0.6rem 1rem;
        border-radius: var(--radius-md);
        border: 1.5px solid #fca5a5;
        background: var(--danger-bg);
        color: var(--danger);
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        cursor: pointer;
        transition: all 0.15s ease;
        margin-bottom: 0;
    }
    .action-btn-danger:hover { background: var(--danger); color: #fff; border-color: var(--danger); }

    /* ── Compact header action (Invoice link) ── */
    .header-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-md);
        border: 1.5px solid var(--border-color);
        background: #fff;
        color: var(--text-main);
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }
    .header-action-btn:hover {
        color: var(--brand);
        border-color: var(--brand);
        background: var(--brand-light);
    }

    /* ── Status change dropdown ── */
    .status-change-section {
        padding-top: 0.75rem;
        margin-top: 0.5rem;
        border-top: 1px solid var(--border-light);
    }
    .status-change-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }
    .status-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.4rem;
    }
    .status-change-btn {
        padding: 0.4rem 0.5rem;
        border-radius: 6px;
        border: 1.5px solid var(--border-color);
        background: var(--bg-app);
        color: var(--text-main);
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        text-align: center;
        text-transform: capitalize;
    }
    .status-change-btn:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-light); }
    .status-change-btn.current-status { background: var(--brand); color: #fff; border-color: var(--brand); opacity: 0.7; cursor: default; }

    /* ── Notes box ── */
    .notes-box {
        background: var(--bg-app);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 0.85rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary);
        line-height: 1.6;
    }
</style>

<!-- ── Page Header ── -->
<div class="detail-header">
    <div>
        <a asp-action="Index" class="detail-back">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Orders
        </a>
        <h1 class="detail-title">@Model.OrderNumber</h1>
        <p class="detail-subtitle d-flex align-items-center gap-2 flex-wrap">
            <span>Placed @Model.OrderDate.ToString("MMMM d, yyyy 'at' h:mm tt")</span>
            <span>·</span>
            <span class="order-status-badge @statusCssClass" style="font-size:0.72rem; padding:0.15rem 0.65rem;">@(Model.Status?.Replace("_", " "))</span>
            @if (string.Equals(Model.OrderType, "online", StringComparison.OrdinalIgnoreCase))
            {
                <span class="badge bg-primary-subtle text-primary border" style="font-size:0.72rem; padding:0.15rem 0.65rem; border-radius:50px;">Online Order</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-dark border" style="font-size:0.72rem; padding:0.15rem 0.65rem; border-radius:50px;">Offline (In-Store)</span>
            }
        </p>
    </div>
    <div class="detail-header-actions">
        <a asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="header-action-btn">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Invoice
        </a>
    </div>
</div>

<!-- ── Order Pipeline ── -->
@if (!isCancelled)
{
    <div class="detail-card" style="margin-bottom:1.25rem;">
        <div class="pipeline-wrap">
            @for (int i = 0; i < pipeline.Length; i++)
            {
                var step = pipeline[i];
                var isDone = pipelineIndex > i;
                var isCurrent = pipelineIndex == i;
                var stepClass = isDone ? "done" : (isCurrent ? "current" : "");
                <div class="pipeline-step @stepClass">
                    <div class="step-dot">
                        @if (isDone)
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        }
                        else if (isCurrent)
                        {
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
                        }
                        else
                        {
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/></svg>
                        }
                    </div>
                    <span class="step-label">@step</span>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="detail-card" style="margin-bottom:1.25rem;">
        <div class="pipeline-wrap" style="justify-content:center; gap:0.75rem; padding:1rem 1.5rem;">
            <div class="pipeline-step cancelled-step" style="flex:unset; min-width:unset;">
                <div class="step-dot">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </div>
                <span class="step-label">@currentStatusLower</span>
            </div>
            <span style="font-size:0.82rem; color:var(--text-muted);">This order has been @currentStatusLower.</span>
        </div>
    </div>
}

<div class="row g-3">

    <!-- LEFT: Items + Notes -->
    <div class="col-12 col-lg-8">

        <!-- Order Items Card -->
        <div class="detail-card">
            <div class="detail-card-header">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                <span class="detail-card-title">Order Items</span>
                <span style="font-size:0.78rem; color:var(--text-muted); font-weight:600;">@Model.Items.Count item@(Model.Items.Count == 1 ? "" : "s")</span>
            </div>
            @if (Model.Items.Any())
            {
                <table class="table items-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td style="font-weight:600; color:var(--text-primary);">@item.ProductName</td>
                                <td class="text-center" style="color:var(--text-muted);">@item.Quantity</td>
                                <td class="text-end" style="color:var(--text-muted);">@currency @item.UnitPrice.ToString("N0")</td>
                                <td class="text-end" style="font-weight:800; color:var(--text-primary);">@currency @item.LineTotal.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="detail-card-body" style="text-align:center; color:var(--text-muted); padding:3rem;">No items in this order.</div>
            }
        </div>

        <!-- Notes Card -->
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="detail-card">
                <div class="detail-card-header">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                    <span class="detail-card-title">Order Notes</span>
                </div>
                <div class="detail-card-body">
                    <div class="notes-box">@Model.Notes</div>
                </div>
            </div>
        }
    </div>

    <!-- RIGHT: Summary, Customer, Actions -->
    <div class="col-12 col-lg-4">

        <!-- Order Summary Card -->
        <div class="detail-card">
            <div class="detail-card-header">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <span class="detail-card-title">Summary</span>
            </div>
            <div class="detail-card-body" style="padding-bottom:1rem;">
                <div class="summary-row">
                    <span class="summary-label">Subtotal</span>
                    <span class="summary-value">@currency @Model.Items.Sum(i => i.LineTotal).ToString("N0")</span>
                </div>
                @if (Model.DeliveryCharge > 0)
                {
                    <div class="summary-row">
                        <span class="summary-label">Delivery</span>
                        <span class="summary-value">@currency @Model.DeliveryCharge.ToString("N0")</span>
                    </div>
                }
                @if (Model.Discount > 0)
                {
                    <div class="summary-row">
                        <span class="summary-label">Discount</span>
                        <span class="summary-value" style="color:var(--danger);">−@currency @Model.Discount.ToString("N0")</span>
                    </div>
                }
                <div class="summary-total-row">
                    <span class="summary-total-label">Total</span>
                    <span class="summary-total-value">@currency @Model.Total.ToString("N0")</span>
                </div>
            </div>
        </div>

        <!-- Customer & Order Info Card -->
        <div class="detail-card">
            <div class="detail-card-header">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span class="detail-card-title">Customer &amp; Channel</span>
            </div>
            <div class="detail-card-body" style="padding-bottom:1rem;">
                <div class="info-row">
                    <span class="info-label">Customer</span>
                    <span class="info-value">@(Model.CustomerName ?? "Walk-in Customer")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                {
                    <div class="info-row">
                        <span class="info-label">Phone</span>
                        <span class="info-value">
                            <a href="tel:@Model.CustomerPhone" style="color:var(--brand); text-decoration:none; font-weight:600;">@Model.CustomerPhone</a>
                        </span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                {
                    <div class="info-row">
                        <span class="info-label">Email</span>
                        <span class="info-value">
                            <a href="mailto:@Model.CustomerEmail" style="color:var(--brand); text-decoration:none;">@Model.CustomerEmail</a>
                        </span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CustomerAddress))
                {
                    <div class="info-row">
                        <span class="info-label">Address</span>
                        <span class="info-value">@Model.CustomerAddress</span>
                    </div>
                }
                <div class="info-row">
                    <span class="info-label">Channel</span>
                    <span class="info-value">
                        @if (string.Equals(Model.OrderType, "online", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-primary-subtle text-primary border" style="font-size:0.7rem;">Online Order</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-dark border" style="font-size:0.7rem;">Offline (In-Store)</span>
                        }
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Salesperson</span>
                    <span class="info-value fw-semibold text-dark">@(!string.IsNullOrWhiteSpace(Model.SalespersonName) ? Model.SalespersonName : "Staff")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Date</span>
                    <span class="info-value">@Model.OrderDate.ToString("MMM d, yyyy")</span>
                </div>
            </div>
        </div>

        <!-- Actions Card -->
        <div class="detail-card">
            <div class="detail-card-header">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 1.41 14.14M4.93 19.07a10 10 0 0 1-1.41-14.14"/><path d="m16.95 7.05-9.9 9.9M7.05 7.05l9.9 9.9"/></svg>
                <span class="detail-card-title">Actions</span>
            </div>
            <div class="detail-card-body">
                <a asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="action-btn-primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    View Invoice
                </a>

                <!-- Status Change -->
                @if (!isCancelled)
                {
                    <div class="status-change-section">
                        <div class="status-change-label">Change Status</div>
                        <div class="status-grid">
                            @foreach (var s in allStatuses)
                            {
                                var isCurrent2 = currentStatusLower == s;
                                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="status" value="@s" />
                                    <button type="submit"
                                            class="status-change-btn w-100 @(isCurrent2 ? "current-status" : "")"
                                            @(isCurrent2 ? "disabled" : "")>
                                        @s.Replace("_", " ")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }

                <!-- Cancel -->
                @if (currentStatusLower != "cancelled" && currentStatusLower != "returned" && currentStatusLower != "completed")
                {
                    <div style="margin-top:0.75rem;">
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="m-0 p-0"
                              onsubmit="return confirm('Cancel order @Model.OrderNumber? This cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="action-btn-danger">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                Cancel Order
                            </button>
                        </form>
                    </div>
                }

                <div style="margin-top:0.5rem;">
                    <a asp-action="Index" class="action-btn-ghost">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                        Back to Orders
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
