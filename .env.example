# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/sellwise

# Cache & Message Broker (Redis)
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=7d

# ML Service URL
ML_SERVICE_URL=http://localhost:8000
