# ─────────────────────────────────────────────────────────────────────────────
# SellWise — Production Environment Variables
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values below
# 3. NEVER commit .env to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# SQL Server SA password — choose a strong password (min 8 chars, upper+lower+digit+symbol)
SA_PASSWORD=YourStrongPassword123!

# Your public domain or DuckDNS subdomain (used by Caddy for SSL)
# Examples:
#   sellwise.duckdns.org
#   yourdomain.com
DOMAIN=YOUR_DOMAIN_HERE
