# ─────────────────────────────────────────────────────────────────────────────
# Caddyfile — Reverse proxy for SellWise on Oracle Cloud
#
# Replace YOUR_DOMAIN_HERE with your actual domain or DuckDNS subdomain.
# Caddy automatically provisions a free Let's Encrypt SSL certificate.
#
# Examples:
#   sellwise.duckdns.org        (free DuckDNS subdomain)
#   yourdomain.com              (your own domain)
# ─────────────────────────────────────────────────────────────────────────────

YOUR_DOMAIN_HERE {
    # Proxy all traffic to the ASP.NET Core app
    reverse_proxy sellwise-web:8080

    # Compress responses
    encode gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }

    # Logging
    log {
        output file /var/log/caddy/access.log
    }
}

# HTTP → HTTPS redirect (Caddy does this automatically, but explicit is clearer)
http://YOUR_DOMAIN_HERE {
    redir https://{host}{uri} permanent
}
